# Copy to .env. Every setting has a default; uncomment only what you change.

# --- network ---
# BIND_ADDR=127.0.0.1          # set 0.0.0.0 to expose the API on the LAN, together with API_KEY
# PORT=8080
# API_KEY=

# --- files ---
# MODELS_DIR=./models
# MODEL_FILE=Inkling-2-Mini-UD-Q3_K_XL.gguf
# MMPROJ_FILE=mmproj-Inkling-2-Mini-Q8_0.gguf
# IMAGE=ghcr.io/prototux/llamacpp-inkling2mini:latest

# --- context and memory ---
# CTX=                         # empty: --fit picks the largest context that fits (575K measured on an idle RTX 3090)
# FIT_MARGIN_MIB=768           # VRAM --fit leaves free; raise it if a desktop or another app shares the GPU
# KV_TYPE=q8_0                 # q4_0 = ~2x context, worse long-context recall; f16 = ~half the context
# VISION=cpu                   # cpu: encoder off the GPU (more context); gpu: faster images; off: no vision

# --- speed ---
# UBATCH=512                   # prefill micro-batch: larger = faster prompt processing, more VRAM
# BATCH=2048
# PARALLEL=1                   # parallel request slots; they share the context

# --- behaviour ---
# REASONING_EFFORT=none        # default thinking: none, minimal, low, medium, high, xhigh, max; requests override it
# MODEL_ALIAS=inkling-2-mini

# BACKEND_SAMPLING=off         # on: sample on the GPU (no grammars, no reasoning budget)

# --- speculative decoding (off: measured slower than plain decoding on an RTX 3090, see README) ---
# DSPARK=off
# DSPARK_DRAFT_MAX=3
# DSPARK_FILE=dspark-Inkling-2-Mini-BF16-pr32218.gguf
# LLAMA_SPEC_ADAPT=0.33        # pause drafting for 64 tokens when the acceptance rate falls below this
# LLAMA_DSPARK_BLOCK=8         # draft block size (8 = trained); 4 is cheaper per step, may accept less
# LLAMA_SPEC_RS_SEQ=           # profiling: 0 = plain-decode target graph with checkpoints instead of snapshots

# --- kernel switches (1 = on). Turn one off if scripts/verify-kernels.sh reports a failure. ---
# LLAMA_INKLING_FA_MMA=1        # prefill attention on the tensor cores
# LLAMA_INKLING_POS_BIAS=1      # relative-position bias computed in the attention kernel
# LLAMA_INKLING_FA_Q8_0=1       # q8_0 KV cache read in place, no F16 copy
# LLAMA_INKLING_SHARE_LOOP_KV=0 # share the full-attention KV of the 3 loop passes: ~2x context, but long answers loop
# LLAMA_INKLING_FA_VEC_VERIFY=1 # speculative verification batches (2-8 tokens) on the vec attention kernel

# --- test build only (patches 0007-0008), all off by default; scripts/mk-bench.sh measures each ---
# Measured on a 3090 with CUDA graphs on (2026-11-24): the set marked "recommended", all bit-exact, gives
# ~103 tok/s short / ~80 at 54K, from ~90 / ~73 with everything off.
# LLAMA_INKLING_MK_GLUE=1        # recommended: loop controllers + input norms + depth mix + q8_1 in 1-2 kernels (+6%)
# LLAMA_INKLING_MK_RELTAB=1      # recommended: the attention bias table (pad + clip + product) in one kernel (+1.6%)
# LLAMA_INKLING_MK_MOESCALE=1    # recommended: expert scales folded into the MoE weighted sum, rounding as unfused
# LLAMA_INKLING_GEMV=1           # recommended: Q8_0/Q6_K one-token products with the row length unrolled (+2%)
# LLAMA_INKLING_MK_PROJ=1        # recommended: a layer's attention projections in one kernel (+1% with the above)
# LLAMA_INKLING_NO_MASK=1        # recommended: attention masks derived from positions, no mask tensor (identical output)
# LLAMA_INKLING_FA_VEC_GQA=auto  # deep context only: GQA decode attention for KV views >= 65536 cells (auto:<cells>;
#                                #   1 always: -2% short); not bit-identical to the default kernel
# LLAMA_INKLING_MK_WO=1          # output projection with its gate: neutral with CUDA graphs
# LLAMA_INKLING_MK_MOE=1         # expert products on the glue's q8_1: slower (the MoE GEMV is at 80% of bandwidth)
# LLAMA_INKLING_MK_GLUE=2        # the controllers as one cooperative kernel: slower than =1
# GGML_CUDA_GRAPH_OPT=2          # multi-stream decode plan inside the CUDA graph: slightly slower on a 3090
# GGML_CUDA_GRAPH_OPT_STREAMS=3  # side streams for it (1-7)
# LLAMA_INKLING_KV_TYPE_FULL=q4_0  # q4_0 cache for the 8 full-attention slots only: produces garbage, leave unset
# LLAMA_INKLING_MOE_CLAMP_NORM=1 # (on) router norm that the fused top-k MoE kernel covers
# LLAMA_INKLING_GRAPH_TRIM=1     # (on) fewer glue ops in one-token graphs
# LLAMA_INKLING_DECODE_SINKS=1   # (on) attention sinks passed to flash attention directly
# LLAMA_INKLING_MK_CHECK=1       # diagnostic: compare every fused stage with the unfused nodes (GGML_CUDA_DISABLE_GRAPHS=1)
# LLAMA_INKLING_MK_PROFILE=1     # diagnostic: GPU time per kernel class of each decode step (GGML_CUDA_DISABLE_GRAPHS=1)
# LLAMA_INKLING_MK_DEBUG=1       # bounds checks + printf in the megakernel stages (with CUDA_LAUNCH_BLOCKING=1)
# LLAMA_GRAPH_STATS=1            # log the node count per op of each graph shape
# LLAMA_GRAPH_DUMP=1             # log every graph node with its sources

# --- anything else, appended to the llama-server command line ---
# EXTRA_ARGS=
