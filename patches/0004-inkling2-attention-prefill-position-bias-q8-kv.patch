+// bias rows of one query: either an index row [n_kv] (indexed mode) or the query position and the key
+// positions of its stream (position mode, ggml_flash_attn_ext_add_position_bias)
+struct ggml_fa_bias_row {
+    const float   * table = nullptr; // [n_bins] of this query and head, nullptr without a bias
+    const int32_t * bins  = nullptr; // indexed mode
+    const int32_t * k_pos = nullptr; // position mode
+    int32_t         q_pos = 0;
+    int64_t         n_bins = 0;
+
+    ggml_fa_bias_row(const ggml_tensor * dst, int64_t iq1, int64_t iq2, int64_t iq3) {
+        const ggml_tensor * table_t = dst->src[6];
+        if (!table_t) {
+            return;
+        }
+        const int64_t q = iq3*dst->src[0]->ne[1] + iq1; // queries of all streams are flattened
+        n_bins = table_t->ne[0];
+        table  = (const float *) ((const char *) table_t->data + q*table_t->nb[2] + iq2*table_t->nb[1]);
+        if (ggml_flash_attn_ext_has_position_bias(dst)) {
+            k_pos = (const int32_t *) ((const char *) dst->src[7]->data + iq3*dst->src[7]->nb[1]);
+            q_pos = ((const int32_t *) dst->src[8]->data)[q];
+        } else {
+            bins = (const int32_t *) ((const char *) dst->src[7]->data + q*dst->src[7]->nb[1]);
+        }
+    }
+
+    // mask + bias of key ic, rounded to F16 like the mask itself
+    float apply(float m, int64_t ic) const {
+        int64_t bin;
+        if (bins) {
+            bin = bins[ic];
+            GGML_ASSERT(bin >= 0 && bin < n_bins);
+        } else {
+            const int64_t d = int64_t(q_pos) - k_pos[ic];
+            bin = d >= 0 && d < n_bins - 1 ? d : n_bins - 1;
+        }
+        return GGML_CPU_FP16_TO_FP32(GGML_CPU_FP32_TO_FP16(m + table[bin]));
+    }
+};
