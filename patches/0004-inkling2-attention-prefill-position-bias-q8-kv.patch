+// A q8_0 K/V cache read in place by the tile and MMA kernels, without an F16 copy (Inkling 2 on a q8_0 cache).
+// q8_0 data is a run of 34-byte blocks of 32 values, and every row, head and stream offset of a K/V view is a whole
+// number of blocks, so an F16 element index maps linearly onto it. fattn_q8_0_ptr stands in for `const half2 *` in
+// the kernels' pointer arithmetic (offsets in half2 units); fattn_load_chunk dequantizes a chunk on load.
+struct fattn_q8_0_ptr {
+    const block_q8_0 * base;
+    int64_t            i; // element index
+
+    __device__ __forceinline__ fattn_q8_0_ptr operator+(int64_t n_h2) const {
+        return {base, i + 2*n_h2};
     }
 };
 
+// load nbytes of F16 values (one chunk of a K/V row) to dst
+template <int nbytes>
+static __device__ __forceinline__ void fattn_load_chunk(void * __restrict__ dst, const half2 * __restrict__ src) {
+    ggml_cuda_memcpy_1<nbytes>(dst, src);
+}
+
+template <int nbytes>
+static __device__ __forceinline__ void fattn_load_chunk(void * __restrict__ dst, const fattn_q8_0_ptr src) {
+    constexpr int n = nbytes/sizeof(half); // values in the chunk
+    static_assert(QK8_0 % n == 0, "a chunk must not straddle two q8_0 blocks");
+    const block_q8_0 * b = src.base + src.i/QK8_0;
+    const float d = __half2float(b->d);
+    // qs follows the 2-byte scale, so it is only 2-byte aligned: read it in pairs
+    const uint16_t * qs = (const uint16_t *) (b->qs + src.i % QK8_0);
+    __align__(16) half2 tmp[n/2];
+#pragma unroll
+    for (int l = 0; l < n/2; ++l) {
+        const uint16_t q = qs[l];
+        tmp[l] = __floats2half2_rn(d*float(int8_t(q & 0xFF)), d*float(int8_t(q >> 8)));
+    }
+    ggml_cuda_memcpy_1<nbytes>(dst, tmp);
+}
