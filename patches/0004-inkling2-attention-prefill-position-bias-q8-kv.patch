+void llama_kv_cache::set_input_cell_pos(ggml_tensor * dst, const llama_ubatch * ubatch) const {
+    GGML_ASSERT(dst->type == GGML_TYPE_I32);
+    const int64_t n_kv     = dst->ne[0];
+    const int64_t n_stream = dst->ne[1];
+    GGML_ASSERT(ubatch->n_tokens % n_stream == 0);
+    const int64_t n_tps = ubatch->n_tokens / n_stream;
+    std::vector<int32_t> data(n_kv * n_stream);
+    for (int64_t s = 0; s < n_stream; ++s) {
+        // the tokens of a stream are contiguous in the ubatch, as for the mask
+        const auto & cells = v_cells.at(seq_to_stream.at(ubatch->seq_id[s*n_tps][0]));
+        for (int64_t j = 0; j < n_kv; ++j) {
+            // INT32_MAX: q_pos - INT32_MAX < 0, so the kernel picks the far bin like set_input_relative_pos
+            data[s*n_kv + j] = cells.is_empty(j) ? INT32_MAX : cells.pos_get(j);
+        }
+    }
+    ggml_backend_tensor_set(dst, data.data(), 0, ggml_nbytes(dst));
+}
