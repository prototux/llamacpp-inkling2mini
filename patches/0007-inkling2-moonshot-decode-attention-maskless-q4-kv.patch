-// whether the tile/MMA kernels read this q8_0 K/V in place: only for the indexed-bias (Inkling 2) instances
-static bool ggml_cuda_fattn_reads_q8_0(const ggml_tensor * dst) {
+// which quantized K/V the tile/MMA kernels read in place, only for the indexed-bias (Inkling 2) instances:
+// 8 (q8_0), 4 (q4_0) or 0 (none: F16, or an F16 copy is made)
+static int ggml_cuda_fattn_in_place_kv(const ggml_tensor * dst) {
     const ggml_tensor * K = dst->src[1];
     const ggml_tensor * V = dst->src[2];
-    return dst->src[6] && !dst->src[5] && K->type == GGML_TYPE_Q8_0 && V->type == GGML_TYPE_Q8_0 &&
-        K->ne[0] == 128 && V->ne[0] == 128 && ggml_cuda_fattn_q8_0_in_place_enabled();
+    if (!dst->src[6] || dst->src[5] || K->type != V->type || K->ne[0] != 128 || V->ne[0] != 128 ||
+            !ggml_cuda_fattn_q8_0_in_place_enabled()) {
+        return 0;
+    }
+    return K->type == GGML_TYPE_Q8_0 ? 8 : K->type == GGML_TYPE_Q4_0 ? 4 : 0;
 }
 
+// the in-place pointer type of a kv_quant instance (see ggml_cuda_fattn_in_place_kv)
+template <int kv_quant>
+using fattn_kv_ptr_t = std::conditional_t<kv_quant == 8, fattn_q8_0_ptr, std::conditional_t<kv_quant == 4, fattn_q4_0_ptr, const half2 *>>;
+
