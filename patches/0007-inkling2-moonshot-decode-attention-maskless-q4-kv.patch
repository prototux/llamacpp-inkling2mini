 // load nbytes of F16 values (one chunk of a K/V row) to dst
 template <int nbytes>
 static __device__ __forceinline__ void fattn_load_chunk(void * __restrict__ dst, const half2 * __restrict__ src) {
@@ -97,6 +132,26 @@ static __device__ __forceinline__ void fattn_load_chunk(void * __restrict__ dst,
     ggml_cuda_memcpy_1<nbytes>(dst, tmp);
 }
 
+template <int nbytes>
+static __device__ __forceinline__ void fattn_load_chunk(void * __restrict__ dst, const fattn_q4_0_ptr src) {
+    constexpr int n = nbytes/sizeof(half); // values in the chunk
+    static_assert((QK4_0/2) % n == 0, "a chunk must not straddle the nibble halves of a q4_0 block");
+    const block_q4_0 * b = src.base + src.i/QK4_0;
+    const float d = __half2float(b->d);
+    const int i0 = src.i % QK4_0;
+    // the chunk is in one nibble half: the low nibbles of qs[i0..] or the high nibbles of qs[i0 - 16..]
+    const uint8_t * qs = b->qs + (i0 < QK4_0/2 ? i0 : i0 - QK4_0/2);
+    const int shift = i0 < QK4_0/2 ? 0 : 4;
+    __align__(16) half2 tmp[n/2];
+#pragma unroll
+    for (int l = 0; l < n/2; ++l) {
+        const int q0 = (qs[2*l    ] >> shift) & 0xF;
+        const int q1 = (qs[2*l + 1] >> shift) & 0xF;
+        tmp[l] = __floats2half2_rn(d*float(q0 - 8), d*float(q1 - 8));
+    }
+    ggml_cuda_memcpy_1<nbytes>(dst, tmp);
+}
