+static bool inkling2_match_qkv(const ggml_cgraph * cgraph, int i, ggml_cuda_inkling2_args & args) {
+    constexpr int64_t D = INKLING2_QKV_D;
+    // Q: CLIP with weight, optional MUL by tau, the rotation
+    ggml_cuda_inkling2_args cq;
+    if (cgraph->nodes[i]->op != GGML_OP_MUL || !inkling2_match_clip(cgraph, i, cq) || cq.src[1] == nullptr) {
+        return false; // not a Q clip: no log, every other MUL lands here
+    }
+    const ggml_tensor * xq = cq.src[0];
+    const ggml_tensor * wq = cq.src[1];
+    const ggml_tensor * qf = cq.dst;
+    if (qf->ne[0] != D || qf->ne[2] != 1 || !inkling2_internal(cgraph, i + cq.n_nodes - 1, 1)) {
+        inkling2_declined("qkv", "q shape", cgraph->nodes[i]);
+        return false;
+    }
+    const int64_t n_head = qf->ne[1];
+    int k = inkling2_next_node(cgraph, i + cq.n_nodes);
+    if (k >= cgraph->n_nodes) {
+        inkling2_declined("qkv", "end of graph", cgraph->nodes[i]);
+        return false;
+    }
+    const ggml_tensor * tau = nullptr;
+    if (cgraph->nodes[k]->op == GGML_OP_MUL) {
+        const ggml_tensor * mul = cgraph->nodes[k];
+        if (mul->src[0] != qf || ggml_nelements(mul->src[1]) != 1 || mul->src[1]->type != GGML_TYPE_F32 || !ggml_are_same_shape(mul, qf) ||
+                !inkling2_internal(cgraph, k, 1)) {
+            inkling2_declined("qkv", "tau", cgraph->nodes[i]);
+        return false;
+        }
+        tau = mul->src[1];
+        qf  = mul;
+        k   = inkling2_next_node(cgraph, k + 1);
+    }
+    if (k >= cgraph->n_nodes || !inkling2_is_rotation(cgraph->nodes[k], qf, D)) {
+        inkling2_declined("qkv", "q rotation", cgraph->nodes[i]);
+        return false;
+    }
+    ggml_tensor * dq = cgraph->nodes[k];
+    // K: CLIP without weight, the rotation
+    int kk = inkling2_next_node(cgraph, k + 1);
+    ggml_cuda_inkling2_args ck;
+    if (kk >= cgraph->n_nodes || cgraph->nodes[kk]->op != GGML_OP_SQR || !inkling2_match_clip(cgraph, kk, ck) || ck.src[1] != nullptr) {
+        inkling2_declined("qkv", "k clip", cgraph->nodes[i]);
+        return false;
+    }
+    const ggml_tensor * xk   = ck.src[0];
+    const ggml_tensor * kcur = ck.dst;
+    const int64_t       n_kv = kcur->ne[1];
+    if (kcur->ne[0] != D || kcur->ne[2] != 1 || !inkling2_internal(cgraph, kk + ck.n_nodes - 1, 1)) {
+        inkling2_declined("qkv", "k shape", cgraph->nodes[i]);
+        return false;
+    }
+    kk = inkling2_next_node(cgraph, kk + ck.n_nodes);
+    if (kk >= cgraph->n_nodes || !inkling2_is_rotation(cgraph->nodes[kk], kcur, D) || !inkling2_internal(cgraph, kk, 1)) {
+        inkling2_declined("qkv", "k rotation", cgraph->nodes[i]);
+        return false;
+    }
+    const ggml_tensor * krot = cgraph->nodes[kk];
+    // V: RMS_NORM, the rotation over halves
+    int kv = inkling2_next_node(cgraph, kk + 1);
+    if (kv >= cgraph->n_nodes || cgraph->nodes[kv]->op != GGML_OP_RMS_NORM || !inkling2_internal(cgraph, kv, 1)) {
+        inkling2_declined("qkv", "v norm", cgraph->nodes[i]);
+        return false;
+    }
+    const ggml_tensor * vnorm = cgraph->nodes[kv];
+    const ggml_tensor * xv    = vnorm->src[0];
+    if (vnorm->type != GGML_TYPE_F32 || xv->type != GGML_TYPE_F32 || !ggml_is_contiguous(xv) || xv->ne[0] != D || xv->ne[1] != n_kv ||
+            xv->ne[2] != 1 || xv->ne[3] != 1 || (uintptr_t) xv->data % 16 != 0) {
+        inkling2_declined("qkv", "v shape", cgraph->nodes[i]);
+        return false;
+    }
+    kv = inkling2_next_node(cgraph, kv + 1);
+    if (kv >= cgraph->n_nodes || !inkling2_is_rotation(cgraph->nodes[kv], vnorm, D/2) || !inkling2_internal(cgraph, kv, 1)) {
+        inkling2_declined("qkv", "v rotation", cgraph->nodes[i]);
+        return false;
+    }
+    const ggml_tensor * vrot = cgraph->nodes[kv];
+    // the two cache stores
+    int ks = inkling2_next_node(cgraph, kv + 1);
+    bool i64_k = false, i64_v = false;
+    if (ks >= cgraph->n_nodes || !inkling2_is_cache_store(cgraph->nodes[ks], krot, i64_k)) {
+        inkling2_declined("qkv", "k store", cgraph->nodes[i]);
+        return false;
+    }
+    ggml_tensor * store_k = cgraph->nodes[ks];
+    ks = inkling2_next_node(cgraph, ks + 1);
+    if (ks >= cgraph->n_nodes || !inkling2_is_cache_store(cgraph->nodes[ks], vrot, i64_v) || i64_v != i64_k) {
+        inkling2_declined("qkv", "v store", cgraph->nodes[i]);
+        return false;
+    }
+    ggml_tensor * store_v = cgraph->nodes[ks];
+    const int n_nodes = ks + 1 - i;
+    // the replicated configurations: 512-thread CLIP blocks for these row counts, 128-wide heads, 64-wide V halves
+    const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    if ((n_head / nsm) >= 2 || (n_kv / nsm) >= 2 || n_head > 64 || n_kv > 64 || INKLING2_QKV_BLOCK != 512 ||
+            store_k->ne[0] != D*n_kv || store_v->ne[0] != D*n_kv || !inkling2_is_f32_rows(xq) || !ggml_is_contiguous(xq) ||
+            !inkling2_is_f32_rows(wq) || wq->ne[0] != D || (wq->ne[1] != 1 && wq->ne[1] != n_head) || !ggml_is_contiguous(xk) ||
+            dq->ne[1] != n_head) {
+        inkling2_declined("qkv", "shape", cgraph->nodes[i]);
+        return false;
+    }
+    if (!inkling2_glue_outside(cgraph, i, n_nodes, { xq, wq, tau, xk, xv, store_k->src[1], store_v->src[1] })) {
+        inkling2_declined("qkv", "outside", cgraph->nodes[i]);
+        return false;
+    }
+    if (inkling2_overlap(dq, xq) || inkling2_overlap(dq, wq) || inkling2_overlap(dq, xk) || inkling2_overlap(dq, xv) ||
+            (tau && inkling2_overlap(dq, tau))) {
+        // the allocator placed the rotated Q where the projection was (dead after the clip in the unfused graph);
+        // src/models/inkling2.cpp keeps the projection alive (ggml_set_output) when LLAMA_INKLING_MK_QKV is set
+        static const bool dbg = getenv("LLAMA_INKLING_MK_DEBUG") != nullptr;
+        if (dbg) {
+            fprintf(stderr, "inkling2 qkv: %s: dq %p+%zu xq %p+%zu xk %p+%zu xv %p+%zu\n", cgraph->nodes[i]->name, dq->data,
+                    ggml_nbytes(dq), xq->data, ggml_nbytes(xq), xk->data, ggml_nbytes(xk), xv->data, ggml_nbytes(xv));
+        }
+        inkling2_declined("qkv", "overlap", cgraph->nodes[i]);
+        return false;
+    }
+    args.type    = GGML_CUDA_INKLING2_QKV;
+    args.n_nodes = n_nodes;
+    args.dst     = dq;
+    args.src[0]  = xq;
+    args.src[1]  = wq;
+    args.src[2]  = xk;
+    args.src[3]  = xv;
+    args.node[0] = tau;
+    args.node[1] = cq.node[0]; // Q clip SCALE
+    args.node[2] = cq.node[1]; // FILL
+    args.node[3] = cq.node[2]; // CLAMP
+    args.node[4] = vnorm;
+    args.node[5] = store_k;
+    args.extra[0] = ck.node[0]; // K clip SCALE
+    args.extra[1] = ck.node[1]; // FILL
+    args.extra[2] = ck.node[2]; // CLAMP
+    args.extra[3] = store_v;
+    return true;
+}
