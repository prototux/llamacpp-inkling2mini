         return;
     }
 
+    if (opt_mode == 2) {
+        // the stream plan: every independent chain on its own stream, fusions kept (see ggml_cuda_stream_plan_build)
+        ggml_cuda_stream_plan_build(cuda_ctx, cgraph, params);
