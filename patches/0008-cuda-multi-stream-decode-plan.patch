 }
 
+// The real Inkling 2 Mini shapes with random K/V: 24 heads x 128, 8 KV heads, one stream, a 1025-bin table, the
+// cells at positions 0..cells-1, the queries at the last n_query positions. The expected values come from ggml's own
+// dequantization of the quantized K/V (ggml_get_type_traits()->to_float), so that a wrong in-place loader (the bytes a
+// kernel reads from a q8_0 or q4_0 cache) shows up; the test above has exactly representable K/V and cannot catch it.
+// window >= 0: maskless (LLAMA_INKLING_NO_MASK), the mask visibility is otherwise causal from the same positions.
+static void test_inkling_dims(ggml_backend_t backend, ggml_type kv_type, int n_query, int cells, int window) {
+    constexpr int width = 128, heads = 24, kv_heads = 8, bins = 1025;
+    const bool maskless = window >= 0;
+    const int swa = window > 0 ? window : 0;
+
+    ggml_context * ctx = ggml_init({32*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true});
+    auto * q     = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, width, n_query, heads, 1);
+    auto * k     = ggml_new_tensor_4d(ctx, kv_type, width, cells, kv_heads, 1);
+    auto * v     = ggml_dup_tensor(ctx, k);
+    auto * mask  = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, cells, n_query, 1, 1);
+    auto * table = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, bins, heads, n_query);
+    auto * k_pos = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, cells, 1);
+    auto * q_pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_query);
+    auto * sinks = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, heads);
+    auto * out = ggml_flash_attn_ext(ctx, q, k, v, maskless ? nullptr : mask, 1.0f/sqrtf(width), 0, 0);
+    ggml_flash_attn_ext_add_sinks(out, sinks);
+    if (maskless) {
+        ggml_flash_attn_ext_set_causal_window(out, window);
+    }
+    ggml_flash_attn_ext_add_position_bias(out, table, k_pos, q_pos);
+    ggml_prec_set_acc(out, GGML_PREC_F32);
