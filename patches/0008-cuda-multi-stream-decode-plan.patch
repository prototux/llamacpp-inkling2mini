+                    chosen = s;
+                    break;
+                }
+            }
+        }
+        // otherwise behind one of the predecessors: the main stream if one is there, else the latest one
+        if (chosen < 0) {
+            chosen = 0;
+            if (!p.empty()) {
+                int latest = p[0];
+                bool on_main = false;
+                for (int j : p) {
+                    on_main |= stream[j] == 0;
+                    latest = std::max(latest, j);
+                }
+                chosen = on_main ? 0 : stream[latest];
+            }
+        }
+
+        stream[k]    = chosen;
+        tail[chosen] = k;
+        if (chosen != 0) {
+            if (window_first < 0) {
+                window_first = k;
+                window_mask  = 0;
+            }
+            window_mask |= 1 << chosen;
+            if (remaining[k] > 0) {
+                pending[chosen]++;
+            }
+        }
+        for (int j : p) {
+            if (--remaining[j] == 0 && stream[j] != 0) {
+                pending[stream[j]]--;
+            }
+        }
+
+        ggml_cuda_stream_plan_node & pn = plan.nodes[node];
+        pn.stream = chosen;
+        pn.event  = plan.next_event();
+        if (window_first == k) {
