diff --git a/tests/test-flash-attn-indexed-bias.cpp b/tests/test-flash-attn-indexed-bias.cpp
index 6b8fb1b3a..a41a9460e 100644
--- a/tests/test-flash-attn-indexed-bias.cpp
+++ b/tests/test-flash-attn-indexed-bias.cpp
@@ -165,6 +165,160 @@ static void test_indexed_bias(ggml_backend_t backend, int width, bool use_rows,
     ggml_free(ctx);
 }
 
+// The real Inkling 2 Mini shapes with random K/V: 24 heads x 128, 8 KV heads, one stream, a 1025-bin table, the
+// cells at positions 0..cells-1, the queries at the last n_query positions. The expected values come from ggml's own
+// dequantization of the quantized K/V (ggml_get_type_traits()->to_float), so that a wrong in-place loader (the bytes a
+// kernel reads from a q8_0 or q4_0 cache) shows up; the test above has exactly representable K/V and cannot catch it.
+// window >= 0: maskless (LLAMA_INKLING_NO_MASK), the mask visibility is otherwise causal from the same positions.
+static void test_inkling_dims(ggml_backend_t backend, ggml_type kv_type, int n_query, int cells, int window) {
+    constexpr int width = 128, heads = 24, kv_heads = 8, bins = 1025;
+    const bool maskless = window >= 0;
+    const int swa = window > 0 ? window : 0;
+
+    ggml_context * ctx = ggml_init({32*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true});
+    auto * q     = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, width, n_query, heads, 1);
+    auto * k     = ggml_new_tensor_4d(ctx, kv_type, width, cells, kv_heads, 1);
+    auto * v     = ggml_dup_tensor(ctx, k);
+    auto * mask  = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, cells, n_query, 1, 1);
+    auto * table = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, bins, heads, n_query);
+    auto * k_pos = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, cells, 1);
+    auto * q_pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_query);
+    auto * sinks = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, heads);
+    auto * out = ggml_flash_attn_ext(ctx, q, k, v, maskless ? nullptr : mask, 1.0f/sqrtf(width), 0, 0);
+    ggml_flash_attn_ext_add_sinks(out, sinks);
+    if (maskless) {
+        ggml_flash_attn_ext_set_causal_window(out, window);
+    }
+    ggml_flash_attn_ext_add_position_bias(out, table, k_pos, q_pos);
+    ggml_prec_set_acc(out, GGML_PREC_F32);
+    if (!ggml_backend_supports_op(backend, out)) {
+        printf("%s: kv=%s, queries=%d, cells=%d, window=%d: op not supported, skipped\n", ggml_backend_name(backend), ggml_type_name(kv_type), n_query, cells, window);
+        ggml_free(ctx);
+        return;
+    }
+    auto * graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, out);
+    auto * buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    GGML_ASSERT(buf);
+
+    uint32_t state = 0x1234567u + 7919u*n_query + 31u*cells + (uint32_t) kv_type;
+    const auto frand = [&state]() { state = state*1664525u + 1013904223u; return float(state >> 8)/float(1u << 24) - 0.5f; };
+
+    // K/V: random, quantized with ggml, then dequantized with ggml for the expectation
+    const int64_t n_kv_values = (int64_t) width*cells*kv_heads;
+    std::vector<float> kf(n_kv_values), vf(n_kv_values);
+    for (int64_t i = 0; i < n_kv_values; ++i) {
+        kf[i] = 4.0f*frand();
+        vf[i] = 2.0f*frand();
+    }
+    std::vector<uint8_t> kq(ggml_nbytes(k)), vq(ggml_nbytes(v));
+    ggml_quantize_chunk(kv_type, kf.data(), kq.data(), 0, ggml_nrows(k), width, nullptr);
+    ggml_quantize_chunk(kv_type, vf.data(), vq.data(), 0, ggml_nrows(v), width, nullptr);
+    ggml_backend_tensor_set(k, kq.data(), 0, kq.size());
+    ggml_backend_tensor_set(v, vq.data(), 0, vq.size());
+    std::vector<float> kd(n_kv_values), vd(n_kv_values);
+    if (kv_type == GGML_TYPE_F32) {
+        kd = kf; vd = vf;
+    } else {
+        ggml_get_type_traits(kv_type)->to_float(kq.data(), kd.data(), n_kv_values);
+        ggml_get_type_traits(kv_type)->to_float(vq.data(), vd.data(), n_kv_values);
+    }
+
+    std::vector<float> qf((size_t) width*n_query*heads);
+    for (float & x : qf) {
+        x = 2.0f*frand();
+    }
+    ggml_backend_tensor_set(q, qf.data(), 0, ggml_nbytes(q));
+    std::vector<float> tab((size_t) bins*heads*n_query);
+    for (float & x : tab) {
+        x = 2.0f*frand();
+    }
+    ggml_backend_tensor_set(table, tab.data(), 0, ggml_nbytes(table));
+    std::vector<float> sink(heads);
+    for (float & x : sink) {
+        x = 4.0f*frand();
+    }
+    ggml_backend_tensor_set(sinks, sink.data(), 0, ggml_nbytes(sinks));
+    std::vector<int32_t> kpos(cells), qpos(n_query);
+    for (int c = 0; c < cells; ++c) {
+        kpos[c] = c;
+    }
+    for (int j = 0; j < n_query; ++j) {
+        qpos[j] = cells - n_query + j;
+    }
+    ggml_backend_tensor_set(k_pos, kpos.data(), 0, ggml_nbytes(k_pos));
+    ggml_backend_tensor_set(q_pos, qpos.data(), 0, ggml_nbytes(q_pos));
+    std::vector<ggml_fp16_t> vis((size_t) cells*n_query);
+    for (int j = 0; j < n_query; ++j) {
+        for (int c = 0; c < cells; ++c) {
+            const int d = qpos[j] - kpos[c];
+            vis[(size_t) j*cells + c] = ggml_fp32_to_fp16(d >= 0 && (swa == 0 || d < swa) ? 0.0f : -INFINITY);
+        }
+    }
+    if (!maskless) {
+        ggml_backend_tensor_set(mask, vis.data(), 0, ggml_nbytes(mask));
+    }
+
+    GGML_ASSERT(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS);
+    std::vector<float> output(ggml_nelements(out));
+    ggml_backend_tensor_get(out, output.data(), 0, ggml_nbytes(out));
+
+    // reference: the F16-rounded mask + bias like the kernels, double accumulation
+    double err2 = 0.0, ref2 = 0.0, max_err = 0.0;
+    std::vector<double> acc(width);
+    for (int j = 0; j < n_query; ++j) {
+        for (int h = 0; h < heads; ++h) {
+            const int kvh = h/(heads/kv_heads);
+            double m = sink[h], sum = 0.0;
+            std::fill(acc.begin(), acc.end(), 0.0);
+            std::vector<double> logit(cells);
+            for (int c = 0; c < cells; ++c) {
+                const int d = qpos[j] - kpos[c];
+                if (!(d >= 0 && (swa == 0 || d < swa))) {
+                    logit[c] = -INFINITY;
+                    continue;
+                }
+                const int bin = d < bins - 1 ? d : bins - 1;
+                double s = 0.0;
+                for (int i = 0; i < width; ++i) {
+                    s += double(qf[((size_t) h*n_query + j)*width + i])*double(kd[((size_t) kvh*cells + c)*width + i]);
+                }
+                s = s/sqrt(double(width)) + double(ggml_fp16_to_fp32(ggml_fp32_to_fp16(tab[((size_t) j*heads + h)*bins + bin])));
+                logit[c] = s;
+                m = std::max(m, s);
+            }
+            sum = exp(sink[h] - m);
+            for (int c = 0; c < cells; ++c) {
+                if (logit[c] == -INFINITY) {
+                    continue;
+                }
+                const double w = exp(logit[c] - m);
+                sum += w;
+                for (int i = 0; i < width; ++i) {
+                    acc[i] += w*double(vd[((size_t) kvh*cells + c)*width + i]);
+                }
+            }
+            for (int i = 0; i < width; ++i) {
+                const double ref = acc[i]/sum;
+                const double got = output[((size_t) j*heads + h)*width + i];
+                GGML_ASSERT(std::isfinite(got));
+                err2 += (got - ref)*(got - ref);
+                ref2 += ref*ref;
+                max_err = std::max(max_err, fabs(got - ref));
+            }
+        }
+    }
+    // the CPU reaches ~1e-5 on a quantized cache (its own q8_0 Q), the tensor-core kernels a little more; a wrong
+    // loader gives ~1
+    const double nmse = err2/std::max(ref2, 1e-30);
+    const bool ok = nmse < 5e-4;
+    printf("%s: inkling dims, kv=%s, queries=%d, cells=%d, window=%d: nmse=%.3g max abs error=%.3g %s\n",
+            ggml_backend_name(backend), ggml_type_name(kv_type), n_query, cells, window, nmse, max_err, ok ? "OK" : "FAIL");
+    GGML_ASSERT(ok);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+}
+
 int main() {
     ggml_backend_load_all();
     for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
@@ -195,6 +349,15 @@ int main() {
                 test_indexed_bias(backend, width, false, n_query, 1024, GGML_TYPE_Q4_0, true);
             }
         }
+        // the real shapes with random K/V, expected from ggml's dequantization: decode (vec), DSpark verify, prefill
+        // (tile/MMA with the in-place q8_0/q4_0 loaders), masked and maskless, full-attention and SWA windows
+        for (ggml_type kv_type : {GGML_TYPE_F16, GGML_TYPE_Q8_0, GGML_TYPE_Q4_0}) {
+            for (int n_query : {1, 4, 128, 512}) {
+                test_inkling_dims(backend, kv_type, n_query, 2048, -1);
+                test_inkling_dims(backend, kv_type, n_query, 2048, 0);
+                test_inkling_dims(backend, kv_type, n_query, 2048, 1024);
+            }
+        }
         ggml_backend_free(backend);
     }
 }
diff --git a/tests/test-inkling-megakernel.cpp b/tests/test-inkling-megakernel.cpp
new file mode 100644
index 000000000..077f1467d
--- /dev/null
+++ b/tests/test-inkling-megakernel.cpp
@@ -0,0 +1,188 @@
+// The Inkling 2 decode megakernel stages against the reference CUDA path, on random weights in the quant types of
+// UD-Q3_K_XL, at the real shapes of one layer application. Each stage is toggled through its environment switch
+// between two evaluations of the same graph (CUDA graphs are disabled here so that both evaluations really run),
+// the outputs must be bit-identical, and the wall time per evaluation is printed for both.
+//
+//   /app/test-inkling-megakernel                      all stages, PASS/FAIL per case
+//   LLAMA_INKLING_MK_DEBUG=1 /app/test-inkling-megakernel   device-side bounds checks with printf
+//   CUDA_LAUNCH_BLOCKING=1 ... when a stage crashes, so that the failing kernel is the one reported
+//
+// Stage "proj" (LLAMA_INKLING_MK_PROJ): the run of attention projections (Q, R, K, V, gate) of one token as one
+// kernel per weight type, each distinct input quantized once.
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cinttypes>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static uint32_t g_state = 12345u;
+static float frand() {
+    g_state = g_state*1664525u + 1013904223u;
+    return float(g_state >> 8)/float(1u << 24) - 0.5f;
+}
+
+struct proj_spec {
+    const char * name;
+    ggml_type    type;
+    int64_t      rows;
+    int          input; // which of the inputs feeds it
+};
+
+struct proj_case {
+    const char * name;
+    int n_inputs;
+    std::vector<proj_spec> mats;
+};
+
+static void set_env(const char * name, const char * value) {
+    setenv(name, value, 1);
+}
+
+// returns the outputs of one evaluation of the projection graph, and the time per evaluation
+static std::vector<std::vector<float>> run_proj(ggml_backend_t backend, const proj_case & pc, int64_t n_embd,
+        const std::vector<std::vector<uint8_t>> & weights, const std::vector<std::vector<float>> & inputs, int n_rep, double & us) {
+    const size_t n_t = 8 + 2*pc.mats.size() + pc.n_inputs;
+    ggml_context * ctx = ggml_init({ggml_tensor_overhead()*n_t + ggml_graph_overhead(), nullptr, true});
+    std::vector<ggml_tensor *> w(pc.mats.size()), x(pc.n_inputs), y(pc.mats.size());
+    for (size_t i = 0; i < pc.mats.size(); ++i) {
+        w[i] = ggml_new_tensor_2d(ctx, pc.mats[i].type, n_embd, pc.mats[i].rows);
+        ggml_set_name(w[i], pc.mats[i].name);
+    }
+    for (int i = 0; i < pc.n_inputs; ++i) {
+        x[i] = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+        ggml_set_input(x[i]);
+    }
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    for (size_t i = 0; i < pc.mats.size(); ++i) {
+        y[i] = ggml_mul_mat(ctx, w[i], x[pc.mats[i].input]);
+        ggml_set_output(y[i]);
+        ggml_build_forward_expand(gf, y[i]);
+    }
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    GGML_ASSERT(buf);
+    for (size_t i = 0; i < pc.mats.size(); ++i) {
+        ggml_backend_tensor_set(w[i], weights[i].data(), 0, weights[i].size());
+    }
+    for (int i = 0; i < pc.n_inputs; ++i) {
+        ggml_backend_tensor_set(x[i], inputs[i].data(), 0, inputs[i].size()*sizeof(float));
+    }
+    GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+    ggml_backend_synchronize(backend);
+    const auto t0 = std::chrono::steady_clock::now();
+    for (int r = 0; r < n_rep; ++r) {
+        GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+    }
+    ggml_backend_synchronize(backend);
+    us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count()/n_rep;
+    std::vector<std::vector<float>> out(pc.mats.size());
+    for (size_t i = 0; i < pc.mats.size(); ++i) {
+        out[i].resize(ggml_nelements(y[i]));
+        ggml_backend_tensor_get(y[i], out[i].data(), 0, ggml_nbytes(y[i]));
+    }
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    return out;
+}
+
+static bool test_proj(ggml_backend_t backend, const proj_case & pc) {
+    const int64_t n_embd = 2304;
+    std::vector<std::vector<uint8_t>> weights(pc.mats.size());
+    std::vector<float> wf(n_embd);
+    for (size_t i = 0; i < pc.mats.size(); ++i) {
+        const int64_t rows = pc.mats[i].rows;
+        std::vector<float> full(n_embd*rows);
+        for (float & v : full) {
+            v = frand();
+        }
+        weights[i].resize(ggml_row_size(pc.mats[i].type, n_embd)*rows);
+        ggml_quantize_chunk(pc.mats[i].type, full.data(), weights[i].data(), 0, rows, n_embd, nullptr);
+    }
+    std::vector<std::vector<float>> inputs(pc.n_inputs, std::vector<float>(n_embd));
+    for (auto & in : inputs) {
+        for (float & v : in) {
+            v = 2.0f*frand();
+        }
+    }
+
+    double us_ref = 0.0, us_mk = 0.0;
+    set_env("LLAMA_INKLING_MK_PROJ", "0");
+    const auto ref = run_proj(backend, pc, n_embd, weights, inputs, 50, us_ref);
+    set_env("LLAMA_INKLING_MK_PROJ", "1");
+    const auto mk  = run_proj(backend, pc, n_embd, weights, inputs, 50, us_mk);
+    set_env("LLAMA_INKLING_MK_PROJ", "0");
+
+    bool ok = true;
+    double max_abs = 0.0, max_rel = 0.0;
+    std::string first;
+    for (size_t i = 0; i < pc.mats.size(); ++i) {
+        for (size_t e = 0; e < ref[i].size(); ++e) {
+            const float a = ref[i][e], b = mk[i][e];
+            if (!std::isfinite(b) || a != b) {
+                const double d = fabs(double(a) - double(b));
+                max_abs = std::max(max_abs, d);
+                max_rel = std::max(max_rel, d/std::max(1e-6, fabs(double(a))));
+                if (first.empty()) {
+                    char tmp[256];
+                    snprintf(tmp, sizeof(tmp), "first mismatch: %s[%zu] (%s, %" PRId64 " rows) ref=%.9g fused=%.9g", pc.mats[i].name, e,
+                            ggml_type_name(pc.mats[i].type), pc.mats[i].rows, a, b);
+                    first = tmp;
+                }
+                ok = false;
+            }
+        }
+    }
+    printf("proj %-24s %s  ref %8.1f us  fused %8.1f us  (%d products, %d inputs)%s%s\n", pc.name, ok ? "PASS" : "FAIL",
+            us_ref, us_mk, (int) pc.mats.size(), pc.n_inputs, ok ? "" : "  max abs ", ok ? "" : std::to_string(max_abs).c_str());
+    if (!ok) {
+        printf("    max rel %.3g, %s\n", max_rel, first.c_str());
+    }
+    return ok;
+}
+
+int main() {
+    // both evaluations of a graph must run: a replayed CUDA graph would hide the toggled fusion
+    set_env("GGML_CUDA_DISABLE_GRAPHS", "1");
+    ggml_backend_load_all();
+
+    // the attention projections of a layer application: Q [2304 x 3072], R [2304 x 384], K/V [2304 x 1024],
+    // gate [2304 x 3072]; one input for a SWA pass-1 layer, three (Q/R/gate, K, V) for a loop pass or full layer
+    const std::vector<proj_case> cases = {
+        { "core q8_0, one input",   1, { {"q", GGML_TYPE_Q8_0, 3072, 0}, {"r", GGML_TYPE_Q8_0, 384, 0}, {"k", GGML_TYPE_Q8_0, 1024, 0}, {"v", GGML_TYPE_Q8_0, 1024, 0}, {"gate", GGML_TYPE_Q8_0, 3072, 0} } },
+        { "core q8_0, three inputs", 3, { {"q", GGML_TYPE_Q8_0, 3072, 0}, {"r", GGML_TYPE_Q8_0, 384, 0}, {"k", GGML_TYPE_Q8_0, 1024, 1}, {"v", GGML_TYPE_Q8_0, 1024, 2}, {"gate", GGML_TYPE_Q8_0, 3072, 0} } },
+        { "layer 18 (q6_K, q8_0)",   3, { {"q", GGML_TYPE_Q6_K, 3072, 0}, {"r", GGML_TYPE_Q8_0, 384, 0}, {"k", GGML_TYPE_Q6_K, 1024, 1}, {"v", GGML_TYPE_Q8_0, 1024, 2}, {"gate", GGML_TYPE_Q6_K, 3072, 0} } },
+        { "layer 20 (q5_K, q8_0)",   3, { {"q", GGML_TYPE_Q5_K, 3072, 0}, {"r", GGML_TYPE_Q6_K, 384, 0}, {"k", GGML_TYPE_Q5_K, 1024, 1}, {"v", GGML_TYPE_Q8_0, 1024, 2}, {"gate", GGML_TYPE_Q5_K, 3072, 0} } },
+        { "layer 22 (q4_K, q6_K)",   3, { {"q", GGML_TYPE_Q4_K, 3072, 0}, {"r", GGML_TYPE_Q5_K, 384, 0}, {"k", GGML_TYPE_Q4_K, 1024, 1}, {"v", GGML_TYPE_Q6_K, 1024, 2}, {"gate", GGML_TYPE_Q5_K, 3072, 0} } },
+        { "two products",            1, { {"q", GGML_TYPE_Q8_0, 3072, 0}, {"gate", GGML_TYPE_Q8_0, 3072, 0} } },
+        { "eight products",          2, { {"a", GGML_TYPE_Q8_0, 3072, 0}, {"b", GGML_TYPE_Q8_0, 384, 0}, {"c", GGML_TYPE_Q8_0, 1024, 1}, {"d", GGML_TYPE_Q8_0, 1024, 1}, {"e", GGML_TYPE_Q8_0, 3072, 0}, {"f", GGML_TYPE_Q4_K, 2304, 1}, {"g", GGML_TYPE_Q6_K, 24, 0}, {"h", GGML_TYPE_Q8_0, 32, 1} } },
+    };
+
+    int n_fail = 0, n_run = 0;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            continue;
+        }
+        ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+        GGML_ASSERT(backend);
+        printf("== %s\n", ggml_backend_name(backend));
+        for (const proj_case & pc : cases) {
+            n_fail += !test_proj(backend, pc);
+            n_run++;
+        }
+        ggml_backend_free(backend);
+    }
+    if (n_run == 0) {
+        printf("no non-CPU backend: nothing to compare\n");
+    }
+    printf("%d of %d cases failed\n", n_fail, n_run);
+    return n_fail == 0 ? 0 : 1;
+}
diff --git a/tests/test-sched-streams.cpp b/tests/test-sched-streams.cpp
new file mode 100644
index 000000000..ed790f54e
--- /dev/null
+++ b/tests/test-sched-streams.cpp
@@ -0,0 +1,167 @@
+// Runs a small-batch graph with many independent chains (a decode-like block: norm, sibling projections, in-place
+// cache writes, joins) through ggml_backend_sched on every backend and compares with the CPU. The CUDA backend's
+// GGML_CUDA_GRAPH_OPT=2 stream plan reorders nothing but runs the chains on several streams: this checks that the
+// cross-stream dependencies, the window joins and the pinned allocations give the sequential result.
+//
+//   GGML_CUDA_GRAPH_OPT=2 GGML_CUDA_GRAPH_OPT_DEBUG=1 ./test-sched-streams
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+static float frand(uint32_t & state) {
+    state = state*1664525u + 1013904223u;
+    return float(state >> 8)/float(1u << 24) - 0.5f;
+}
+
+struct block_weights {
+    ggml_tensor * norm;
+    ggml_tensor * w[6];
+    ggml_tensor * cache; // [n_embd, n_cells], written in place by the block and read back
+};
+
+// one block: h = rms_norm(x)*norm; six projections of h on independent chains; two of them written into the cache and
+// read back through views; the chains join into the block output x + sum(...)
+static ggml_tensor * build_block(ggml_context * ctx, ggml_tensor * x, const block_weights & bw, int cell) {
+    const int64_t n_embd = x->ne[0];
+    ggml_tensor * h = ggml_mul(ctx, ggml_rms_norm(ctx, x, 1e-6f), bw.norm);
+
+    ggml_tensor * p[6];
+    for (int i = 0; i < 6; ++i) {
+        p[i] = ggml_mul_mat(ctx, bw.w[i], h);
+    }
+    // chains of different lengths
+    ggml_tensor * a = ggml_mul(ctx, ggml_sigmoid(ctx, p[0]), p[1]);
+    ggml_tensor * b = ggml_scale(ctx, ggml_tanh(ctx, ggml_scale(ctx, p[2], 0.1f)), 10.0f);
+    // the cache: p[3] is stored in cell `cell`, p[4] in cell + 1, and both are read back (write-after-read hazards
+    // with the reads of the previous block, read-after-write within this one)
+    // (the first token's column of each)
+    ggml_tensor * store3 = ggml_cpy(ctx, ggml_view_1d(ctx, p[3], n_embd, 0), ggml_view_1d(ctx, bw.cache, n_embd, (cell    )*bw.cache->nb[1]));
+    ggml_tensor * store4 = ggml_cpy(ctx, ggml_view_1d(ctx, p[4], n_embd, 0), ggml_view_1d(ctx, bw.cache, n_embd, (cell + 1)*bw.cache->nb[1]));
+    ggml_tensor * window = ggml_view_2d(ctx, bw.cache, n_embd, 2, bw.cache->nb[1], cell*bw.cache->nb[1]);
+    ggml_tensor * c = ggml_sum_rows(ctx, ggml_cont(ctx, ggml_transpose(ctx, window))); // [2, 1] -> per cell sums
+    // make the reads depend on the stores explicitly, as the KV cache graph does
+    c = ggml_add(ctx, c, ggml_sum_rows(ctx, ggml_reshape_2d(ctx, store3, n_embd, 1)));
+    c = ggml_add(ctx, c, ggml_sum_rows(ctx, ggml_reshape_2d(ctx, store4, n_embd, 1)));
+    ggml_tensor * d = ggml_mul(ctx, ggml_silu(ctx, p[5]), ggml_repeat(ctx, ggml_view_1d(ctx, c, 1, 0), p[5]));
+
+    ggml_tensor * out = ggml_add(ctx, x, a);
+    out = ggml_add(ctx, out, b);
+    out = ggml_add(ctx, out, d);
+    return ggml_scale(ctx, out, 0.5f);
+}
+
+static std::vector<float> run(ggml_backend_t backend, ggml_backend_t cpu, int n_embd, int n_blocks, int n_tokens, uint32_t seed) {
+    const int n_tensors = 16 + n_blocks*64;
+    ggml_context * ctx_w = ggml_init({ggml_tensor_overhead()*(size_t) (8*n_blocks + 8), nullptr, true});
+    ggml_context * ctx   = ggml_init({ggml_tensor_overhead()*(size_t) n_tensors + ggml_graph_overhead_custom(n_tensors, false), nullptr, true});
+
+    std::vector<block_weights> bws(n_blocks);
+    for (int l = 0; l < n_blocks; ++l) {
+        bws[l].norm  = ggml_new_tensor_1d(ctx_w, GGML_TYPE_F32, n_embd);
+        for (int i = 0; i < 6; ++i) {
+            bws[l].w[i] = ggml_new_tensor_2d(ctx_w, GGML_TYPE_F16, n_embd, n_embd);
+        }
+        bws[l].cache = ggml_new_tensor_2d(ctx_w, GGML_TYPE_F32, n_embd, 8);
+    }
+    ggml_backend_buffer_t buf_w = ggml_backend_alloc_ctx_tensors(ctx_w, backend);
+    GGML_ASSERT(buf_w);
+
+    uint32_t state = seed;
+    std::vector<float>       f32(n_embd*n_embd);
+    std::vector<ggml_fp16_t> f16(n_embd*n_embd);
+    for (int l = 0; l < n_blocks; ++l) {
+        for (int i = 0; i < n_embd; ++i) {
+            f32[i] = 1.0f + 0.1f*frand(state);
+        }
+        ggml_backend_tensor_set(bws[l].norm, f32.data(), 0, n_embd*sizeof(float));
+        for (int w = 0; w < 6; ++w) {
+            for (int i = 0; i < n_embd*n_embd; ++i) {
+                f16[i] = ggml_fp32_to_fp16(frand(state)/sqrtf(float(n_embd)));
+            }
+            ggml_backend_tensor_set(bws[l].w[w], f16.data(), 0, f16.size()*sizeof(ggml_fp16_t));
+        }
+        std::fill(f32.begin(), f32.end(), 0.0f);
+        ggml_backend_tensor_set(bws[l].cache, f32.data(), 0, ggml_nbytes(bws[l].cache));
+    }
+
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tokens);
+    ggml_set_input(x);
+    ggml_tensor * cur = x;
+    for (int l = 0; l < n_blocks; ++l) {
+        cur = build_block(ctx, cur, bws[l], 2*(l % 3));
+    }
+    ggml_set_output(cur);
+    ggml_cgraph * gf = ggml_new_graph_custom(ctx, n_tensors, false);
+    ggml_build_forward_expand(gf, cur);
+
+    ggml_backend_t backends[2] = { backend, cpu };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, nullptr, backend == cpu ? 1 : 2, ggml_graph_n_nodes(gf) + 64, false, true);
+    GGML_ASSERT(ggml_backend_sched_alloc_graph(sched, gf));
+
+    std::vector<float> input(n_embd*n_tokens);
+    for (float & v : input) {
+        v = frand(state);
+    }
+    ggml_backend_tensor_set(x, input.data(), 0, input.size()*sizeof(float));
+
+    // twice: the second run reuses the allocation and, on CUDA, replays the captured graph; the cache is state, so
+    // it is cleared again in between
+    std::vector<float> out(n_embd*n_tokens), out2(n_embd*n_tokens);
+    GGML_ASSERT(ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS);
+    ggml_backend_tensor_get(cur, out.data(), 0, out.size()*sizeof(float));
+    ggml_backend_tensor_set(x, input.data(), 0, input.size()*sizeof(float));
+    std::fill(f32.begin(), f32.end(), 0.0f);
+    for (int l = 0; l < n_blocks; ++l) {
+        ggml_backend_tensor_set(bws[l].cache, f32.data(), 0, ggml_nbytes(bws[l].cache));
+    }
+    GGML_ASSERT(ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS);
+    ggml_backend_tensor_get(cur, out2.data(), 0, out2.size()*sizeof(float));
+    for (size_t i = 0; i < out.size(); ++i) {
+        GGML_ASSERT(std::isfinite(out[i]));
+        GGML_ASSERT(out[i] == out2[i] && "the second run differs from the first");
+    }
+
+    ggml_backend_sched_free(sched);
+    ggml_backend_buffer_free(buf_w);
+    ggml_free(ctx);
+    ggml_free(ctx_w);
+    return out;
+}
+
+int main() {
+    ggml_backend_load_all();
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    GGML_ASSERT(cpu);
+
+    int n_fail = 0;
+    for (int n_tokens : {1, 4}) {
+        const std::vector<float> ref = run(cpu, cpu, 256, 6, n_tokens, 12345u);
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                continue;
+            }
+            ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+            GGML_ASSERT(backend);
+            const std::vector<float> out = run(backend, cpu, 256, 6, n_tokens, 12345u);
+            double max_err = 0.0, max_ref = 0.0;
+            for (size_t k = 0; k < out.size(); ++k) {
+                max_err = std::max(max_err, (double) fabsf(out[k] - ref[k]));
+                max_ref = std::max(max_ref, (double) fabsf(ref[k]));
+            }
+            const bool ok = max_err <= 1e-3*std::max(1.0, max_ref);
+            printf("%s: n_tokens=%d, max |out| = %g, max error vs CPU = %g: %s\n", ggml_backend_name(backend), n_tokens, max_ref, max_err, ok ? "OK" : "FAIL");
+            n_fail += !ok;
+            ggml_backend_free(backend);
+        }
+    }
+    ggml_backend_free(cpu);
+    return n_fail == 0 ? 0 : 1;
+}
