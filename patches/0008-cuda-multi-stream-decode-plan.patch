+                m = std::max(m, s);
+            }
+            sum = exp(sink[h] - m);
+            for (int c = 0; c < cells; ++c) {
+                if (logit[c] == -INFINITY) {
+                    continue;
+                }
+                const double w = exp(logit[c] - m);
+                sum += w;
+                for (int i = 0; i < width; ++i) {
+                    acc[i] += w*double(vd[((size_t) kvh*cells + c)*width + i]);
+                }
+            }
+            for (int i = 0; i < width; ++i) {
+                const double ref = acc[i]/sum;
+                const double got = output[((size_t) j*heads + h)*width + i];
+                GGML_ASSERT(std::isfinite(got));
+                err2 += (got - ref)*(got - ref);
+                ref2 += ref*ref;
+                max_err = std::max(max_err, fabs(got - ref));
+            }
+        }
