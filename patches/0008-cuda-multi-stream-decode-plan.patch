+
+// ---------------------------------------------------------------------------------------------------------------------
+// LLAMA_INKLING_MK_PROJ: several one-token matrix-vector products in one launch (see mmvq.cuh)
+
+struct mmvq_multi_args {
+    int n;
+    bool debug;
+    const void       * vx[MMVQ_MULTI_MAX];
+    const block_q8_1 * vy[MMVQ_MULTI_MAX];
+    float            * dst[MMVQ_MULTI_MAX];
+    int nrows[MMVQ_MULTI_MAX];
+    int ncols_x[MMVQ_MULTI_MAX];
+    int stride_row_x[MMVQ_MULTI_MAX]; // in blocks
+    int rb_end[MMVQ_MULTI_MAX];       // the flattened row-block space: product m owns blocks [rb_end[m-1], rb_end[m])
+    const int32_t * ids = nullptr;    // MUL_MAT_ID: the matrix of product m is expert ids[m] of vx[m]
+    size_t          expert_nbytes = 0;
+};
+
+// blockIdx.x: a row block of the flattened space of all products (no idle blocks for the shorter products). The body
+// is the ncols_dst == 1, no-fusion body of mul_mat_vec_q, with the same thread-to-block mapping, accumulation order
+// and reductions. ncols_t > 0: the row length at compile time (the projections' 2304): the K loop is unrolled and
+// every load of a thread is issued at once, the same operations in the same order (the unrolled gemv of mmvq-inkling.cu).
+template <ggml_type type, bool small_k, int ncols_t = 0>
+__launch_bounds__(calc_nwarps(type, 1, get_device_table_id(), small_k, false)*ggml_cuda_get_physical_warp_size(), 1)
+// __grid_constant__: the per-product arrays are indexed with the block's matrix; without it the compiler copies the
+// whole parameter struct to local memory per thread before indexing it (measured 5-20% slower than mul_mat_vec_q)
+static __global__ void mul_mat_vec_q_multi(const __grid_constant__ mmvq_multi_args args) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int nwarps = calc_nwarps(type, 1, table_id, small_k, false);
+    constexpr int rows_per_cuda_block = calc_rows_per_block(type, 1, table_id, small_k, nwarps);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    // the product of this block and its first row block within it (the compares are uniform over the block)
+    int m = 0;
+#pragma unroll
+    for (int k = 1; k < MMVQ_MULTI_MAX; ++k) {
+        if (k < args.n && (int) blockIdx.x >= args.rb_end[k - 1]) {
+            m = k;
+        }
+    }
+    const int rb0 = m == 0 ? 0 : args.rb_end[m - 1];
+    if (args.debug && (m >= args.n || args.vx[m] == nullptr || args.vy[m] == nullptr || args.dst[m] == nullptr ||
+            args.ncols_x[m] % qk != 0 || args.nrows[m] <= 0 || (ncols_t > 0 && args.ncols_x[m] != ncols_t) ||
+            (int) blockIdx.x >= args.rb_end[m])) {
+        if (threadIdx.x == 0 && threadIdx.y == 0) {
+            printf("mul_mat_vec_q_multi: bad matrix %d of %d at block %u: nrows %d ncols %d\n",
+                   m, args.n, blockIdx.x, args.nrows[m], args.ncols_x[m]);
+        }
+        return;
+    }
+    const int nrows = args.nrows[m];
+    const int row0  = rows_per_cuda_block*((int) blockIdx.x - rb0);
+    if (row0 >= nrows) {
+        return;
+    }
+    const void       * GGML_CUDA_RESTRICT vx = args.vx[m];
+    const block_q8_1 * GGML_CUDA_RESTRICT y  = args.vy[m];
+    if (args.ids != nullptr) {
+        const int32_t expert = args.ids[m];
+        if (args.debug && expert < 0) {
+            if (threadIdx.x == 0 && threadIdx.y == 0) {
+                printf("mul_mat_vec_q_multi: bad expert id %d at slot %d\n", expert, m);
+            }
+            return;
+        }
+        vx = (const char *) vx + (size_t) expert*args.expert_nbytes;
+    }
+    float            * GGML_CUDA_RESTRICT dst = args.dst[m];
+    const int blocks_per_row_x = ncols_t > 0 ? ncols_t / qk : args.ncols_x[m] / qk;
+    const int stride_row_x     = args.stride_row_x[m];
+
+    const     int tid = warp_size*threadIdx.y + threadIdx.x;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    float tmp[rows_per_cuda_block] = {0.0f};
+    const int kbx_offset = row0*stride_row_x;
+    if constexpr (ncols_t > 0) {
+        constexpr int nb  = ncols_t / qk;
+        constexpr int nit = (nb + blocks_per_iter - 1) / blocks_per_iter;
+#pragma unroll
+        for (int it = 0; it < nit; ++it) {
+            const int kbx = tid / (qi/vdr) + it*blocks_per_iter;
+            if (nb % blocks_per_iter == 0 || it < nit - 1 || kbx < nb) {
+                const int kby = kbx * (qk/QK8_1);
+                const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+                for (int i = 0; i < rows_per_cuda_block; ++i) {
+                    tmp[i] += vec_dot_q_cuda(vx, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+                }
+            }
+        }
+    } else {
+        for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+            const int kby = kbx * (qk/QK8_1);
+            const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+            for (int i = 0; i < rows_per_cuda_block; ++i) {
+                tmp[i] += vec_dot_q_cuda(vx, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][rows_per_cuda_block][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int i = 0; i < rows_per_cuda_block; ++i) {
+            tmp_shared[threadIdx.y-1][i][threadIdx.x] = tmp[i];
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+    dst += row0;
+#pragma unroll
+    for (int i = 0; i < rows_per_cuda_block; ++i) {
+#pragma unroll
+        for (int l = 0; l < nwarps-1; ++l) {
+            tmp[i] += tmp_shared[l][i][threadIdx.x];
+        }
+        tmp[i] = warp_reduce_sum<warp_size>(tmp[i]);
+        if (threadIdx.x == i && (rows_per_cuda_block == 1 || row0 + i < nrows)) {
+            dst[i] = tmp[i];
+        }
+    }
+}
+
+template <ggml_type type>
+static void mul_mat_vec_q_multi_launch(const mmvq_multi_args & args, bool small_k, int max_nrows, cudaStream_t stream) {
+    const int device = ggml_cuda_get_device();
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(ggml_cuda_info().devices[device].cc);
+    const int nwarps = calc_nwarps(type, 1, table_id, small_k, false);
+    const int rpb    = calc_rows_per_block(type, 1, table_id, small_k, nwarps);
+    // the flattened row-block space of all products
+    mmvq_multi_args a = args;
+    int  total = 0;
+    bool all_2304 = true;
+    for (int k = 0; k < a.n; ++k) {
+        total      += (a.nrows[k] + rpb - 1)/rpb;
+        a.rb_end[k] = total;
+        all_2304    = all_2304 && a.ncols_x[k] == 2304;
+    }
+    const dim3 block_nums(total, 1, 1);
+    const dim3 block_dims(warp_size, nwarps, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+    GGML_UNUSED(max_nrows);
+    if (small_k) {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_multi<type, true>, launch_params, a);
+    } else if (all_2304 && 2304 % ggml_cuda_type_traits<type>::qk == 0) {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_multi<type, false, 2304>, launch_params, a);
+    } else {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_multi<type, false>, launch_params, a);
+    }
+}
+
+// the same decision as mul_mat_vec_q_switch_ncols_dst for ncols_dst == 1 (halve_iters is GB10-only, never here)
+template <ggml_type type>
+static bool mul_mat_vec_q_multi_small_k(int ncols_x, int cc) {
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(cc);
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    const int blocks_per_row_x      = ncols_x / qk;
+    const int blocks_per_iter_1warp = vdr * warp_size / qi;
+    const int nwarps = calc_nwarps(type, 1, table_id);
+    bool use = nwarps > 1 && blocks_per_row_x < nwarps * blocks_per_iter_1warp;
+    const bool is_nvidia_turing_plus  = GGML_CUDA_CC_IS_NVIDIA(cc) && cc >= GGML_CUDA_CC_TURING;
+    const bool is_nvidia_pascal_older = GGML_CUDA_CC_IS_NVIDIA(cc) && cc < GGML_CUDA_CC_VOLTA;
+    if (is_nvidia_turing_plus) {
+        if (type == GGML_TYPE_IQ3_XXS || type == GGML_TYPE_IQ3_S) {
+            use = false;
+        }
+    } else if (type == GGML_TYPE_IQ1_S || type == GGML_TYPE_IQ1_M || type == GGML_TYPE_IQ2_XXS || type == GGML_TYPE_IQ2_XS ||
+            type == GGML_TYPE_IQ2_S || type == GGML_TYPE_IQ3_XXS || type == GGML_TYPE_IQ3_S || type == GGML_TYPE_IQ4_XS ||
+            (is_nvidia_pascal_older && (type == GGML_TYPE_IQ3_S || type == GGML_TYPE_Q2_K || type == GGML_TYPE_Q3_K)) ||
+            GGML_CUDA_CC_IS_RDNA(cc)) {
+        use = false;
+    }
+    return use;
+}
+
+bool ggml_cuda_mul_mat_vec_q_multi_supported(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_IQ4_NL:
+            return true;
+        default:
+            return false;
+    }
+}
+
+void ggml_cuda_mul_mat_vec_q_multi(ggml_backend_cuda_context & ctx, int n,
+        const ggml_tensor * const * src0, const ggml_tensor * const * src1, ggml_tensor * const * dst, bool debug) {
+    GGML_ASSERT(n >= 1 && n <= MMVQ_MULTI_MAX);
+    cudaStream_t stream = ctx.stream();
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+
+    // each distinct input quantized once, as ggml_cuda_mul_mat_vec_q does it, into slices of ONE pool buffer:
+    // the CUDA pool frees in LIFO order, several live allocations destroyed in vector order would break it
+    int    first[MMVQ_MULTI_MAX];  // the first product with the same input
+    size_t offs [MMVQ_MULTI_MAX] = {};
+    const block_q8_1 * glue[MMVQ_MULTI_MAX] = {};
+    size_t total = 0;
+    for (int i = 0; i < n; ++i) {
+        const ggml_tensor * x = src1[i];
+        GGML_ASSERT(x->type == GGML_TYPE_F32 && x->ne[1] == 1 && x->ne[2] == 1 && x->ne[3] == 1);
+        GGML_ASSERT(x->nb[0] == sizeof(float));
+        first[i] = i;
+        for (int j = 0; j < i; ++j) {
+            if (src1[j] == x) {
+                first[i] = first[j];
+                break;
+            }
+        }
+        if (first[i] == i) {
+            glue[i] = ggml_cuda_mk_glue_q8(ctx, x); // LLAMA_INKLING_MK_GLUE: quantized by the glue kernel already
+            if (glue[i] == nullptr) {
+                const int64_t ne10_padded = GGML_PAD(x->ne[0], MATRIX_ROW_PADDING);
+                offs[i] = total;
+                total  += GGML_PAD(ne10_padded*sizeof(block_q8_1)/QK8_1, 256);
+            }
+        }
+    }
+    ggml_cuda_pool_alloc<char> q8(ctx.pool());
+    if (total > 0) {
+        q8.alloc(total);
+    }
+    const block_q8_1 * vy[MMVQ_MULTI_MAX] = {};
+    for (int i = 0; i < n; ++i) {
+        if (first[i] != i) {
+            vy[i] = vy[first[i]];
+            continue;
+        }
+        if (glue[i] != nullptr) {
+            vy[i] = glue[i];
+            continue;
+        }
+        const ggml_tensor * x = src1[i];
+        const int64_t ne10        = x->ne[0];
+        const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+        char * q8_i = q8.get() + offs[i];
+        quantize_row_q8_1_cuda((const float *) x->data, q8_i, ne10, x->nb[1]/sizeof(float), x->nb[2]/sizeof(float),
+                x->nb[3]/sizeof(float), ne10_padded, 1, 1, 1, stream);
+        vy[i] = (const block_q8_1 *) q8_i;
+    }
+
+    // one launch per (type, small_k) group
+    bool done[MMVQ_MULTI_MAX] = {};
+    for (int i = 0; i < n; ++i) {
+        if (done[i]) {
+            continue;
+        }
+        const ggml_type type = src0[i]->type;
+        GGML_ASSERT(ggml_cuda_mul_mat_vec_q_multi_supported(type));
+        const auto small_k_of = [&](int ncols) {
+            switch (type) {
+                case GGML_TYPE_Q4_0:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q4_0>(ncols, cc);
+                case GGML_TYPE_Q5_0:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q5_0>(ncols, cc);
+                case GGML_TYPE_Q8_0:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q8_0>(ncols, cc);
+                case GGML_TYPE_Q3_K:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q3_K>(ncols, cc);
+                case GGML_TYPE_Q4_K:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q4_K>(ncols, cc);
+                case GGML_TYPE_Q5_K:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q5_K>(ncols, cc);
+                case GGML_TYPE_Q6_K:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q6_K>(ncols, cc);
+                case GGML_TYPE_IQ4_XS: return mul_mat_vec_q_multi_small_k<GGML_TYPE_IQ4_XS>(ncols, cc);
+                case GGML_TYPE_IQ4_NL: return mul_mat_vec_q_multi_small_k<GGML_TYPE_IQ4_NL>(ncols, cc);
+                default: GGML_ABORT("fatal error");
+            }
+        };
+        const bool small_k = small_k_of(src0[i]->ne[0]);
+        mmvq_multi_args args = {};
+        args.debug = debug;
+        int max_nrows = 0;
+        for (int j = i; j < n; ++j) {
+            if (done[j] || src0[j]->type != type || small_k_of(src0[j]->ne[0]) != small_k) {
+                continue;
+            }
+            const ggml_tensor * w = src0[j];
+            GGML_ASSERT(w->ne[2] == 1 && w->ne[3] == 1 && w->nb[0] == ggml_type_size(type) && w->ne[0] % ggml_blck_size(type) == 0);
+            GGML_ASSERT(w->ne[0] == src1[j]->ne[0] && dst[j]->type == GGML_TYPE_F32 && dst[j]->nb[0] == sizeof(float));
+            GGML_ASSERT(dst[j]->ne[0] == w->ne[1] && dst[j]->ne[1] == 1 && dst[j]->ne[2] == 1 && dst[j]->ne[3] == 1);
+            const int k = args.n++;
+            args.vx[k]           = w->data;
+            args.vy[k]           = vy[j];
+            args.dst[k]          = (float *) dst[j]->data;
+            args.nrows[k]        = (int) w->ne[1];
+            args.ncols_x[k]      = (int) w->ne[0];
+            args.stride_row_x[k] = (int) (w->nb[1] / ggml_type_size(type));
+            max_nrows = std::max(max_nrows, args.nrows[k]);
+            done[j] = true;
+        }
+        switch (type) {
+            case GGML_TYPE_Q4_0:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q4_0>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q5_0:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q5_0>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q8_0:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q8_0>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q3_K:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q3_K>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q4_K:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q4_K>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q5_K:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q5_K>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q6_K:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q6_K>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_IQ4_XS: mul_mat_vec_q_multi_launch<GGML_TYPE_IQ4_XS>(args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_IQ4_NL: mul_mat_vec_q_multi_launch<GGML_TYPE_IQ4_NL>(args, small_k, max_nrows, stream); break;
+            default: GGML_ABORT("fatal error");
+        }
+    }
+}
+
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Self-quantizing products (see mmvq.cuh): the input of each product is quantized to q8_1 in shared memory by the
+// block that uses it, with the arithmetic of quantize_q8_1 (one lane per value, warp max and sum over 32 lanes), then
+// the ncols_dst == 1 body of mul_mat_vec_q runs on it. The optional gate applies sigmoid(g)*x like unary_gated_op_kernel.
+
+#define MMVQ_SELFQ_MAX_COLS 3072
+
+struct mmvq_selfq_args {
+    int  n;
+    bool debug;
+    const void    * vx [MMVQ_MULTI_MAX]; // the weights; with ids the base of the expert tensor
+    const float   * x  [MMVQ_MULTI_MAX];
+    const float   * g  [MMVQ_MULTI_MAX]; // nullptr: no gate
+    float         * dst[MMVQ_MULTI_MAX];
+    int nrows[MMVQ_MULTI_MAX];
+    int ncols_x[MMVQ_MULTI_MAX];
+    int stride_row_x[MMVQ_MULTI_MAX];    // in blocks
+    const int32_t * ids;                 // nullptr: vx[m] is the matrix; else the matrix is expert ids[m] of vx[m]
+    size_t          expert_nbytes;       // bytes between experts
+};
+
+static __device__ __forceinline__ float mmvq_selfq_sigmoid(float x) {
+    return 1.0f / (1.0f + expf(-x)); // op_sigmoid of unary.cu
+}
+
+template <ggml_type type, bool small_k>
+__launch_bounds__(calc_nwarps(type, 1, get_device_table_id(), small_k, false)*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_selfq(const __grid_constant__ mmvq_selfq_args args) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int nwarps = calc_nwarps(type, 1, table_id, small_k, false);
+    constexpr int rows_per_cuda_block = calc_rows_per_block(type, 1, table_id, small_k, nwarps);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int m = blockIdx.y;
+    if (args.debug && (m >= args.n || args.vx[m] == nullptr || args.x[m] == nullptr || args.dst[m] == nullptr ||
+            args.ncols_x[m] % qk != 0 || args.ncols_x[m] % QK8_1 != 0 || args.ncols_x[m] > MMVQ_SELFQ_MAX_COLS || args.nrows[m] <= 0)) {
+        if (threadIdx.x == 0 && threadIdx.y == 0) {
+            printf("mul_mat_vec_q_selfq: bad product %d of %d at block (%u, %u): nrows %d ncols %d\n",
+                   m, args.n, blockIdx.x, blockIdx.y, args.nrows[m], args.ncols_x[m]);
+        }
+        return;
+    }
+    const int nrows = args.nrows[m];
+    const int row0  = rows_per_cuda_block*blockIdx.x;
+    if (row0 >= nrows) {
+        return; // uniform for the block
+    }
+    const int ncols_x = args.ncols_x[m];
+    const void * GGML_CUDA_RESTRICT vx = args.vx[m];
+    if (args.ids != nullptr) {
+        const int32_t expert = args.ids[m];
+        if (args.debug && expert < 0) {
+            if (threadIdx.x == 0 && threadIdx.y == 0) {
+                printf("mul_mat_vec_q_selfq: bad expert id %d at slot %d\n", expert, m);
+            }
+            return;
+        }
+        vx = (const char *) vx + (size_t) expert*args.expert_nbytes;
+    }
+
+    // the input, quantized like quantize_q8_1: lane iqs of a warp handles value ib*32 + iqs
+    __shared__ block_q8_1 yq[MMVQ_SELFQ_MAX_COLS/QK8_1];
+    {
+        const float * GGML_CUDA_RESTRICT x = args.x[m];
+        const float * GGML_CUDA_RESTRICT g = args.g[m];
+        const int nblk = ncols_x / QK8_1;
+        for (int ib = threadIdx.y; ib < nblk; ib += nwarps) {
+            if (threadIdx.x < QK8_1) {
+                const int i = ib*QK8_1 + threadIdx.x;
+                float xi = x[i];
+                if (g != nullptr) {
+                    xi = mmvq_selfq_sigmoid(g[i]) * xi;
+                }
+                float amax = fabsf(xi);
+                amax = warp_reduce_max<QK8_1>(amax);
+                const float  d = amax / 127.0f;
+                const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+                const int sum = warp_reduce_sum<QK8_1>((int) q);
+                yq[ib].qs[threadIdx.x] = q;
+                if (threadIdx.x == 0) {
+                    yq[ib].ds = make_half2(d, d * sum);
+                }
+            }
+        }
+    }
+    __syncthreads();
+
+    const block_q8_1 * y = yq;
+    float * GGML_CUDA_RESTRICT dst = args.dst[m];
+    const int blocks_per_row_x = ncols_x / qk;
+    const int stride_row_x     = args.stride_row_x[m];
+
+    const     int tid = warp_size*threadIdx.y + threadIdx.x;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    float tmp[rows_per_cuda_block] = {0.0f};
+    const int kbx_offset = row0*stride_row_x;
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+        for (int i = 0; i < rows_per_cuda_block; ++i) {
+            tmp[i] += vec_dot_q_cuda(vx, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][rows_per_cuda_block][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int i = 0; i < rows_per_cuda_block; ++i) {
+            tmp_shared[threadIdx.y-1][i][threadIdx.x] = tmp[i];
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+    dst += row0;
+#pragma unroll
+    for (int i = 0; i < rows_per_cuda_block; ++i) {
+#pragma unroll
+        for (int l = 0; l < nwarps-1; ++l) {
+            tmp[i] += tmp_shared[l][i][threadIdx.x];
+        }
+        tmp[i] = warp_reduce_sum<warp_size>(tmp[i]);
+        if (threadIdx.x == i && (rows_per_cuda_block == 1 || row0 + i < nrows)) {
+            dst[i] = tmp[i];
+        }
+    }
+}
+
+template <ggml_type type>
+static void mul_mat_vec_q_selfq_launch(const mmvq_selfq_args & args, bool small_k, int max_nrows, cudaStream_t stream) {
+    const int device = ggml_cuda_get_device();
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(ggml_cuda_info().devices[device].cc);
+    const int nwarps = calc_nwarps(type, 1, table_id, small_k, false);
+    const int rpb    = calc_rows_per_block(type, 1, table_id, small_k, nwarps);
+    const dim3 block_nums((max_nrows + rpb - 1)/rpb, args.n, 1);
+    const dim3 block_dims(warp_size, nwarps, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+    if (small_k) {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_selfq<type, true>, launch_params, args);
+    } else {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_selfq<type, false>, launch_params, args);
+    }
+}
+
+#define MMVQ_SELFQ_TYPES(X) \
+    X(GGML_TYPE_Q4_0) X(GGML_TYPE_Q5_0) X(GGML_TYPE_Q8_0) X(GGML_TYPE_Q2_K) X(GGML_TYPE_Q3_K) X(GGML_TYPE_Q4_K) X(GGML_TYPE_Q5_K) \
+    X(GGML_TYPE_Q6_K) X(GGML_TYPE_IQ2_XS) X(GGML_TYPE_IQ2_S) X(GGML_TYPE_IQ3_XXS) X(GGML_TYPE_IQ3_S) X(GGML_TYPE_IQ4_XS) \
+    X(GGML_TYPE_IQ4_NL) X(GGML_TYPE_NVFP4) X(GGML_TYPE_MXFP4)
+
+// quantize_q8_1 of one row of x*sigmoid(g) (the fused SIGMOID+MUL expression), the same lanes, reductions and
+// rounding as quantize_q8_1 for a single row
+static __global__ void quantize_q8_1_gated(const float * x, const float * g, void * vy, const int ne0) {
+    const int i = blockDim.x*blockIdx.x + threadIdx.x;
+    if (i >= ne0) {
+        return;
+    }
+    block_q8_1 * y = (block_q8_1 *) vy;
+    const int ib  = i / QK8_1;
+    const int iqs = i % QK8_1;
+    const float xi = mmvq_selfq_sigmoid(g[i]) * x[i];
+    float amax = fabsf(xi);
+    amax = warp_reduce_max<QK8_1>(amax);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+    const int sum = warp_reduce_sum<QK8_1>((int) q);
+    y[ib].qs[iqs] = q;
+    if (iqs > 0) {
+        return;
+    }
+    y[ib].ds = make_half2(d, d * sum);
+}
+
+// sigmoid(g)*x quantized to q8_1 with one launch (LLAMA_INKLING_MK_WOQ: the gated attention output before wo)
+void ggml_cuda_quantize_q8_1_gated(const float * x, const float * g, void * vy, int ne0, cudaStream_t stream) {
+    GGML_ASSERT(ne0 % QK8_1 == 0);
+    const dim3 num_blocks((ne0 + CUDA_QUANTIZE_BLOCK_SIZE - 1)/CUDA_QUANTIZE_BLOCK_SIZE, 1, 1);
+    const dim3 block_size(CUDA_QUANTIZE_BLOCK_SIZE, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(num_blocks, block_size, 0, stream);
+    ggml_cuda_kernel_launch(quantize_q8_1_gated, launch_params, x, g, vy, ne0);
+}
+
+// Products with more rows than this quantize their inputs with one launch per distinct input into one pool
+// allocation and run mul_mat_vec_q_multi: the in-kernel quantization repeats the whole input in every row block,
+// which costs more than the launch it saves once there are more than a few blocks.
+#define MMVQ_SELFQ_MAX_ROWS 64
+
+static void mul_mat_vec_q_multi_launch_type(ggml_type type, const mmvq_multi_args & args, bool small_k, int max_nrows, cudaStream_t stream) {
+    switch (type) {
+#define MMVQ_SELFQ_CASE(T) case T: mul_mat_vec_q_multi_launch<T>(args, small_k, max_nrows, stream); break;
+        MMVQ_SELFQ_TYPES(MMVQ_SELFQ_CASE)
+#undef MMVQ_SELFQ_CASE
+        default: GGML_ABORT("fatal error");
+    }
+}
+
+bool ggml_cuda_mul_mat_vec_q_selfq_supported(ggml_type type) {
+    switch (type) {
+#define MMVQ_SELFQ_CASE(T) case T:
+        MMVQ_SELFQ_TYPES(MMVQ_SELFQ_CASE)
+#undef MMVQ_SELFQ_CASE
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool mul_mat_vec_q_selfq_small_k_of(ggml_type type, int ncols, int cc) {
+    switch (type) {
+#define MMVQ_SELFQ_CASE(T) case T: return mul_mat_vec_q_multi_small_k<T>(ncols, cc);
+        MMVQ_SELFQ_TYPES(MMVQ_SELFQ_CASE)
+#undef MMVQ_SELFQ_CASE
+        default: GGML_ABORT("fatal error");
+    }
+}
+
+static void mul_mat_vec_q_selfq_launch_type(ggml_type type, const mmvq_selfq_args & args, bool small_k, int max_nrows, cudaStream_t stream) {
+    switch (type) {
+#define MMVQ_SELFQ_CASE(T) case T: mul_mat_vec_q_selfq_launch<T>(args, small_k, max_nrows, stream); break;
+        MMVQ_SELFQ_TYPES(MMVQ_SELFQ_CASE)
+#undef MMVQ_SELFQ_CASE
+        default: GGML_ABORT("fatal error");
+    }
+}
+
+void ggml_cuda_mul_mat_vec_q_selfq(ggml_backend_cuda_context & ctx, int n,
+        const ggml_tensor * const * src0, const ggml_tensor * const * src1, const ggml_tensor * const * gate, ggml_tensor * const * dst, bool debug) {
+    GGML_ASSERT(n >= 1 && n <= MMVQ_MULTI_MAX);
+    cudaStream_t stream = ctx.stream();
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+
+    int64_t total_rows = 0;
+    for (int i = 0; i < n; ++i) {
+        total_rows += src0[i]->ne[1];
+    }
+    if (total_rows > MMVQ_SELFQ_MAX_ROWS) {
+        // quantize each distinct (input, gate) once, one pool allocation (LIFO), then the multi kernel per group
+        int    first[MMVQ_MULTI_MAX];
+        size_t offs [MMVQ_MULTI_MAX] = {};
+        const block_q8_1 * glue[MMVQ_MULTI_MAX] = {};
+        size_t total = 0;
+        for (int i = 0; i < n; ++i) {
+            const ggml_tensor * x = src1[i];
+            const ggml_tensor * g = gate != nullptr ? gate[i] : nullptr;
+            first[i] = i;
+            for (int j = 0; j < i; ++j) {
+                if (src1[j] == x && (gate != nullptr ? gate[j] : nullptr) == g) {
+                    first[i] = first[j];
+                    break;
+                }
+            }
+            if (first[i] == i) {
+                // LLAMA_INKLING_MK_GLUE: an ungated input that the glue kernel quantized already
+                glue[i] = g == nullptr ? ggml_cuda_mk_glue_q8(ctx, x) : nullptr;
+                if (glue[i] == nullptr) {
+                    offs[i] = total;
+                    total  += GGML_PAD(GGML_PAD(x->ne[0], MATRIX_ROW_PADDING)*sizeof(block_q8_1)/QK8_1, 256);
+                }
+            }
+        }
+        ggml_cuda_pool_alloc<char> q8(ctx.pool());
+        if (total > 0) {
+            q8.alloc(total);
+        }
+        const block_q8_1 * vy[MMVQ_MULTI_MAX] = {};
+        for (int i = 0; i < n; ++i) {
+            if (first[i] != i) {
+                vy[i] = vy[first[i]];
+                continue;
+            }
+            if (glue[i] != nullptr) {
+                vy[i] = glue[i];
+                continue;
+            }
+            const ggml_tensor * x = src1[i];
+            const ggml_tensor * g = gate != nullptr ? gate[i] : nullptr;
+            GGML_ASSERT(x->type == GGML_TYPE_F32 && x->nb[0] == sizeof(float) && x->ne[1] == 1 && x->ne[2] == 1 && x->ne[3] == 1 && x->ne[0] % QK8_1 == 0);
+            char * q8_i = q8.get() + offs[i];
+            if (g == nullptr) {
+                quantize_row_q8_1_cuda((const float *) x->data, q8_i, x->ne[0], x->nb[1]/sizeof(float), x->nb[2]/sizeof(float),
+                        x->nb[3]/sizeof(float), GGML_PAD(x->ne[0], MATRIX_ROW_PADDING), 1, 1, 1, stream);
+            } else {
+                GGML_ASSERT(g->type == GGML_TYPE_F32 && g->nb[0] == sizeof(float) && ggml_nelements(g) == x->ne[0]);
+                const dim3 num_blocks((x->ne[0] + CUDA_QUANTIZE_BLOCK_SIZE - 1)/CUDA_QUANTIZE_BLOCK_SIZE, 1, 1);
+                const dim3 block_size(CUDA_QUANTIZE_BLOCK_SIZE, 1, 1);
+                const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(num_blocks, block_size, 0, stream);
+                ggml_cuda_kernel_launch(quantize_q8_1_gated, launch_params, (const float *) x->data, (const float *) g->data, (void *) q8_i, (int) x->ne[0]);
+            }
+            vy[i] = (const block_q8_1 *) q8_i;
+        }
+        bool done[MMVQ_MULTI_MAX] = {};
+        for (int i = 0; i < n; ++i) {
+            if (done[i]) {
+                continue;
+            }
+            const ggml_type type = src0[i]->type;
+            GGML_ASSERT(ggml_cuda_mul_mat_vec_q_selfq_supported(type));
+            const bool small_k = mul_mat_vec_q_selfq_small_k_of(type, src0[i]->ne[0], cc);
+            mmvq_multi_args args = {};
+            args.debug = debug;
+            int max_nrows = 0;
+            for (int j = i; j < n; ++j) {
+                if (done[j] || src0[j]->type != type || mul_mat_vec_q_selfq_small_k_of(type, src0[j]->ne[0], cc) != small_k) {
+                    continue;
+                }
+                const ggml_tensor * w = src0[j];
+                GGML_ASSERT(w->ne[2] == 1 && w->ne[3] == 1 && w->nb[0] == ggml_type_size(type) && w->ne[0] % ggml_blck_size(type) == 0);
+                GGML_ASSERT(w->ne[0] == src1[j]->ne[0] && dst[j]->type == GGML_TYPE_F32 && dst[j]->nb[0] == sizeof(float) && dst[j]->ne[0] == w->ne[1]);
+                const int k = args.n++;
+                args.vx[k]           = w->data;
+                args.vy[k]           = vy[j];
+                args.dst[k]          = (float *) dst[j]->data;
+                args.nrows[k]        = (int) w->ne[1];
+                args.ncols_x[k]      = (int) w->ne[0];
+                args.stride_row_x[k] = (int) (w->nb[1] / ggml_type_size(type));
+                max_nrows = std::max(max_nrows, args.nrows[k]);
+                done[j] = true;
+            }
+            mul_mat_vec_q_multi_launch_type(type, args, small_k, max_nrows, stream);
+        }
+        return;
+    }
+
+    bool done[MMVQ_MULTI_MAX] = {};
+    for (int i = 0; i < n; ++i) {
+        if (done[i]) {
+            continue;
+        }
+        const ggml_type type = src0[i]->type;
+        GGML_ASSERT(ggml_cuda_mul_mat_vec_q_selfq_supported(type));
+        const bool small_k = mul_mat_vec_q_selfq_small_k_of(type, src0[i]->ne[0], cc);
+        mmvq_selfq_args args = {};
+        args.debug = debug;
+        int max_nrows = 0;
+        for (int j = i; j < n; ++j) {
+            if (done[j] || src0[j]->type != type || mul_mat_vec_q_selfq_small_k_of(type, src0[j]->ne[0], cc) != small_k) {
+                continue;
+            }
+            const ggml_tensor * w = src0[j];
+            const ggml_tensor * x = src1[j];
+            GGML_ASSERT(w->ne[2] == 1 && w->ne[3] == 1 && w->nb[0] == ggml_type_size(type) && w->ne[0] % ggml_blck_size(type) == 0);
+            GGML_ASSERT(w->ne[0] % QK8_1 == 0 && w->ne[0] <= MMVQ_SELFQ_MAX_COLS);
+            GGML_ASSERT(x->type == GGML_TYPE_F32 && x->nb[0] == sizeof(float) && x->ne[0] == w->ne[0] && x->ne[1] == 1 && x->ne[2] == 1 && x->ne[3] == 1);
+            GGML_ASSERT(dst[j]->type == GGML_TYPE_F32 && dst[j]->nb[0] == sizeof(float) && dst[j]->ne[0] == w->ne[1] && dst[j]->ne[1] == 1);
+            if (gate != nullptr && gate[j] != nullptr) {
+                GGML_ASSERT(gate[j]->type == GGML_TYPE_F32 && gate[j]->nb[0] == sizeof(float) && ggml_nelements(gate[j]) == x->ne[0]);
+            }
+            const int k = args.n++;
+            args.vx[k]           = w->data;
+            args.x[k]            = (const float *) x->data;
+            args.g[k]            = gate != nullptr && gate[j] != nullptr ? (const float *) gate[j]->data : nullptr;
+            args.dst[k]          = (float *) dst[j]->data;
+            args.nrows[k]        = (int) w->ne[1];
+            args.ncols_x[k]      = (int) w->ne[0];
+            args.stride_row_x[k] = (int) (w->nb[1] / ggml_type_size(type));
+            max_nrows = std::max(max_nrows, args.nrows[k]);
+            done[j] = true;
+        }
+        mul_mat_vec_q_selfq_launch_type(type, args, small_k, max_nrows, stream);
+    }
+}
+
+void ggml_cuda_mul_mat_vec_q_id_selfq(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst, bool debug) {
+    cudaStream_t stream = ctx.stream();
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    const ggml_type type = src0->type;
+    GGML_ASSERT(ggml_cuda_mul_mat_vec_q_selfq_supported(type));
+    // one token: dst [ne0, n_expert_used, 1], src1 [ne10, 1 or n_expert_used, 1], ids [n_expert_used, 1]
+    const int n_used = (int) dst->ne[1];
+    GGML_ASSERT(n_used >= 1 && n_used <= MMVQ_MULTI_MAX && dst->ne[2] == 1 && dst->ne[3] == 1);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && src1->nb[0] == sizeof(float) && src1->ne[2] == 1 && src1->ne[3] == 1);
+    GGML_ASSERT(src1->ne[1] == 1 || src1->ne[1] == n_used);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->nb[0] == sizeof(int32_t) && ids->ne[0] == n_used && ids->ne[1] == 1);
+    GGML_ASSERT(src0->nb[0] == ggml_type_size(type) && src0->ne[0] % ggml_blck_size(type) == 0 && src0->ne[0] % QK8_1 == 0);
+    GGML_ASSERT(src0->ne[0] <= MMVQ_SELFQ_MAX_COLS && src0->ne[0] == src1->ne[0] && src0->ne[1] == dst->ne[0] && src0->ne[3] == 1);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && dst->nb[0] == sizeof(float));
+
+    const bool small_k = mul_mat_vec_q_selfq_small_k_of(type, (int) src0->ne[0], cc);
+    if ((int64_t) n_used*src0->ne[1] > MMVQ_SELFQ_MAX_ROWS) {
+        // the expert rows are many: one quantize launch for all slot inputs (as ggml_cuda_mul_mat_vec_q), then the
+        // multi kernel with the expert ids; at parity with the unfused path in launches, never slower
+        const int64_t ne10_padded = GGML_PAD(src1->ne[0], MATRIX_ROW_PADDING);
+        const int64_t n_y = src1->ne[1];
+        // LLAMA_INKLING_MK_GLUE: the token's input quantized by the glue kernel already (one row shared by the slots)
+        const block_q8_1 * glue_q8 = n_y == 1 ? ggml_cuda_mk_glue_q8(ctx, src1) : nullptr;
+        ggml_cuda_pool_alloc<char> q8(ctx.pool());
+        if (glue_q8 == nullptr) {
+            q8.alloc(n_y*ne10_padded*sizeof(block_q8_1)/QK8_1);
+            quantize_row_q8_1_cuda((const float *) src1->data, q8.get(), src1->ne[0], src1->nb[1]/sizeof(float), src1->nb[2]/sizeof(float),
+                    src1->nb[3]/sizeof(float), ne10_padded, n_y, 1, 1, stream);
+        }
+        const char * q8_d = glue_q8 != nullptr ? (const char *) glue_q8 : q8.get();
+        mmvq_multi_args args = {};
+        args.debug         = debug;
+        args.n             = n_used;
+        args.ids           = (const int32_t *) ids->data;
+        args.expert_nbytes = src0->nb[2];
+        for (int c = 0; c < n_used; ++c) {
+            args.vx[c]           = src0->data;
+            args.vy[c]           = (const block_q8_1 *) (q8_d + (n_y == 1 ? 0 : c*ne10_padded*sizeof(block_q8_1)/QK8_1));
+            args.dst[c]          = (float *) ((char *) dst->data + c*dst->nb[1]);
+            args.nrows[c]        = (int) src0->ne[1];
+            args.ncols_x[c]      = (int) src0->ne[0];
+            args.stride_row_x[c] = (int) (src0->nb[1] / ggml_type_size(type));
+        }
+        mul_mat_vec_q_multi_launch_type(type, args, small_k, (int) src0->ne[1], stream);
+        return;
+    }
+
+    mmvq_selfq_args args = {};
+    args.debug         = debug;
+    args.n             = n_used;
+    args.ids           = (const int32_t *) ids->data;
+    args.expert_nbytes = src0->nb[2];
+    for (int c = 0; c < n_used; ++c) {
+        args.vx[c]           = src0->data;
+        args.x[c]            = (const float *) ((const char *) src1->data + (src1->ne[1] == 1 ? 0 : c*src1->nb[1]));
+        args.g[c]            = nullptr;
+        args.dst[c]          = (float *) ((char *) dst->data + c*dst->nb[1]);
+        args.nrows[c]        = (int) src0->ne[1];
+        args.ncols_x[c]      = (int) src0->ne[0];
+        args.stride_row_x[c] = (int) (src0->nb[1] / ggml_type_size(type));
+    }
+    mul_mat_vec_q_selfq_launch_type(type, args, small_k, (int) src0->ne[1], stream);
+}
