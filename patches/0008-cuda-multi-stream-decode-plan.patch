diff --git a/ggml/src/ggml-cuda/mmvq-inkling.cu b/ggml/src/ggml-cuda/mmvq-inkling.cu
new file mode 100644
index 000000000..f935834a7
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvq-inkling.cu
@@ -0,0 +1,165 @@
+// LLAMA_INKLING_GEMV: one-token matrix-vector products for the Q8_0 / Q6_K attention projections of Inkling 2 Mini.
+//
+// mul_mat_vec_q's K loop has a run-time trip count (`for (kbx = ...; kbx < blocks_per_row_x; kbx += ...)`), so each
+// thread waits for the loads of one iteration before it issues those of the next: on the 2304-wide rows of Inkling 2
+// Mini that is 3 dependent rounds of global loads per thread (Q8_0: 72 blocks, 32 per iteration). This is the same
+// kernel with the row length as a template parameter: the loop is unrolled and every load of a thread is issued up
+// front. Same threads, same slices, same vec_dot functions, same reduction: the results are bit-identical.
+//
+// Also tried (docs/inkling-moonshot.md, "Branch gemv"): staging the rows in shared memory with 16-byte cp.async copies
+// (per-warp rings) or 16-byte register loads (everything in flight from the start) instead of the 2-byte loads. Both
+// were at best 4% faster on 3072 x 2304 and slower on the smaller shapes: a plain read of the same 7.5 MB takes 9.7 us
+// (the floor), and the staging kernels spent ~1 us after the last byte arrived computing from shared memory. The
+// 2-byte loads are not what limits mul_mat_vec_q on this GPU; the dependent load rounds are.
+
+#include "mmvq-inkling.cuh"
+
+#include "inkling2.cuh" // ggml_cuda_mk_glue_q8: the input already quantized by the glue kernel (LLAMA_INKLING_MK_GLUE)
+#include "quantize.cuh"
+#include "vecdotq.cuh"
+
+#include <cstdlib>
+#include <mutex>
+#include <set>
+#include <tuple>
+
+bool ggml_cuda_inkling_gemv_enabled() {
+    const char * env = getenv("LLAMA_INKLING_GEMV");
+    return env != nullptr && atoi(env) != 0;
+}
+
+// LLAMA_INKLING_GEMV_DEBUG: log the first launch of each (type, shape)
+static void inkling_gemv_log(ggml_type type, int64_t ncols, int64_t nrows) {
+    static const bool debug = getenv("LLAMA_INKLING_GEMV_DEBUG") != nullptr;
+    if (!debug) {
+        return;
+    }
+    static std::mutex mutex;
+    static std::set<std::tuple<int, int64_t, int64_t>> seen;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (seen.insert({(int) type, ncols, nrows}).second) {
+        GGML_LOG_INFO("inkling_gemv: %s %lld x %lld\n", ggml_type_name(type), (long long) ncols, (long long) nrows);
+    }
+}
+
+// mul_mat_vec_q<type, ncols_dst = 1, has_fusion = false> as it runs on NVIDIA Ampere and Ada (the generic parameter
+// table: 4 warps, one row per block, not the small_k variant), with ncols known at compile time
+template <ggml_type type, int ncols>
+__launch_bounds__(4*WARP_SIZE, 1)
+static __global__ void inkling_gemv(const char * __restrict__ x, const char * __restrict__ y, float * __restrict__ dst) {
+    constexpr int nwarps          = 4;
+    constexpr int qk              = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi              = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr             = type == GGML_TYPE_Q8_0 ? VDR_Q8_0_Q8_1_MMVQ : VDR_Q6_K_Q8_1_MMVQ;
+    constexpr int nb              = ncols / qk; // blocks per row
+    constexpr int blocks_per_iter = vdr*nwarps*WARP_SIZE / qi;
+    constexpr int nit             = (nb + blocks_per_iter - 1) / blocks_per_iter;
+    static_assert(type == GGML_TYPE_Q8_0 || type == GGML_TYPE_Q6_K, "the types of the Inkling 2 Mini projections");
+    static_assert(ncols % qk == 0, "whole blocks");
+    // mul_mat_vec_q switches to its small_k variant (rows_per_block = nwarps) when one iteration covers the row
+    static_assert(nb >= blocks_per_iter, "the small_k variant of mul_mat_vec_q is not reproduced");
+
+    const int tid = WARP_SIZE*threadIdx.y + threadIdx.x;
+    const int kqs = vdr*(tid % (qi/vdr));
+    const void       * xr = x + (size_t) blockIdx.x*nb*ggml_cuda_type_traits<type>::bs;
+    const block_q8_1 * yb = (const block_q8_1 *) y;
+
+    float tmp = 0.0f;
+#pragma unroll
+    for (int it = 0; it < nit; ++it) {
+        const int kbx = tid/(qi/vdr) + it*blocks_per_iter;
+        if (nb % blocks_per_iter == 0 || it < nit - 1 || kbx < nb) {
+            if constexpr (type == GGML_TYPE_Q8_0) {
+                tmp += vec_dot_q8_0_q8_1(xr, yb + kbx*(qk/QK8_1), kbx, kqs);
+            } else {
+                tmp += vec_dot_q6_K_q8_1(xr, yb + kbx*(qk/QK8_1), kbx, kqs);
+            }
+        }
+    }
+
+    // the partial sums of warps 1..3 added to warp 0's in order, then the warp sum, as in mul_mat_vec_q
+    __shared__ float tmp_shared[nwarps - 1][WARP_SIZE];
+    if (threadIdx.y > 0) {
+        tmp_shared[threadIdx.y - 1][threadIdx.x] = tmp;
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+#pragma unroll
+    for (int l = 0; l < nwarps - 1; ++l) {
+        tmp += tmp_shared[l][threadIdx.x];
+    }
+    tmp = warp_reduce_sum<WARP_SIZE>(tmp);
+    if (threadIdx.x == 0) {
+        dst[blockIdx.x] = tmp;
+    }
+}
+
+template <ggml_type type, int ncols>
+static void inkling_gemv_launch(const char * x, const char * y, float * dst, const int64_t nrows, cudaStream_t stream) {
+    inkling_gemv<type, ncols><<<(unsigned int) nrows, dim3(WARP_SIZE, 4), 0, stream>>>(x, y, dst);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// the shapes it was measured on (RTX 3090): the Inkling 2 Mini attention projections Q, gate (2304 -> 3072),
+// K, V (2304 -> 1024), R (2304 -> 384) and the output (3072 -> 2304)
+static bool inkling_gemv_shape(const int64_t ncols, const int64_t nrows) {
+    return (ncols == 2304 && (nrows == 3072 || nrows == 1024 || nrows == 384)) || (ncols == 3072 && nrows == 2304);
+}
+
+bool ggml_cuda_inkling_gemv(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    if (!ggml_cuda_inkling_gemv_enabled()) {
+        return false;
+    }
+    // mul_mat_vec_q uses its generic parameter table on NVIDIA Ampere and Ada except Orin; Hopper and newer also add
+    // PDL (and GB10 has its own table): tuned and checked on Ampere (RTX 3090) only
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_AMPERE || cc == GGML_CUDA_CC_ORIN || cc >= GGML_CUDA_CC_HOPPER) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_Q8_0 && src0->type != GGML_TYPE_Q6_K) {
+        return false;
+    }
+    const int64_t ncols = src0->ne[0];
+    const int64_t nrows = src0->ne[1];
+    if (!inkling_gemv_shape(ncols, nrows) || src0->ne[2] != 1 || src0->ne[3] != 1 || !ggml_is_contiguous(src0) ||
+            src1->type != GGML_TYPE_F32 || src1->ne[0] != ncols || src1->ne[1] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 ||
+            !ggml_is_contiguous(src1) || dst->type != GGML_TYPE_F32 || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    // weights only: a compute-buffer src0 may need the padding clear of mul_mat_vec_q
+    if (ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        return false;
+    }
+
+    cudaStream_t stream = ctx.stream();
+
+    // the q8_1 of the input, as mul_mat_vec_q makes it (or the glue kernel already did)
+    const int64_t ncols_padded = GGML_PAD(ncols, MATRIX_ROW_PADDING);
+    const block_q8_1 * glue_q8 = ggml_cuda_mk_glue_q8(ctx, src1);
+    ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool());
+    if (glue_q8 == nullptr) {
+        src1_q8_1.alloc(ncols_padded*sizeof(block_q8_1)/QK8_1);
+        quantize_row_q8_1_cuda((const float *) src1->data, src1_q8_1.get(), ncols, ncols, ncols, ncols, ncols_padded, 1, 1, 1, stream);
+    }
+    const char * y = glue_q8 != nullptr ? (const char *) glue_q8 : src1_q8_1.get();
+
+    inkling_gemv_log(src0->type, ncols, nrows);
+    const char * x = (const char *) src0->data;
+    float      * d = (float *) dst->data;
+    if (src0->type == GGML_TYPE_Q8_0) {
+        if (ncols == 2304) {
+            inkling_gemv_launch<GGML_TYPE_Q8_0, 2304>(x, y, d, nrows, stream);
+        } else {
+            inkling_gemv_launch<GGML_TYPE_Q8_0, 3072>(x, y, d, nrows, stream);
+        }
+    } else {
+        if (ncols == 2304) {
+            inkling_gemv_launch<GGML_TYPE_Q6_K, 2304>(x, y, d, nrows, stream);
+        } else {
+            inkling_gemv_launch<GGML_TYPE_Q6_K, 3072>(x, y, d, nrows, stream);
+        }
+    }
+    return true;
+}
