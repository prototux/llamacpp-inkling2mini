+    const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst, bool debug);
+
+// the types of the self-quantizing kernels: the attention and expert types of Inkling 2 Mini UD-Q3_K_XL
+bool ggml_cuda_mul_mat_vec_q_selfq_supported(ggml_type type);
+
 void ggml_cuda_op_mul_mat_vec_q(
     ggml_backend_cuda_context & ctx,
     const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst, const char * src0_dd_i, const float * src1_ddf_i,
     const char * src1_ddq_i, float * dst_dd_i, const int64_t row_low, const int64_t row_high, const int64_t src1_ncols,
     const int64_t src1_padded_row_size, cudaStream_t stream);
+
+// sigmoid(g)*x quantized to q8_1 with the arithmetic of the fused SIGMOID+MUL kernel and quantize_q8_1 (LLAMA_INKLING_MK_WOQ)
+void ggml_cuda_quantize_q8_1_gated(const float * x, const float * g, void * vy, int ne0, cudaStream_t stream);
diff --git a/ggml/src/ggml-cuda/moe-weighted-reduction.cu b/ggml/src/ggml-cuda/moe-weighted-reduction.cu
index 11ec58497..683488dd1 100644
--- a/ggml/src/ggml-cuda/moe-weighted-reduction.cu
+++ b/ggml/src/ggml-cuda/moe-weighted-reduction.cu
@@ -1,7 +1,13 @@
 #include "moe-weighted-reduction.cuh"
 
+// scale_ids (LLAMA_INKLING_MK_MOESCALE): the expert scale of row r is expert_scale[scale_ids[r]], i.e. the gather that
+// the graph does with REPEAT + GET_ROWS of the per-expert scale table before the products; the same values, so the same bits
+// exact: every operation rounded as the unfused MUL, MUL and ADD kernels round it (no FMA contraction of the last
+// multiply with the add), so the result is bit-identical to the unfused graph; false keeps the upstream arithmetic
+template <bool exact>
