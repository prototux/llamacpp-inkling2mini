+// GGML_CUDA_GRAPH_OPT: 1 is the fork/join optimization of the Q/K/V projections below, 2 the stream plan of
+// ggml_cuda_stream_plan_build (every independent chain of a small-batch graph on its own stream)
+static int ggml_cuda_graph_opt_mode() {
+    static const int mode = [] {
+        const char * env = getenv("GGML_CUDA_GRAPH_OPT");
+        return env != nullptr ? atoi(env) : 0;
+    }();
+    return mode;
+}
