 }
diff --git a/tests/test-sched-streams.cpp b/tests/test-sched-streams.cpp
new file mode 100644
index 000000000..ed790f54e
--- /dev/null
+++ b/tests/test-sched-streams.cpp
@@ -0,0 +1,167 @@
+// Runs a small-batch graph with many independent chains (a decode-like block: norm, sibling projections, in-place
+// cache writes, joins) through ggml_backend_sched on every backend and compares with the CPU. The CUDA backend's
+// GGML_CUDA_GRAPH_OPT=2 stream plan reorders nothing but runs the chains on several streams: this checks that the
+// cross-stream dependencies, the window joins and the pinned allocations give the sequential result.
+//
+//   GGML_CUDA_GRAPH_OPT=2 GGML_CUDA_GRAPH_OPT_DEBUG=1 ./test-sched-streams
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+static float frand(uint32_t & state) {
+    state = state*1664525u + 1013904223u;
+    return float(state >> 8)/float(1u << 24) - 0.5f;
+}
+
+struct block_weights {
+    ggml_tensor * norm;
+    ggml_tensor * w[6];
+    ggml_tensor * cache; // [n_embd, n_cells], written in place by the block and read back
+};
+
+// one block: h = rms_norm(x)*norm; six projections of h on independent chains; two of them written into the cache and
+// read back through views; the chains join into the block output x + sum(...)
+static ggml_tensor * build_block(ggml_context * ctx, ggml_tensor * x, const block_weights & bw, int cell) {
+    const int64_t n_embd = x->ne[0];
+    ggml_tensor * h = ggml_mul(ctx, ggml_rms_norm(ctx, x, 1e-6f), bw.norm);
+
+    ggml_tensor * p[6];
+    for (int i = 0; i < 6; ++i) {
+        p[i] = ggml_mul_mat(ctx, bw.w[i], h);
+    }
+    // chains of different lengths
+    ggml_tensor * a = ggml_mul(ctx, ggml_sigmoid(ctx, p[0]), p[1]);
+    ggml_tensor * b = ggml_scale(ctx, ggml_tanh(ctx, ggml_scale(ctx, p[2], 0.1f)), 10.0f);
+    // the cache: p[3] is stored in cell `cell`, p[4] in cell + 1, and both are read back (write-after-read hazards
+    // with the reads of the previous block, read-after-write within this one)
+    // (the first token's column of each)
+    ggml_tensor * store3 = ggml_cpy(ctx, ggml_view_1d(ctx, p[3], n_embd, 0), ggml_view_1d(ctx, bw.cache, n_embd, (cell    )*bw.cache->nb[1]));
+    ggml_tensor * store4 = ggml_cpy(ctx, ggml_view_1d(ctx, p[4], n_embd, 0), ggml_view_1d(ctx, bw.cache, n_embd, (cell + 1)*bw.cache->nb[1]));
+    ggml_tensor * window = ggml_view_2d(ctx, bw.cache, n_embd, 2, bw.cache->nb[1], cell*bw.cache->nb[1]);
+    ggml_tensor * c = ggml_sum_rows(ctx, ggml_cont(ctx, ggml_transpose(ctx, window))); // [2, 1] -> per cell sums
+    // make the reads depend on the stores explicitly, as the KV cache graph does
+    c = ggml_add(ctx, c, ggml_sum_rows(ctx, ggml_reshape_2d(ctx, store3, n_embd, 1)));
+    c = ggml_add(ctx, c, ggml_sum_rows(ctx, ggml_reshape_2d(ctx, store4, n_embd, 1)));
+    ggml_tensor * d = ggml_mul(ctx, ggml_silu(ctx, p[5]), ggml_repeat(ctx, ggml_view_1d(ctx, c, 1, 0), p[5]));
+
+    ggml_tensor * out = ggml_add(ctx, x, a);
+    out = ggml_add(ctx, out, b);
+    out = ggml_add(ctx, out, d);
+    return ggml_scale(ctx, out, 0.5f);
+}
+
+static std::vector<float> run(ggml_backend_t backend, ggml_backend_t cpu, int n_embd, int n_blocks, int n_tokens, uint32_t seed) {
+    const int n_tensors = 16 + n_blocks*64;
+    ggml_context * ctx_w = ggml_init({ggml_tensor_overhead()*(size_t) (8*n_blocks + 8), nullptr, true});
+    ggml_context * ctx   = ggml_init({ggml_tensor_overhead()*(size_t) n_tensors + ggml_graph_overhead_custom(n_tensors, false), nullptr, true});
+
+    std::vector<block_weights> bws(n_blocks);
+    for (int l = 0; l < n_blocks; ++l) {
+        bws[l].norm  = ggml_new_tensor_1d(ctx_w, GGML_TYPE_F32, n_embd);
+        for (int i = 0; i < 6; ++i) {
+            bws[l].w[i] = ggml_new_tensor_2d(ctx_w, GGML_TYPE_F16, n_embd, n_embd);
+        }
+        bws[l].cache = ggml_new_tensor_2d(ctx_w, GGML_TYPE_F32, n_embd, 8);
+    }
+    ggml_backend_buffer_t buf_w = ggml_backend_alloc_ctx_tensors(ctx_w, backend);
+    GGML_ASSERT(buf_w);
+
+    uint32_t state = seed;
+    std::vector<float>       f32(n_embd*n_embd);
+    std::vector<ggml_fp16_t> f16(n_embd*n_embd);
+    for (int l = 0; l < n_blocks; ++l) {
+        for (int i = 0; i < n_embd; ++i) {
+            f32[i] = 1.0f + 0.1f*frand(state);
+        }
+        ggml_backend_tensor_set(bws[l].norm, f32.data(), 0, n_embd*sizeof(float));
+        for (int w = 0; w < 6; ++w) {
+            for (int i = 0; i < n_embd*n_embd; ++i) {
+                f16[i] = ggml_fp32_to_fp16(frand(state)/sqrtf(float(n_embd)));
+            }
+            ggml_backend_tensor_set(bws[l].w[w], f16.data(), 0, f16.size()*sizeof(ggml_fp16_t));
+        }
+        std::fill(f32.begin(), f32.end(), 0.0f);
+        ggml_backend_tensor_set(bws[l].cache, f32.data(), 0, ggml_nbytes(bws[l].cache));
+    }
+
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tokens);
+    ggml_set_input(x);
+    ggml_tensor * cur = x;
+    for (int l = 0; l < n_blocks; ++l) {
+        cur = build_block(ctx, cur, bws[l], 2*(l % 3));
+    }
+    ggml_set_output(cur);
+    ggml_cgraph * gf = ggml_new_graph_custom(ctx, n_tensors, false);
+    ggml_build_forward_expand(gf, cur);
+
+    ggml_backend_t backends[2] = { backend, cpu };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, nullptr, backend == cpu ? 1 : 2, ggml_graph_n_nodes(gf) + 64, false, true);
+    GGML_ASSERT(ggml_backend_sched_alloc_graph(sched, gf));
+
+    std::vector<float> input(n_embd*n_tokens);
+    for (float & v : input) {
+        v = frand(state);
+    }
+    ggml_backend_tensor_set(x, input.data(), 0, input.size()*sizeof(float));
+
+    // twice: the second run reuses the allocation and, on CUDA, replays the captured graph; the cache is state, so
+    // it is cleared again in between
+    std::vector<float> out(n_embd*n_tokens), out2(n_embd*n_tokens);
+    GGML_ASSERT(ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS);
+    ggml_backend_tensor_get(cur, out.data(), 0, out.size()*sizeof(float));
+    ggml_backend_tensor_set(x, input.data(), 0, input.size()*sizeof(float));
+    std::fill(f32.begin(), f32.end(), 0.0f);
+    for (int l = 0; l < n_blocks; ++l) {
+        ggml_backend_tensor_set(bws[l].cache, f32.data(), 0, ggml_nbytes(bws[l].cache));
+    }
+    GGML_ASSERT(ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS);
+    ggml_backend_tensor_get(cur, out2.data(), 0, out2.size()*sizeof(float));
+    for (size_t i = 0; i < out.size(); ++i) {
+        GGML_ASSERT(std::isfinite(out[i]));
+        GGML_ASSERT(out[i] == out2[i] && "the second run differs from the first");
+    }
+
+    ggml_backend_sched_free(sched);
+    ggml_backend_buffer_free(buf_w);
+    ggml_free(ctx);
+    ggml_free(ctx_w);
+    return out;
+}
+
+int main() {
+    ggml_backend_load_all();
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    GGML_ASSERT(cpu);
+
+    int n_fail = 0;
+    for (int n_tokens : {1, 4}) {
+        const std::vector<float> ref = run(cpu, cpu, 256, 6, n_tokens, 12345u);
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                continue;
+            }
+            ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+            GGML_ASSERT(backend);
+            const std::vector<float> out = run(backend, cpu, 256, 6, n_tokens, 12345u);
+            double max_err = 0.0, max_ref = 0.0;
+            for (size_t k = 0; k < out.size(); ++k) {
+                max_err = std::max(max_err, (double) fabsf(out[k] - ref[k]));
+                max_ref = std::max(max_ref, (double) fabsf(ref[k]));
+            }
+            const bool ok = max_err <= 1e-3*std::max(1.0, max_ref);
+            printf("%s: n_tokens=%d, max |out| = %g, max error vs CPU = %g: %s\n", ggml_backend_name(backend), n_tokens, max_ref, max_err, ok ? "OK" : "FAIL");
+            n_fail += !ok;
+            ggml_backend_free(backend);
+        }
+    }
+    ggml_backend_free(cpu);
+    return n_fail == 0 ? 0 : 1;
+}
