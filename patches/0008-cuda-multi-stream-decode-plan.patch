diff --git a/scripts/inkling-gemv-bwprobe.cu b/scripts/inkling-gemv-bwprobe.cu
new file mode 100644
index 000000000..de7af6881
--- /dev/null
+++ b/scripts/inkling-gemv-bwprobe.cu
@@ -0,0 +1,80 @@
+// Read-bandwidth probe for the LLAMA_INKLING_GEMV work (docs/inkling-moonshot.md, "Branch gemv"): how long one
+// kernel takes to read N bytes once (no L2 reuse, 512 MB pool), i.e. the floor of a one-token GEMV over N bytes of
+// weights, and how much of a short kernel is fixed overhead. Four kernel variants (one pass or grid-stride, 4 or 8
+// 16-byte loads per thread), each launched 64 times per CUDA graph; the kernel durations come from nsys:
+//
+//   nvcc -O3 -arch=sm_86 -o bwprobe scripts/inkling-gemv-bwprobe.cu
+//   nsys profile -t cuda --cuda-graph-trace=node -o bw ./bwprobe && nsys stats -r cuda_gpu_kern_sum bw.nsys-rep
+//
+// RTX 3090: 0.98 MB 2.4 us, 2.52 MB 4.15 us, 7.52 MB 9.7 us, 30 MB 35.0 us (= 1.3 us + bytes / 892 GB/s).
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <cuda_runtime.h>
+#define CK(x) do { cudaError_t e = (x); if (e != cudaSuccess) { printf("%s: %s\n", #x, cudaGetErrorString(e)); exit(1); } } while (0)
+
+// each thread reads U int4 with stride blockDim*gridDim (one pass), xor-reduces, one store per block
+template <int U>
+__global__ void rd_plain(const int4 * __restrict__ x, int n4, int * out) {
+    int acc = 0;
+    const int i0 = blockIdx.x*blockDim.x*U + threadIdx.x;
+    int4 v[U];
+#pragma unroll
+    for (int u = 0; u < U; ++u) { const int i = i0 + u*blockDim.x; v[u] = i < n4 ? __ldcs(x + i) : make_int4(0,0,0,0); }
+#pragma unroll
+    for (int u = 0; u < U; ++u) acc ^= v[u].x ^ v[u].y ^ v[u].z ^ v[u].w;
+    if (acc == 0x12345678) out[blockIdx.x] = acc;
+}
+// persistent grid-stride version
+template <int U>
+__global__ void rd_persist(const int4 * __restrict__ x, int n4, int * out) {
+    int acc = 0;
+    for (int i0 = blockIdx.x*blockDim.x*U + threadIdx.x; i0 < n4; i0 += gridDim.x*blockDim.x*U) {
+        int4 v[U];
+#pragma unroll
+        for (int u = 0; u < U; ++u) { const int i = i0 + u*blockDim.x; v[u] = i < n4 ? __ldcs(x + i) : make_int4(0,0,0,0); }
+#pragma unroll
+        for (int u = 0; u < U; ++u) acc ^= v[u].x ^ v[u].y ^ v[u].z ^ v[u].w;
+    }
+    if (acc == 0x12345678) out[blockIdx.x] = acc;
+}
+
+int main() {
+    const size_t pool = 512ull << 20;
+    char * buf; int * out;
+    CK(cudaMalloc(&buf, pool)); CK(cudaMalloc(&out, 1 << 24));
+    CK(cudaMemset(buf, 1, pool));
+    cudaStream_t s; CK(cudaStreamCreate(&s));
+    int nsm; CK(cudaDeviceGetAttribute(&nsm, cudaDevAttrMultiProcessorCount, 0));
+    const size_t sizes[] = { 979968, 2519040, 7520256, 7520256*4 };
+    for (size_t bytes : sizes) {
+        const int n4 = (int) (bytes/16);
+        const int nbuf = (int) (pool/bytes);
+        for (int variant = 0; variant < 4; ++variant) {
+            cudaGraph_t g; cudaGraphExec_t ge;
+            CK(cudaStreamBeginCapture(s, cudaStreamCaptureModeGlobal));
+            const int nl = 64;
+            for (int l = 0; l < nl; ++l) {
+                const int4 * x = (const int4 *) (buf + (size_t) (l % nbuf)*((bytes + 255)/256*256));
+                switch (variant) {
+                    case 0: rd_plain<4><<<(n4 + 256*4 - 1)/(256*4), 256, 0, s>>>(x, n4, out); break;
+                    case 1: rd_plain<8><<<(n4 + 256*8 - 1)/(256*8), 256, 0, s>>>(x, n4, out); break;
+                    case 2: rd_persist<4><<<nsm*4, 256, 0, s>>>(x, n4, out); break;
+                    case 3: rd_persist<8><<<nsm*6, 128, 0, s>>>(x, n4, out); break;
+                }
+            }
+            CK(cudaStreamEndCapture(s, &g));
+            CK(cudaGraphInstantiate(&ge, g, 0));
+            CK(cudaGraphLaunch(ge, s)); CK(cudaStreamSynchronize(s));
+            cudaEvent_t a, b; cudaEventCreate(&a); cudaEventCreate(&b);
+            cudaEventRecord(a, s);
+            for (int r = 0; r < 10; ++r) CK(cudaGraphLaunch(ge, s));
+            cudaEventRecord(b, s); CK(cudaEventSynchronize(b));
+            float ms; cudaEventElapsedTime(&ms, a, b);
+            const double us = ms*1e3/(10*nl);
+            printf("bytes %9zu variant %d: %6.2f us per launch (graph), %5.0f GB/s\n", bytes, variant, us, bytes/us*1e-3);
+            cudaGraphExecDestroy(ge); cudaGraphDestroy(g);
+        }
+    }
+    return 0;
+}
diff --git a/scripts/inkling-launch-costs.cu b/scripts/inkling-launch-costs.cu
new file mode 100644
index 000000000..977ba53fe
--- /dev/null
+++ b/scripts/inkling-launch-costs.cu
@@ -0,0 +1,117 @@
+// Standalone: nvcc -O3 -arch=sm_86 -o launch-costs scripts/inkling-launch-costs.cu && ./launch-costs
+// Results on the RTX 3090 (2026-11-24): graph launch 1.30 us (empty 0.73), cooperative launch +0, cg grid barrier 1.02 us,
+// hand-rolled barrier 2.05 us, stream launch 2.03 us. See docs/inkling-moonshot.md, iteration 8.
+// Costs that decide the layer-kernel design on this GPU: a kernel launch inside a replayed CUDA graph, a cooperative
+// launch, a grid-wide barrier (cooperative groups and a hand-rolled one). 82 blocks x 1024 threads like the glue kernels.
+#include <cooperative_groups.h>
+#include <cstdio>
+#include <cstdlib>
+namespace cg = cooperative_groups;
+
+__global__ void k_empty(float * p) { if (threadIdx.x == 0 && blockIdx.x == 0 && p == nullptr) p[0] = 1.0f; }
+
+// touches 16 KB per block (like a small phase), no barrier
+__global__ void k_touch(float * p, int n) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    if (i < n) p[i] = p[i]*1.0001f + 1.0f;
+}
+
+template <int K>
+__global__ void k_coop(float * p, int n) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    for (int k = 0; k < K; ++k) {
+        if (i < n) p[i] = p[i]*1.0001f + 1.0f;
+        cg::this_grid().sync();
+    }
+    if (i < n) p[i] += 1.0f;
+}
+
+// hand-rolled: generation barrier, one atomic per block; needs co-residency (cooperative launch)
+__device__ __forceinline__ void grid_barrier(unsigned int * bar, unsigned int nblocks) {
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        __threadfence();
+        const unsigned int gen = bar[1];
+        if (atomicAdd(&bar[0], 1u) == nblocks - 1) {
+            bar[0] = 0;
+            __threadfence();
+            atomicAdd(&bar[1], 1u);
+        } else {
+            while (*((volatile unsigned int *) &bar[1]) == gen) { __nanosleep(32); }
+        }
+        __threadfence();
+    }
+    __syncthreads();
+}
+
+template <int K>
+__global__ void k_hand(float * p, int n, unsigned int * bar) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    for (int k = 0; k < K; ++k) {
+        if (i < n) p[i] = p[i]*1.0001f + 1.0f;
+        grid_barrier(bar, gridDim.x);
+    }
+    if (i < n) p[i] += 1.0f;
+}
+
+#define CK(x) do { cudaError_t e = (x); if (e != cudaSuccess) { printf("%s: %s\n", #x, cudaGetErrorString(e)); exit(1); } } while (0)
+
+static cudaStream_t st;
+static float * buf; static unsigned int * bar; static int n;
+
+template <typename F>
+static double timed_graph(F launch, int per_graph, int reps) {
+    cudaGraph_t g; cudaGraphExec_t ge;
+    CK(cudaStreamBeginCapture(st, cudaStreamCaptureModeRelaxed));
+    for (int i = 0; i < per_graph; ++i) launch();
+    CK(cudaStreamEndCapture(st, &g));
+    CK(cudaGraphInstantiate(&ge, g, 0));
+    CK(cudaGraphLaunch(ge, st)); CK(cudaStreamSynchronize(st));
+    cudaEvent_t a, b; CK(cudaEventCreate(&a)); CK(cudaEventCreate(&b));
+    CK(cudaEventRecord(a, st));
+    for (int r = 0; r < reps; ++r) CK(cudaGraphLaunch(ge, st));
+    CK(cudaEventRecord(b, st)); CK(cudaStreamSynchronize(st));
+    float ms; CK(cudaEventElapsedTime(&ms, a, b));
+    CK(cudaGraphExecDestroy(ge)); CK(cudaGraphDestroy(g));
+    return ms*1000.0/reps/per_graph; // us per launch
+}
+
+template <typename Kern, typename... Args>
+static void coop_launch(Kern kern, int grid, Args... args) {
+    cudaLaunchAttribute attr = {}; attr.id = cudaLaunchAttributeCooperative; attr.val.cooperative = 1;
+    cudaLaunchConfig_t cfg = {}; cfg.gridDim = dim3(grid); cfg.blockDim = dim3(1024); cfg.stream = st; cfg.attrs = &attr; cfg.numAttrs = 1;
+    CK(cudaLaunchKernelEx(&cfg, kern, args...));
+}
+
+int main() {
+    int dev = 0, nsm = 0; CK(cudaDeviceGetAttribute(&nsm, cudaDevAttrMultiProcessorCount, dev));
+    CK(cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking));
+    n = nsm*1024; CK(cudaMalloc(&buf, n*sizeof(float))); CK(cudaMemset(buf, 0, n*sizeof(float)));
+    CK(cudaMalloc(&bar, 2*sizeof(unsigned int))); CK(cudaMemset(bar, 0, 2*sizeof(unsigned int)));
+    const int G = nsm; // one block per SM
+    printf("SMs %d, grid %d x 1024\n", nsm, G);
+    printf("graph: empty kernel (1 block)             %6.2f us/launch\n", timed_graph([&]{ k_empty<<<1, 32, 0, st>>>(buf); }, 200, 20));
+    printf("graph: touch kernel (%d x 1024)           %6.2f us/launch\n", G, timed_graph([&]{ k_touch<<<G, 1024, 0, st>>>(buf, n); }, 200, 20));
+    printf("graph: cooperative touch, 0 barriers      %6.2f us/launch\n", timed_graph([&]{ coop_launch(k_coop<0>, G, buf, n); }, 200, 20));
+    double t1 = timed_graph([&]{ coop_launch(k_coop<1>, G, buf, n); }, 100, 20);
+    double t4 = timed_graph([&]{ coop_launch(k_coop<4>, G, buf, n); }, 100, 20);
+    double t16 = timed_graph([&]{ coop_launch(k_coop<16>, G, buf, n); }, 50, 20);
+    printf("graph: cooperative, 1/4/16 cg barriers    %6.2f %6.2f %6.2f us/launch -> %5.2f us per barrier\n", t1, t4, t16, (t16 - t4)/12.0);
+    double h1 = timed_graph([&]{ coop_launch(k_hand<1>, G, buf, n, bar); }, 100, 20);
+    double h4 = timed_graph([&]{ coop_launch(k_hand<4>, G, buf, n, bar); }, 100, 20);
+    double h16 = timed_graph([&]{ coop_launch(k_hand<16>, G, buf, n, bar); }, 50, 20);
+    printf("graph: cooperative, 1/4/16 hand barriers  %6.2f %6.2f %6.2f us/launch -> %5.2f us per barrier\n", h1, h4, h16, (h16 - h4)/12.0);
+    // the same with 2 blocks per SM (512 threads each would fit; here 1024 x 2 needs <= 32 regs: try)
+    int per_sm = 0; CK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, k_coop<4>, 1024, 0));
+    printf("resident 1024-thread blocks per SM for k_coop: %d\n", per_sm);
+    if (per_sm >= 2) {
+        double t4b = timed_graph([&]{ coop_launch(k_coop<4>, 2*G, buf, n); }, 100, 20);
+        double t16b = timed_graph([&]{ coop_launch(k_coop<16>, 2*G, buf, n); }, 50, 20);
+        printf("graph: cooperative %d blocks, 4/16 barriers %6.2f %6.2f -> %5.2f us per barrier\n", 2*G, t4b, t16b, (t16b - t4b)/12.0);
+    }
+    // non-graph launches for reference
+    cudaEvent_t a, b; CK(cudaEventCreate(&a)); CK(cudaEventCreate(&b));
+    CK(cudaEventRecord(a, st)); for (int i = 0; i < 500; ++i) k_touch<<<G, 1024, 0, st>>>(buf, n); CK(cudaEventRecord(b, st)); CK(cudaStreamSynchronize(st));
+    float ms; CK(cudaEventElapsedTime(&ms, a, b)); printf("stream (no graph): touch kernel          %6.2f us/launch\n", ms*1000/500);
+    return 0;
+}
