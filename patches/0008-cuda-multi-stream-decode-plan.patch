+        }
+        const inkling2_glue_unit & u = args.u[unit];
+        inkling2_glue_norm_quant<true>(args.yc + unit*INKLING2_GLUE_MAX_N, u.w_norm, u.y, u.q8, args.n, args.n_pad, u.eps_y, s_sum);
+        __syncthreads();
+    }
+}
+
+// the largest grid of the cooperative kernel the device keeps resident (0: cooperative launch not available)
+static int inkling2_glue_coop_max_grid() {
+    static int max_grid = -1;
+    if (max_grid < 0) {
+        const int device = ggml_cuda_get_device();
+        int coop = 0;
+        CUDA_CHECK(cudaDeviceGetAttribute(&coop, cudaDevAttrCooperativeLaunch, device));
+        int per_sm = 0;
+        if (coop) {
+            CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, inkling2_glue_coop_f32, INKLING2_GLUE_BLOCK, 0));
+        }
+        max_grid = coop ? per_sm*ggml_cuda_info().devices[device].nsm : 0;
+    }
+    return max_grid;
+}
+
+static void inkling2_glue_coop_launch(const inkling2_glue_args & args, int grid, cudaStream_t stream) {
+    cudaLaunchAttribute attr = {};
+    attr.id              = cudaLaunchAttributeCooperative;
+    attr.val.cooperative = 1;
+    cudaLaunchConfig_t cfg = {};
+    cfg.gridDim          = dim3(grid, 1, 1);
+    cfg.blockDim         = dim3(INKLING2_GLUE_BLOCK, 1, 1);
+    cfg.dynamicSmemBytes = 0;
+    cfg.stream           = stream;
+    cfg.attrs            = &attr;
+    cfg.numAttrs         = 1;
+    CUDA_CHECK(cudaLaunchKernelEx(&cfg, inkling2_glue_coop_f32, args));
+}
+#endif // INKLING2_GLUE_COOP
+
+// the next computed node at or after raw index k (views and empty nodes are skipped by the backend)
+static int inkling2_next_node(const ggml_cgraph * cgraph, int k) {
+    while (k < cgraph->n_nodes) {
+        const ggml_tensor * t = cgraph->nodes[k];
+        if (!(ggml_is_empty(t) || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_TRANSPOSE || t->op == GGML_OP_VIEW ||
+              t->op == GGML_OP_PERMUTE || t->op == GGML_OP_NONE)) {
+            break;
+        }
+        k++;
+    }
+    return k;
+}
+
+// the node at index k is used only inside the run (its uses are the given count) and is not a graph output
+static bool inkling2_internal(const ggml_cgraph * cgraph, int k, int n_uses) {
+    const ggml_tensor * t = cgraph->nodes[k];
+    return ggml_node_get_use_count(cgraph, k) == n_uses && !(t->flags & GGML_TENSOR_FLAG_OUTPUT) && t->view_src == nullptr;
+}
+
+// the chain inputs come from outside the run: none is computed by a node of the run (the view nodes of the run compute
+// nothing, so a view inside the run is fine as long as its source is from outside)
+static bool inkling2_glue_outside(const ggml_cgraph * cgraph, int i, int n, std::initializer_list<const ggml_tensor *> tensors) {
+    for (const ggml_tensor * t : tensors) {
+        if (t == nullptr) {
+            continue;
+        }
+        const ggml_tensor * root = t;
+        while (root->view_src != nullptr) {
+            root = root->view_src;
+        }
+        for (int k = i; k < i + n && k < cgraph->n_nodes; ++k) {
+            const ggml_tensor * node = cgraph->nodes[k];
+            const bool view = node->op == GGML_OP_RESHAPE || node->op == GGML_OP_VIEW || node->op == GGML_OP_PERMUTE ||
+                              node->op == GGML_OP_TRANSPOSE;
+            if (node == root || (node == t && !view)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+// RMS_NORM(x) MUL(., w) at raw index k with the conditions of the fused rms_norm_f32 launch the glue replicates: fills
+// x, w, the MUL node and the eps; returns the raw index past the MUL, 0 if there is no match
+static int inkling2_match_norm_mul(const ggml_cgraph * cgraph, int k, const ggml_tensor ** x, const ggml_tensor ** w,
+        ggml_tensor ** y, float & eps) {
+    if (k + 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * norm = cgraph->nodes[k];
+    const int           km   = inkling2_next_node(cgraph, k + 1);
+    if (km >= cgraph->n_nodes || norm->op != GGML_OP_RMS_NORM) {
+        return 0;
+    }
+    ggml_tensor * mul = cgraph->nodes[km];
+    if (mul->op != GGML_OP_MUL || mul->src[0] != norm || !inkling2_internal(cgraph, k, 1)) {
+        return 0;
+    }
+    const ggml_tensor * xx = norm->src[0];
+    const ggml_tensor * ww = mul->src[1];
+    const int64_t       n  = xx->ne[0];
+    if (norm->type != GGML_TYPE_F32 || xx->type != GGML_TYPE_F32 || ww->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous_rows(xx) || xx->nb[0] != sizeof(float) || ggml_nelements(xx) != n || !ggml_is_contiguous(ww) ||
+            ggml_nelements(ww) != n || ww->ne[0] != n || !ggml_is_contiguous(mul) || ggml_nelements(mul) != n || mul->ne[0] != n ||
+            !ggml_are_same_shape(norm, mul) || n % 4 != 0 || n/4 <= 512 || n/4 > INKLING2_GLUE_BLOCK ||
+            (uintptr_t) xx->data % 16 != 0 || (uintptr_t) ww->data % 16 != 0 || (uintptr_t) mul->data % 16 != 0) {
+        return 0;
+    }
+    *x  = xx;
+    *w  = ww;
+    *y  = mul;
+    eps = ggml_get_op_params_f32(norm, 0);
+    return km + 1;
+}
+
+// a quantized one-token product that reads t (or a reshape of t) within the next nodes: the q8_1 of t will be consumed
+static bool inkling2_glue_consumed(const ggml_cgraph * cgraph, int k, const ggml_tensor * t) {
+    for (int j = k; j < cgraph->n_nodes && j < k + 48; ++j) {
+        const ggml_tensor * c = cgraph->nodes[j];
+        if ((c->op != GGML_OP_MUL_MAT && c->op != GGML_OP_MUL_MAT_ID) || !ggml_is_quantized(c->src[0]->type)) {
+            continue;
+        }
+        const ggml_tensor * s = c->src[1];
+        while (s != nullptr && s != t && s->view_src != nullptr && s->view_offs == 0) {
+            s = s->view_src;
+        }
+        if (s == t && c->src[1]->ne[1] == 1 && c->src[1]->ne[2] == 1 && c->src[1]->ne[3] == 1) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool ggml_cuda_inkling2_glue_match(const ggml_cgraph * cgraph, int i, ggml_cuda_inkling2_glue & glue) {
+    glue = ggml_cuda_inkling2_glue();
+    if (i >= cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_RMS_NORM) {
+        return false;
+    }
+    const int device = ggml_cuda_get_device();
+    if (ggml_cuda_info().devices[device].warp_size != WARP_SIZE) {
+        return false;
+    }
+
+    int k = i;
+
+    // the depth mix before the units, when the exact kernel replicates it (even state counts, mul_mat_vec_f shapes):
+    // its output is consumed only through the units' input views, so it never has to be written
+    {
+        ggml_cuda_inkling2_args mx;
+        if (inkling2_match_mix(cgraph, i, mx) && mx.node[3] != nullptr && mx.dst->ne[2] == 1 && mx.src[2]->ne[1] <= 3 &&
+                !(mx.dst->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            glue.mix         = true;
+            glue.mix_dst     = mx.dst;
+            glue.mix_p       = mx.src[0];
+            glue.mix_x       = mx.src[1];
+            glue.mix_q       = mx.src[2];
+            glue.mix_norm    = mx.node[0];
+            glue.mix_softmax = mx.node[1];
+            glue.mix_concat  = mx.node[2];
+            k = inkling2_next_node(cgraph, i + mx.n_nodes);
+            if (k >= cgraph->n_nodes || cgraph->nodes[k]->op != GGML_OP_RMS_NORM) {
+                return false;
+            }
+        }
+    }
+
+    // the controllers: CTRL_DOWN_j CTRL_OUT_j, up to three, until a RMS_NORM of a controller output starts the norms
+    while (glue.n_units < 3) {
+        const ggml_tensor * t = cgraph->nodes[k];
+        bool of_unit = false;
+        for (int j = 0; j < glue.n_units; ++j) {
+            of_unit = of_unit || t->src[0] == glue.u[j].out;
+        }
+        if (t->op != GGML_OP_RMS_NORM || of_unit) {
+            break;
+        }
+        ggml_cuda_inkling2_args cd;
+        if (!inkling2_match_ctrl_down(cgraph, k, cd)) {
+            break;
+        }
+        const int ko = inkling2_next_node(cgraph, k + cd.n_nodes);
+        ggml_cuda_inkling2_args co;
+        if (ko >= cgraph->n_nodes || !inkling2_match_ctrl_out(cgraph, ko, co)) {
+            return false;
+        }
+        // the controller input h feeds the two gate products only, x and m are the controller's own
+        if (co.src[2] != cd.dst || co.src[3] != cd.src[0] || co.node[0] != cd.src[1] ||
+                !inkling2_internal(cgraph, k + cd.n_nodes - 1, 2) || !inkling2_internal(cgraph, ko + co.n_nodes - 1, 1)) {
+            return false;
+        }
+        auto & u    = glue.u[glue.n_units++];
+        u.x         = cd.src[0];
+        u.m         = cd.src[1];
+        u.w_down    = cd.src[2];
+        u.f         = co.src[0];
+        u.g         = co.src[1];
+        u.norm_x    = cd.node[0];
+        u.norm_m    = cd.node[1];
+        u.out       = co.dst;
+        k = inkling2_next_node(cgraph, ko + co.n_nodes);
+        if (k >= cgraph->n_nodes) {
+            return false;
+        }
+    }
+    glue.ctrl = glue.n_units > 0;
+
+    // the norms: one per controller in order, or up to three independent ones
+    if (glue.ctrl) {
+        for (int j = 0; j < glue.n_units; ++j) {
+            auto & u = glue.u[j];
+            const ggml_tensor * x = nullptr;
+            const int kn = inkling2_match_norm_mul(cgraph, k, &x, &u.w_norm, &u.y, u.eps_y);
+            if (kn == 0 || x != u.out) {
+                return false;
+            }
+            k = kn;
+            if (j + 1 < glue.n_units) {
+                k = inkling2_next_node(cgraph, k);
+            }
+        }
+    } else {
+        while (glue.n_units < 3) {
+            auto & u = glue.u[glue.n_units];
+            const int kn = inkling2_match_norm_mul(cgraph, k, &u.x, &u.w_norm, &u.y, u.eps_y);
+            if (kn == 0) {
+                break;
+            }
+            // independent units: the input of this one is not computed by the run
+            bool dependent = false;
+            for (int j = 0; j < glue.n_units; ++j) {
+                dependent = dependent || u.x == glue.u[j].y || (u.x->view_src != nullptr && u.x->view_src == glue.u[j].y);
+            }
+            if (dependent) {
+                break;
+            }
+            glue.n_units++;
+            k = kn;
+            if (glue.n_units < 3) {
+                const int kk = inkling2_next_node(cgraph, k);
+                if (kk >= cgraph->n_nodes || cgraph->nodes[kk]->op != GGML_OP_RMS_NORM) {
+                    break;
+                }
+                k = kk;
+            }
+        }
+        if (glue.n_units == 0) {
+            return false;
+        }
+    }
+    glue.n_nodes = k - i;
+
+    // the same row length, every chain input from outside the run
+    const int64_t n = glue.u[0].y->ne[0];
+    for (int j = 0; j < glue.n_units; ++j) {
+        const auto & u = glue.u[j];
+        if (u.y->ne[0] != n || u.x->ne[0] != n || (glue.ctrl && (u.m->ne[0] != n || u.w_down->ne[1] != glue.u[0].w_down->ne[1]))) {
+            return false;
+        }
+        if (!inkling2_glue_outside(cgraph, i, glue.n_nodes, { glue.mix ? nullptr : u.x, u.m, u.w_down, u.f, u.g, u.w_norm })) {
+            return false;
+        }
+        if ((!glue.mix && (uintptr_t) u.x->data % 16 != 0) || (glue.ctrl && (uintptr_t) u.m->data % 16 != 0)) {
+            return false;
+        }
+    }
+    if (glue.mix) {
+        // every unit input is a row view of the mix output, the mix output and the views have no other uses
+        const ggml_tensor * dst = glue.mix_dst;
+        if (dst->ne[0] != n || glue.mix_x->ne[0] != n ||
+                !inkling2_glue_outside(cgraph, i, glue.n_nodes, { glue.mix_p, glue.mix_x, glue.mix_q })) {
+            return false;
+        }
+        int n_views = 0;
+        for (int j = 0; j < glue.n_units; ++j) {
+            auto & u = glue.u[j];
+            if (u.x->view_src != dst || u.x->view_offs % dst->nb[1] != 0 || u.x->view_offs / dst->nb[1] >= (size_t) dst->ne[1] ||
+                    ggml_nelements(u.x) != n || u.x->nb[0] != sizeof(float)) {
+                return false;
+            }
+            u.q_idx = (int) (u.x->view_offs / dst->nb[1]);
+            // the view's uses: the units that read it (3 nodes each with controllers, 1 without), inside the run
+            int uses = 0, first = -1;
+            for (int jj = 0; jj < glue.n_units; ++jj) {
+                if (glue.u[jj].x == u.x) {
+                    uses += glue.ctrl ? 3 : 1;
+                    first = first < 0 ? jj : first;
+                }
+            }
+            if (first != j) {
+                continue; // counted with the first unit of this view
+            }
+            n_views++;
+            int kx = -1;
+            for (int kk = i; kk < i + glue.n_nodes; ++kk) {
+                if (cgraph->nodes[kk] == u.x) {
+                    kx = kk;
+                    break;
+                }
+            }
+            if (kx < 0 || ggml_node_get_use_count(cgraph, kx) != uses || (u.x->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                return false;
+            }
+        }
+        if (ggml_node_get_use_count(cgraph, i + 7) != n_views) {
+            return false;
+        }
+    }
+    // the units run together: no output may share memory with an input or another output
+    for (int a = 0; a < glue.n_units; ++a) {
+        const ggml_tensor * y = glue.u[a].y;
+        for (int b = 0; b < glue.n_units; ++b) {
+            const auto & u = glue.u[b];
+            // a unit's own output may sit on its input (ggml-alloc in place): the block reads x before it writes y, and
+            // with controllers every block has finished reading x when the last one writes y. With the mix the inputs
+            // are the mix's (read by every unit's blocks), the mix output itself is never touched.
+            if ((!glue.mix && (a == b ? !inkling2_same_or_disjoint(y, u.x) : inkling2_overlap(y, u.x))) || inkling2_overlap(y, u.w_norm) ||
+                    (glue.ctrl && inkling2_overlap(y, u.m)) || (a != b && inkling2_overlap(y, u.y))) {
+                return false;
+            }
+        }
+        if (glue.mix && (inkling2_overlap(y, glue.mix_p) || inkling2_overlap(y, glue.mix_x) || inkling2_overlap(y, glue.mix_q))) {
+            return false;
+        }
+    }
+    // without controllers the glue pays off only when a quantized product consumes an output (its quantize launch)
+    if (!glue.ctrl) {
+        bool consumed = false;
+        for (int j = 0; j < glue.n_units; ++j) {
+            consumed = consumed || inkling2_glue_consumed(cgraph, k, glue.u[j].y);
+        }
+        if (!consumed) {
+            return false;
+        }
+    }
+    return true;
+}
+
+block_q8_1 * ggml_cuda_mk_glue_publish(ggml_backend_cuda_context & ctx, const ggml_tensor * t) {
+    ggml_cuda_mk_glue_state & st = inkling2_glue_state(ctx);
+    GGML_ASSERT(t->ne[0] <= INKLING2_GLUE_MAX_N && t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1);
+    const int slot = st.next;
+    st.next = (st.next + 1) % INKLING2_GLUE_SLOTS;
+    block_q8_1 * q8 = st.slot(slot);
+    for (int e = 0; e < st.n_entries; ++e) {
+        if (st.entries[e].q8 == q8) {
+            st.entries[e] = st.entries[--st.n_entries]; // the slot is reused: its earlier output is gone
+            break;
+        }
+    }
+    if (st.n_entries < INKLING2_GLUE_SLOTS) {
+        auto & e = st.entries[st.n_entries++];
+        e.t    = t;
+        e.data = t->data;
+        e.ne0  = t->ne[0];
+        e.q8   = q8;
+    }
+    return q8;
+}
+
+int ggml_cuda_mk_glue_next_slot(ggml_backend_cuda_context & ctx) {
+    return inkling2_glue_state(ctx).next;
+}
+
+block_q8_1 * ggml_cuda_mk_glue_slot(ggml_backend_cuda_context & ctx, int i) {
+    return inkling2_glue_state(ctx).slot(i % INKLING2_GLUE_SLOTS);
+}
+
+void ggml_cuda_inkling2_glue_run(ggml_backend_cuda_context & ctx, const ggml_cuda_inkling2_glue & glue, int mode, bool debug, bool publish) {
+    ggml_cuda_mk_glue_state & st = inkling2_glue_state(ctx);
+
+    const int n     = (int) glue.u[0].y->ne[0];
+    const int n_pad = (int) GGML_PAD(n, MATRIX_ROW_PADDING);
+    GGML_ASSERT(glue.n_units >= 1 && glue.n_units <= 3 && n % 4 == 0 && n/4 > 512 && n/4 <= INKLING2_GLUE_BLOCK);
+
+    inkling2_glue_args args = {};
+    args.n_units  = glue.n_units;
+    args.n        = n;
+    args.n_pad    = n_pad;
+    args.debug    = debug;
+    args.h        = st.h();
+    args.yc       = st.yc();
+    args.xm       = st.xm();
+    args.counters = st.counters();
+    args.has_mix  = glue.mix;
+    if (glue.mix) {
+        args.mmvf_block_mix = inkling2_mmvf_block_size(n, WARP_SIZE);
+        GGML_ASSERT(INKLING2_GLUE_BLOCK % args.mmvf_block_mix == 0 && glue.mix_concat->ne[1] % 2 == 0 &&
+                glue.mix_concat->ne[1] <= INKLING2_MIX_MAX_STATES);
+    }
+    for (int j = 0; j < glue.n_units; ++j) {
+        const auto & gu = glue.u[j];
+        auto & u = args.u[j];
+        u.x      = (const float *) gu.x->data;
+        u.w_norm = (const float *) gu.w_norm->data;
+        u.y      = (float *) gu.y->data;
+        u.eps_y  = gu.eps_y;
+        if (glue.mix) {
+            u.x            = nullptr; // the mix output is not written: the kernels mix into their scratch
+            u.mix_p        = (const float *) glue.mix_p->data;
+            u.mix_x        = (const float *) glue.mix_x->data;
+            u.mix_q        = (const float *) ((const char *) glue.mix_q->data + gu.q_idx*glue.mix_q->nb[1]);
+            u.mix_p_s1     = (int64_t) (glue.mix_p->nb[1]/sizeof(float));
+            u.mix_n_states = (int) glue.mix_concat->ne[1];
+            u.mix_eps      = ggml_get_op_params_f32(glue.mix_norm, 0);
+            u.mix_scale    = ggml_get_op_params_f32(glue.mix_softmax, 0);
+        }
+        if (glue.ctrl) {
+            u.m         = (const float *) gu.m->data;
+            u.w_down    = (const float *) gu.w_down->data;
+            u.f         = (const float *) gu.f->data;
+            u.g         = (const float *) gu.g->data;
+            u.w_down_s1 = (int64_t) (gu.w_down->nb[1]/sizeof(float));
+            u.f_s1      = (int64_t) (gu.f->nb[1]/sizeof(float));
+            u.g_s1      = (int64_t) (gu.g->nb[1]/sizeof(float));
+            u.eps_x     = ggml_get_op_params_f32(gu.norm_x, 0);
+            u.eps_m     = ggml_get_op_params_f32(gu.norm_m, 0);
+        }
+        // the q8_1 of the output into the next slot; a consumer finds it by the output tensor
+        const int slot = st.next;
+        st.next = (st.next + 1) % INKLING2_GLUE_SLOTS;
+        u.q8 = st.slot(slot);
+        for (int e = 0; e < st.n_entries; ++e) {
+            if (st.entries[e].q8 == u.q8) {
+                st.entries[e] = st.entries[--st.n_entries]; // the slot is reused: its earlier output is gone
+                break;
+            }
+        }
+        if (publish && st.n_entries < INKLING2_GLUE_SLOTS) {
+            auto & e = st.entries[st.n_entries++];
+            e.t    = gu.y;
+            e.data = gu.y->data;
+            e.ne0  = n;
+            e.q8   = u.q8;
+        }
+    }
+
+    if (glue.ctrl) {
+        const int rank       = (int) glue.u[0].w_down->ne[1];
+        const int mmvf_block = inkling2_mmvf_block_size(2*(int64_t) n, WARP_SIZE);
+        const int n_groups   = INKLING2_GLUE_BLOCK/mmvf_block;
+        GGML_ASSERT(rank >= 2 && rank % 2 == 0 && rank <= INKLING2_GLUE_MAX_RANK && INKLING2_GLUE_BLOCK % mmvf_block == 0);
+        args.rank       = rank;
+        args.mmvf_block = mmvf_block;
+
+#ifdef INKLING2_GLUE_COOP
+        if (mode == 2) {
+            // one cooperative kernel; the grid covers the larger phase but stays resident, else the two kernels
+            const int n_rblocks = (n + INKLING2_GLUE_BLOCK/WARP_SIZE - 1)/(INKLING2_GLUE_BLOCK/WARP_SIZE);
+            const int n_dblocks = (rank + n_groups - 1)/n_groups;
+            const int wanted    = std::max(n_rblocks, n_dblocks)*glue.n_units;
+            const int grid      = std::min(wanted, inkling2_glue_coop_max_grid());
+            if (grid >= 1) {
+                inkling2_glue_coop_launch(args, grid, ctx.stream());
+                if (debug) {
+                    static bool logged = false;
+                    if (!logged) {
+                        logged = true;
+                        GGML_LOG_INFO("mk_glue: cooperative kernel, grid %d of %d wanted (%d resident blocks)\n", grid, wanted, inkling2_glue_coop_max_grid());
+                    }
+                }
+                return;
+            }
+        }
+#else
+        GGML_UNUSED(mode);
+#endif // INKLING2_GLUE_COOP
+
+        // controller outputs per block of kernel A: all 1024/mmvf_block groups (16 blocks per unit) as CTRL_DOWN; fewer
+        // outputs per block (more blocks, idle groups) measured slower on the 3090 (1: 70.4 us, 2: 68.1, 4: 65.9 for
+        // the loop-pass case); LLAMA_INKLING_MK_GLUE_GROUPS keeps the experiment reachable
+        static const int groups_env = getenv("LLAMA_INKLING_MK_GLUE_GROUPS") ? atoi(getenv("LLAMA_INKLING_MK_GLUE_GROUPS")) : 0;
+        args.groups = groups_env >= 1 ? std::min(n_groups, groups_env) : n_groups;
+        const ggml_cuda_kernel_launch_params pa(dim3((rank + args.groups - 1)/args.groups, glue.n_units, 1), dim3(INKLING2_GLUE_BLOCK, 1, 1), 0, ctx.stream());
+        ggml_cuda_kernel_launch(inkling2_glue_ctrl_down_f32, pa, args);
+        const ggml_cuda_kernel_launch_params pb(dim3((n + INKLING2_GLUE_BLOCK/WARP_SIZE - 1)/(INKLING2_GLUE_BLOCK/WARP_SIZE), glue.n_units, 1), dim3(INKLING2_GLUE_BLOCK, 1, 1), 0, ctx.stream());
+        ggml_cuda_kernel_launch(inkling2_glue_norm_f32<true>, pb, args);
+    } else {
+        const ggml_cuda_kernel_launch_params pb(dim3(1, glue.n_units, 1), dim3(INKLING2_GLUE_BLOCK, 1, 1), 0, ctx.stream());
+        ggml_cuda_kernel_launch(inkling2_glue_norm_f32<false>, pb, args);
+    }
+    if (debug) {
+        static std::set<const ggml_tensor *> logged;
+        if (logged.insert(glue.u[0].y).second) {
+            GGML_LOG_INFO("mk_glue: %d unit(s)%s%s, n %d, %d nodes from %s\n", glue.n_units, glue.ctrl ? " with controllers" : "",
+                    glue.mix ? " with the mix" : "", n, glue.n_nodes, glue.u[0].x->name);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// RELTAB (LLAMA_INKLING_MK_RELTAB): the relative-position bias table of one token's attention,
+//   table[e, h] = sum_k pad(W)[k, e] * Rcur[k, h],  Rcur = clip(R*w) [* tau],  pad(W) = W [k, E] with a zero row E
+// as one kernel instead of PAD, CLIP and the cuBLAS SGEMM (k 16, n 24, m 1025) the unfused graph runs. The dot is the
+// FMA chain over k in ascending order, which gives the bits of cublasSgemm for this shape on the 3090 (0 differing
+// elements in 4.9 M, scripts/inkling-launch-costs.cu's sibling experiment; the self-test keeps checking it); the clip
+// is the CLIP body with the block size the unfused launch uses for n_head rows (512 threads).
+
+static constexpr int INKLING2_RELTAB_BLOCK = 512;
+static constexpr int INKLING2_RELTAB_MAX_K = 32;
+
+template <bool has_w, bool has_tau>
+static __global__ void __launch_bounds__(INKLING2_RELTAB_BLOCK) inkling2_reltab_f32(const float * x_ptr, const float * w_ptr,
+        const float * tau_ptr, const float * tab_ptr, float * dst_ptr, const int k, const int n_ext, const int64_t w_ne1,
+        const int64_t w_s1, const int64_t tab_s1, const float s0, const float s1, const float c, const float lo, const float hi) {
+    const int h = blockIdx.y; // head
+    __shared__ float shared_vals[32];
+    __shared__ float r[INKLING2_RELTAB_MAX_K];
+
+    ggml_cuda_pdl_lc();
+    ggml_cuda_pdl_sync();
+
+    // Rcur[:, h] = clip(x[:, h] * w[:, h % w_ne1]) (* tau), as the CLIP kernel's block of 512 for these rows
+    inkling2_clip_row<has_w>(x_ptr + h*k, has_w ? w_ptr + (h % w_ne1)*w_s1 : nullptr, r, k, s0, s1, c, lo, hi, shared_vals);
+    __syncthreads();
+    if (has_tau && threadIdx.x < (unsigned) k) {
+        r[threadIdx.x] = r[threadIdx.x]*tau_ptr[0]; // the MUL by the broadcast [1, 1, 1] tau
+    }
+    __syncthreads();
+
+    const int e = blockIdx.x*INKLING2_RELTAB_BLOCK + threadIdx.x;
+    if (e > n_ext) {
+        return;
+    }
+    float acc = 0.0f;
+    if (e < n_ext) {
+        const float * tab = tab_ptr + e*tab_s1;
+        for (int kk = 0; kk < k; ++kk) {
+            acc = fmaf(tab[kk], r[kk], acc);
+        }
+    } else {
+        // the padded row: zeros times r, as the SGEMM computes it
+        for (int kk = 0; kk < k; ++kk) {
+            acc = fmaf(0.0f, r[kk], acc);
+        }
+    }
+    dst_ptr[(int64_t) h*(n_ext + 1) + e] = acc;
+}
+
+// PAD(W) [CLIP of R] [MUL(., tau)] MUL_MAT(pad, Rcur): the run from the PAD to the product
+static bool inkling2_match_reltab(const ggml_cgraph * cgraph, int i, ggml_cuda_inkling2_args & args) {
+    const ggml_tensor * pad = cgraph->nodes[i];
+    if (pad->op != GGML_OP_PAD || i + 10 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * tab = pad->src[0];
+    const int64_t       k   = tab->ne[0];
+    const int64_t       E   = tab->ne[1];
+    // a zero row appended along dim 1 of a constant F32 table
+    if (tab->type != GGML_TYPE_F32 || !inkling2_is_f32_rows(tab) || tab->ne[2] != 1 || tab->ne[3] != 1 || k > INKLING2_RELTAB_MAX_K ||
+            pad->type != GGML_TYPE_F32 || pad->ne[0] != k || pad->ne[1] != E + 1 || pad->ne[2] != 1 || pad->ne[3] != 1 ||
+            ggml_get_op_params_i32(pad, 0) != 0 || ggml_get_op_params_i32(pad, 1) != 0 || ggml_get_op_params_i32(pad, 2) != 0 ||
+            ggml_get_op_params_i32(pad, 3) != 1 || ggml_get_op_params_i32(pad, 4) != 0 || ggml_get_op_params_i32(pad, 5) != 0 ||
+            ggml_get_op_params_i32(pad, 6) != 0 || ggml_get_op_params_i32(pad, 7) != 0 || !inkling2_internal(cgraph, i, 1) ||
+            tab->buffer == nullptr || ggml_backend_buffer_get_usage(tab->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        return false;
+    }
+    // the clip of R right after (views between)
+    const int kc = inkling2_next_node(cgraph, i + 1);
+    ggml_cuda_inkling2_args clip;
+    if (kc >= cgraph->n_nodes || !inkling2_match_clip(cgraph, kc, clip)) {
+        return false;
+    }
+    const ggml_tensor * x    = clip.src[0];
+    const ggml_tensor * w    = clip.src[1];
+    const ggml_tensor * rcur = clip.dst;
+    int km = inkling2_next_node(cgraph, kc + clip.n_nodes);
+    if (km >= cgraph->n_nodes || !inkling2_internal(cgraph, kc + clip.n_nodes - 1, 1)) {
+        return false;
+    }
+    const ggml_tensor * tau = nullptr;
+    if (cgraph->nodes[km]->op == GGML_OP_MUL) {
+        const ggml_tensor * mul = cgraph->nodes[km];
+        if (mul->src[0] != rcur || !inkling2_internal(cgraph, km, 1)) {
+            return false;
+        }
+        tau  = mul->src[1];
+        rcur = mul;
+        km   = inkling2_next_node(cgraph, km + 1);
+        if (km >= cgraph->n_nodes || tau->type != GGML_TYPE_F32 || ggml_nelements(tau) != 1 || !ggml_are_same_shape(mul, clip.dst)) {
+            return false;
+        }
+    }
+    ggml_tensor * dst = cgraph->nodes[km];
+    if (dst->op != GGML_OP_MUL_MAT || dst->src[0] != pad || dst->src[1] != rcur) {
+        return false;
+    }
+    const int64_t n_head = rcur->ne[1];
+    // one token, the tested shape class: rows of k <= 32 floats, n_head <= 32 heads, R contiguous [k, n_head, 1]
+    if (dst->type != GGML_TYPE_F32 || !ggml_is_contiguous(dst) || dst->ne[0] != E + 1 || dst->ne[1] != n_head || dst->ne[2] != 1 ||
+            dst->ne[3] != 1 || rcur->type != GGML_TYPE_F32 || !ggml_is_contiguous(rcur) || rcur->ne[0] != k || rcur->ne[2] != 1 ||
+            rcur->ne[3] != 1 || n_head > 32 || x->ne[0] != k || x->ne[1] != n_head || ggml_nrows(x) != n_head ||
+            (w != nullptr && (w->ne[1] != 1 && w->ne[1] != n_head))) {
+        return false;
+    }
+    // the CLIP replication: the block size sum_rows_f32_cuda picks for n_head rows must be the kernel's
+    const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    if ((n_head / nsm) >= 2 || INKLING2_RELTAB_BLOCK != 512) {
+        return false;
+    }
+    const int n_nodes = km + 1 - i;
+    if (!inkling2_glue_outside(cgraph, i, n_nodes, { x, w, tau, tab }) || inkling2_overlap(dst, x) || (w && inkling2_overlap(dst, w)) ||
+            (tau && inkling2_overlap(dst, tau)) || inkling2_overlap(dst, tab)) {
+        return false;
+    }
+
+    args.type    = GGML_CUDA_INKLING2_RELTAB;
+    args.n_nodes = n_nodes;
+    args.dst     = dst;
+    args.src[0]  = x;
+    args.src[1]  = w;
+    args.src[2]  = tau;
+    args.src[3]  = tab;
+    args.node[0] = clip.node[0]; // SCALE
+    args.node[1] = clip.node[1]; // FILL
+    args.node[2] = clip.node[2]; // CLAMP
+    return true;
+}
+
+static void inkling2_reltab(ggml_backend_cuda_context & ctx, const ggml_cuda_inkling2_args & args) {
+    const ggml_tensor * x   = args.src[0];
+    const ggml_tensor * w   = args.src[1];
+    const ggml_tensor * tau = args.src[2];
+    const ggml_tensor * tab = args.src[3];
+
+    const int k      = (int) tab->ne[0];
+    const int n_ext  = (int) tab->ne[1];
+    const int n_head = (int) x->ne[1];
+
+    const float s0 = ggml_get_op_params_f32(args.node[0], 0);
+    const float s1 = ggml_get_op_params_f32(args.node[0], 1);
+    const float c  = ggml_get_op_params_f32(args.node[1], 0);
+    const float lo = ggml_get_op_params_f32(args.node[2], 0);
+    const float hi = ggml_get_op_params_f32(args.node[2], 1);
+
+    const ggml_cuda_kernel_launch_params params(dim3((n_ext + 1 + INKLING2_RELTAB_BLOCK - 1)/INKLING2_RELTAB_BLOCK, n_head, 1),
+            dim3(INKLING2_RELTAB_BLOCK, 1, 1), 0, ctx.stream());
+    const float * xd   = (const float *) x->data;
+    const float * wd   = w ? (const float *) w->data : nullptr;
+    const float * taud = tau ? (const float *) tau->data : nullptr;
+    const float * td   = (const float *) tab->data;
+    float       * dd   = (float *) args.dst->data;
+    const int64_t w_ne1 = w ? w->ne[1] : 1;
+    const int64_t w_s1  = w ? (int64_t) (w->nb[1]/sizeof(float)) : 0;
+    const int64_t tab_s1 = (int64_t) (tab->nb[1]/sizeof(float));
+    if (w && tau) {
+        ggml_cuda_kernel_launch(inkling2_reltab_f32<true, true>, params, xd, wd, taud, td, dd, k, n_ext, w_ne1, w_s1, tab_s1, s0, s1, c, lo, hi);
+    } else if (w) {
+        ggml_cuda_kernel_launch(inkling2_reltab_f32<true, false>, params, xd, wd, taud, td, dd, k, n_ext, w_ne1, w_s1, tab_s1, s0, s1, c, lo, hi);
+    } else if (tau) {
+        ggml_cuda_kernel_launch(inkling2_reltab_f32<false, true>, params, xd, wd, taud, td, dd, k, n_ext, w_ne1, w_s1, tab_s1, s0, s1, c, lo, hi);
+    } else {
+        ggml_cuda_kernel_launch(inkling2_reltab_f32<false, false>, params, xd, wd, taud, td, dd, k, n_ext, w_ne1, w_s1, tab_s1, s0, s1, c, lo, hi);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// QKV (LLAMA_INKLING_MK_QKV): the Q/K/V epilogue of one token's attention as one kernel, one block of 512 threads per
+// head: Q head: clip(x*w) [* tau] -> Hadamard rotation -> f32 for the attention; K head: clip(x) -> rotation -> q8_0
+// into the K cache row of the token; V head: rms_norm(x) -> rotation of the two 64-halves -> q8_0 into the V cache row.
+// Replaces CLIP(Q), FWHT(Q), CLIP(K), FWHT(K), RMS_NORM(V), FWHT(V), SET_ROWS(K), SET_ROWS(V): 8 launches -> 1. Every
+// phase is the body of the kernel it replaces: the CLIP body at the block size of the unfused launch (512 for these row
+// counts), rms_norm_f32's 32-thread float4 variant, fwht_cuda's warp butterfly (N/32 values per lane, the scale at the
+// load), quantize_f32_q8_0_block per 32 values; the same operations in the same order, so the same bits.
+
+static constexpr int INKLING2_QKV_BLOCK = 512;
+static constexpr int INKLING2_QKV_D     = 128; // the head width (the K/Q rotation), the V rotation is over halves of 64
+
+struct inkling2_qkv_args {
+    const float * xq;  const float * wq; int64_t wq_s1; int64_t wq_ne1; const float * tau; float * dq;
+    float q_s0, q_s1, q_c, q_lo, q_hi;
+    const float * xk;  float k_s0, k_s1, k_c, k_lo, k_hi;  char * ck; int64_t ck_s1; const void * idx_k;
+    const float * xv;  float v_eps;                        char * cv; int64_t cv_s1; const void * idx_v;
+    bool  idx_i64;
+    int   n_head, n_kv;
+    float scale_q, scale_k, scale_v; // the FWHT scales 1/sqrt(N)
+    bool  debug;
+};
+
+// the warp butterfly of fwht_cuda<N>: lane holds reg[i] = x[i*32 + lane]*scale on entry, the transform on exit
+template <int N>
+static __device__ __forceinline__ void inkling2_fwht_warp(float * reg, const int lane) {
+    constexpr int el_w = N / WARP_SIZE;
+#pragma unroll
+    for (int h = 1; h < WARP_SIZE; h *= 2) {
+#pragma unroll
+        for (int j = 0; j < el_w; j++) {
+            const float val  = reg[j];
+            const float val2 = ggml_cuda_shfl_xor(val, h, WARP_SIZE);
+            reg[j] = (lane & h) == 0 ? val + val2 : val2 - val;
+        }
+    }
+#pragma unroll
+    for (int h = WARP_SIZE; h < N; h *= 2) {
+        const int step = h / WARP_SIZE;
+#pragma unroll
+        for (int j = 0; j < el_w; j += 2 * step) {
+#pragma unroll
+            for (int k = 0; k < step; k++) {
+                const float x = reg[j + k];
+                const float y = reg[j + k + step];
+                reg[j + k]        = x + y;
+                reg[j + k + step] = x - y;
+            }
+        }
+    }
+}
+
+static __device__ __forceinline__ int64_t inkling2_qkv_row(const void * idx, const bool i64) {
+    if (idx == nullptr) {
+        return 0; // the shadow run of MK_CHECK writes row 0 of its scratch
+    }
+    return i64 ? (int64_t) ((const int64_t *) idx)[0] : (int64_t) ((const int32_t *) idx)[0];
+}
+
+static __global__ void __launch_bounds__(INKLING2_QKV_BLOCK) inkling2_qkv_f32(const __grid_constant__ inkling2_qkv_args args) {
+    constexpr int D = INKLING2_QKV_D;
+    __shared__ float shared_vals[32];
+    __shared__ __align__(16) float s_r[D];
+    __shared__ __align__(16) float s_o[D];
+    const int tid  = threadIdx.x;
+    const int lane = tid % WARP_SIZE;
+    const int warp = tid / WARP_SIZE;
+    const int b    = blockIdx.x;
+
+    if (args.debug && (args.n_head < 1 || args.n_kv < 1 || (int) gridDim.x != args.n_head + 2*args.n_kv || args.xq == nullptr ||
+            args.dq == nullptr || args.xk == nullptr || args.xv == nullptr || args.ck == nullptr || args.cv == nullptr ||
+            (uintptr_t) args.xv % 16 != 0 || blockDim.x != INKLING2_QKV_BLOCK)) {
+        if (tid == 0) {
+            printf("inkling2 qkv: bad arguments at block %d (heads %d, kv %d, grid %u)\n", b, args.n_head, args.n_kv, gridDim.x);
+        }
+        return;
+    }
+
+    if (b < args.n_head) {
+        // Q: clip with the per-head weight, the tau multiply, the rotation to f32
+        const int h = b;
+        inkling2_clip_row<true>(args.xq + h*D, args.wq + (h % args.wq_ne1)*args.wq_s1, s_r, D, args.q_s0, args.q_s1, args.q_c, args.q_lo, args.q_hi, shared_vals);
+        __syncthreads();
+        if (args.tau != nullptr && tid < D) {
+            s_r[tid] = s_r[tid]*args.tau[0];
+        }
+        __syncthreads();
+        if (warp == 0) {
+            float reg[D/WARP_SIZE];
+#pragma unroll
+            for (int i = 0; i < D/WARP_SIZE; ++i) {
+                reg[i] = s_r[i*WARP_SIZE + lane]*args.scale_q;
+            }
+            inkling2_fwht_warp<D>(reg, lane);
+#pragma unroll
+            for (int i = 0; i < D/WARP_SIZE; ++i) {
+                args.dq[h*D + i*WARP_SIZE + lane] = reg[i];
+            }
+        }
+        return;
+    }
+
+    if (b < args.n_head + args.n_kv) {
+        // K: clip without weight, the rotation, the q8_0 blocks of the cache row
+        const int h = b - args.n_head;
+        inkling2_clip_row<false>(args.xk + h*D, nullptr, s_r, D, args.k_s0, args.k_s1, args.k_c, args.k_lo, args.k_hi, shared_vals);
+        __syncthreads();
+        if (warp == 0) {
+            float reg[D/WARP_SIZE];
+#pragma unroll
+            for (int i = 0; i < D/WARP_SIZE; ++i) {
+                reg[i] = s_r[i*WARP_SIZE + lane]*args.scale_k;
+            }
+            inkling2_fwht_warp<D>(reg, lane);
+#pragma unroll
+            for (int i = 0; i < D/WARP_SIZE; ++i) {
+                s_o[i*WARP_SIZE + lane] = reg[i];
+            }
+        }
+        __syncthreads();
+        if (tid < D/QK8_0) {
+            block_q8_0 * row = (block_q8_0 *) (args.ck + inkling2_qkv_row(args.idx_k, args.idx_i64)*args.ck_s1);
+            quantize_f32_q8_0_block(s_o + tid*QK8_0, row + (h*D)/QK8_0 + tid);
+        }
+        return;
+    }
+
+    // V: rms_norm (the 32-thread float4 variant), the rotation of each 64-half, the q8_0 blocks of the cache row
+    const int h = b - args.n_head - args.n_kv;
+    if (warp == 0) {
+        const float4 xs = ((const float4 *) (args.xv + h*D))[lane];
+        float tmp = xs.x*xs.x + xs.y*xs.y + xs.z*xs.z + xs.w*xs.w;
+        tmp = warp_reduce_sum(tmp);
+        const float scale = rsqrtf(tmp / D + args.v_eps);
+        ((float4 *) s_r)[lane] = make_float4(scale*xs.x, scale*xs.y, scale*xs.z, scale*xs.w);
+    }
+    __syncthreads();
+    if (warp < 2) {
+        constexpr int H = D/2;
+        float reg[H/WARP_SIZE];
+#pragma unroll
+        for (int i = 0; i < H/WARP_SIZE; ++i) {
+            reg[i] = s_r[warp*H + i*WARP_SIZE + lane]*args.scale_v;
+        }
+        inkling2_fwht_warp<H>(reg, lane);
+#pragma unroll
+        for (int i = 0; i < H/WARP_SIZE; ++i) {
+            s_o[warp*H + i*WARP_SIZE + lane] = reg[i];
+        }
+    }
+    __syncthreads();
+    if (tid < D/QK8_0) {
+        block_q8_0 * row = (block_q8_0 *) (args.cv + inkling2_qkv_row(args.idx_v, args.idx_i64)*args.cv_s1);
+        quantize_f32_q8_0_block(s_o + tid*QK8_0, row + (h*D)/QK8_0 + tid);
+    }
+}
+
+// the rotation product: MUL_MAT with the Hadamard hint whose src1 is a reshape of `in` (n values per row)
+static bool inkling2_is_rotation(const ggml_tensor * t, const ggml_tensor * in, int64_t n) {
+    if (t->op != GGML_OP_MUL_MAT || ggml_get_op_params_i32(t, 1) != GGML_HINT_SRC0_IS_HADAMARD || t->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(t) || t->ne[0] != n || t->ne[2] != 1 || t->ne[3] != 1) {
+        return false;
+    }
+    const ggml_tensor * rot = t->src[0];
+    const ggml_tensor * b   = t->src[1];
+    const ggml_tensor * root = b;
+    while (root->view_src != nullptr) {
+        root = root->view_src;
+    }
+    return rot->type == GGML_TYPE_F32 && rot->ne[0] == n && b->type == GGML_TYPE_F32 && ggml_is_contiguous(b) &&
+           b->ne[0] == n && b->ne[2] == 1 && b->ne[3] == 1 && (b == in || (root == in && b->view_offs == 0)) &&
+           ggml_nelements(b) == ggml_nelements(in) && ggml_nelements(t) == ggml_nelements(in);
+}
+
+// SET_ROWS of one token's row into a q8_0 cache: src0 = a view of `in` (all of it), src1 the row index, dst the cache view
+static bool inkling2_is_cache_store(const ggml_tensor * t, const ggml_tensor * in, bool & i64) {
+    if (t->op != GGML_OP_SET_ROWS || t->type != GGML_TYPE_Q8_0) {
+        return false;
+    }
+    const ggml_tensor * src = t->src[0];
+    const ggml_tensor * idx = t->src[1];
+    const ggml_tensor * root = src;
+    while (root->view_src != nullptr) {
+        root = root->view_src;
+    }
+    i64 = idx->type == GGML_TYPE_I64;
+    return (idx->type == GGML_TYPE_I64 || idx->type == GGML_TYPE_I32) && ggml_nelements(idx) == 1 && src->type == GGML_TYPE_F32 &&
