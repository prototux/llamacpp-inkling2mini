 }
+
+
+// ---------------------------------------------------------------------------------------------------------------------
+// LLAMA_INKLING_MK_PROJ: several one-token matrix-vector products in one launch (see mmvq.cuh)
+
+struct mmvq_multi_args {
+    int n;
+    bool debug;
+    const void       * vx[MMVQ_MULTI_MAX];
+    const block_q8_1 * vy[MMVQ_MULTI_MAX];
+    float            * dst[MMVQ_MULTI_MAX];
+    int nrows[MMVQ_MULTI_MAX];
+    int ncols_x[MMVQ_MULTI_MAX];
+    int stride_row_x[MMVQ_MULTI_MAX]; // in blocks
+};
+
+// blockIdx.y: the matrix; blockIdx.x: its row block. The body is the ncols_dst == 1, no-fusion body of mul_mat_vec_q,
+// with the same thread-to-block mapping, accumulation order and reductions.
+template <ggml_type type, bool small_k>
+__launch_bounds__(calc_nwarps(type, 1, get_device_table_id(), small_k, false)*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_multi(const mmvq_multi_args args) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int nwarps = calc_nwarps(type, 1, table_id, small_k, false);
+    constexpr int rows_per_cuda_block = calc_rows_per_block(type, 1, table_id, small_k, nwarps);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int m = blockIdx.y;
+    if (args.debug && (m >= args.n || args.vx[m] == nullptr || args.vy[m] == nullptr || args.dst[m] == nullptr ||
+            args.ncols_x[m] % qk != 0 || args.nrows[m] <= 0)) {
+        if (threadIdx.x == 0 && threadIdx.y == 0) {
+            printf("mul_mat_vec_q_multi: bad matrix %d of %d at block (%u, %u): nrows %d ncols %d\n",
+                   m, args.n, blockIdx.x, blockIdx.y, args.nrows[m], args.ncols_x[m]);
+        }
+        return;
+    }
+    const int nrows = args.nrows[m];
+    const int row0  = rows_per_cuda_block*blockIdx.x;
+    if (row0 >= nrows) {
+        return; // a shorter matrix than the grid, uniform for the block
+    }
+    const void       * GGML_CUDA_RESTRICT vx = args.vx[m];
+    const block_q8_1 * GGML_CUDA_RESTRICT y  = args.vy[m];
+    float            * GGML_CUDA_RESTRICT dst = args.dst[m];
+    const int blocks_per_row_x = args.ncols_x[m] / qk;
+    const int stride_row_x     = args.stride_row_x[m];
+
+    const     int tid = warp_size*threadIdx.y + threadIdx.x;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    float tmp[rows_per_cuda_block] = {0.0f};
+    const int kbx_offset = row0*stride_row_x;
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+        for (int i = 0; i < rows_per_cuda_block; ++i) {
+            tmp[i] += vec_dot_q_cuda(vx, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][rows_per_cuda_block][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int i = 0; i < rows_per_cuda_block; ++i) {
+            tmp_shared[threadIdx.y-1][i][threadIdx.x] = tmp[i];
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+    dst += row0;
+#pragma unroll
+    for (int i = 0; i < rows_per_cuda_block; ++i) {
+#pragma unroll
+        for (int l = 0; l < nwarps-1; ++l) {
+            tmp[i] += tmp_shared[l][i][threadIdx.x];
+        }
+        tmp[i] = warp_reduce_sum<warp_size>(tmp[i]);
+        if (threadIdx.x == i && (rows_per_cuda_block == 1 || row0 + i < nrows)) {
+            dst[i] = tmp[i];
+        }
+    }
+}
+
+template <ggml_type type>
+static void mul_mat_vec_q_multi_launch(const mmvq_multi_args & args, bool small_k, int max_nrows, cudaStream_t stream) {
+    const int device = ggml_cuda_get_device();
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(ggml_cuda_info().devices[device].cc);
+    const int nwarps = calc_nwarps(type, 1, table_id, small_k, false);
+    const int rpb    = calc_rows_per_block(type, 1, table_id, small_k, nwarps);
+    const dim3 block_nums((max_nrows + rpb - 1)/rpb, args.n, 1);
+    const dim3 block_dims(warp_size, nwarps, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+    if (small_k) {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_multi<type, true>, launch_params, args);
+    } else {
+        ggml_cuda_kernel_launch(mul_mat_vec_q_multi<type, false>, launch_params, args);
+    }
+}
+
+// the same decision as mul_mat_vec_q_switch_ncols_dst for ncols_dst == 1 (halve_iters is GB10-only, never here)
+template <ggml_type type>
+static bool mul_mat_vec_q_multi_small_k(int ncols_x, int cc) {
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(cc);
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    const int blocks_per_row_x      = ncols_x / qk;
+    const int blocks_per_iter_1warp = vdr * warp_size / qi;
+    const int nwarps = calc_nwarps(type, 1, table_id);
+    bool use = nwarps > 1 && blocks_per_row_x < nwarps * blocks_per_iter_1warp;
+    const bool is_nvidia_turing_plus  = GGML_CUDA_CC_IS_NVIDIA(cc) && cc >= GGML_CUDA_CC_TURING;
+    const bool is_nvidia_pascal_older = GGML_CUDA_CC_IS_NVIDIA(cc) && cc < GGML_CUDA_CC_VOLTA;
+    if (is_nvidia_turing_plus) {
+        if (type == GGML_TYPE_IQ3_XXS || type == GGML_TYPE_IQ3_S) {
+            use = false;
+        }
+    } else if (type == GGML_TYPE_IQ1_S || type == GGML_TYPE_IQ1_M || type == GGML_TYPE_IQ2_XXS || type == GGML_TYPE_IQ2_XS ||
+            type == GGML_TYPE_IQ2_S || type == GGML_TYPE_IQ3_XXS || type == GGML_TYPE_IQ3_S || type == GGML_TYPE_IQ4_XS ||
+            (is_nvidia_pascal_older && (type == GGML_TYPE_IQ3_S || type == GGML_TYPE_Q2_K || type == GGML_TYPE_Q3_K)) ||
+            GGML_CUDA_CC_IS_RDNA(cc)) {
+        use = false;
+    }
+    return use;
+}
+
+bool ggml_cuda_mul_mat_vec_q_multi_supported(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_IQ4_NL:
+            return true;
+        default:
+            return false;
+    }
+}
+
+void ggml_cuda_mul_mat_vec_q_multi(ggml_backend_cuda_context & ctx, int n,
+        const ggml_tensor * const * src0, const ggml_tensor * const * src1, ggml_tensor * const * dst, bool debug) {
+    GGML_ASSERT(n >= 1 && n <= MMVQ_MULTI_MAX);
+    cudaStream_t stream = ctx.stream();
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+
+    // each distinct input quantized once, as ggml_cuda_mul_mat_vec_q does it, into slices of ONE pool buffer:
+    // the CUDA pool frees in LIFO order, several live allocations destroyed in vector order would break it
+    int    first[MMVQ_MULTI_MAX];  // the first product with the same input
+    size_t offs [MMVQ_MULTI_MAX] = {};
+    size_t total = 0;
+    for (int i = 0; i < n; ++i) {
+        const ggml_tensor * x = src1[i];
+        GGML_ASSERT(x->type == GGML_TYPE_F32 && x->ne[1] == 1 && x->ne[2] == 1 && x->ne[3] == 1);
+        GGML_ASSERT(x->nb[0] == sizeof(float));
+        first[i] = i;
+        for (int j = 0; j < i; ++j) {
+            if (src1[j] == x) {
+                first[i] = first[j];
+                break;
+            }
+        }
+        if (first[i] == i) {
+            const int64_t ne10_padded = GGML_PAD(x->ne[0], MATRIX_ROW_PADDING);
+            offs[i] = total;
+            total  += GGML_PAD(ne10_padded*sizeof(block_q8_1)/QK8_1, 256);
+        }
+    }
+    ggml_cuda_pool_alloc<char> q8(ctx.pool(), total);
+    const block_q8_1 * vy[MMVQ_MULTI_MAX] = {};
+    for (int i = 0; i < n; ++i) {
+        if (first[i] != i) {
+            vy[i] = vy[first[i]];
+            continue;
+        }
+        const ggml_tensor * x = src1[i];
+        const int64_t ne10        = x->ne[0];
+        const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+        char * q8_i = q8.get() + offs[i];
+        quantize_row_q8_1_cuda((const float *) x->data, q8_i, ne10, x->nb[1]/sizeof(float), x->nb[2]/sizeof(float),
+                x->nb[3]/sizeof(float), ne10_padded, 1, 1, 1, stream);
+        vy[i] = (const block_q8_1 *) q8_i;
+    }
+
+    // one launch per (type, small_k) group
+    bool done[MMVQ_MULTI_MAX] = {};
+    for (int i = 0; i < n; ++i) {
+        if (done[i]) {
+            continue;
+        }
+        const ggml_type type = src0[i]->type;
+        GGML_ASSERT(ggml_cuda_mul_mat_vec_q_multi_supported(type));
+        const auto small_k_of = [&](int ncols) {
+            switch (type) {
+                case GGML_TYPE_Q4_0:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q4_0>(ncols, cc);
+                case GGML_TYPE_Q5_0:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q5_0>(ncols, cc);
+                case GGML_TYPE_Q8_0:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q8_0>(ncols, cc);
+                case GGML_TYPE_Q3_K:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q3_K>(ncols, cc);
+                case GGML_TYPE_Q4_K:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q4_K>(ncols, cc);
+                case GGML_TYPE_Q5_K:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q5_K>(ncols, cc);
+                case GGML_TYPE_Q6_K:   return mul_mat_vec_q_multi_small_k<GGML_TYPE_Q6_K>(ncols, cc);
+                case GGML_TYPE_IQ4_XS: return mul_mat_vec_q_multi_small_k<GGML_TYPE_IQ4_XS>(ncols, cc);
+                case GGML_TYPE_IQ4_NL: return mul_mat_vec_q_multi_small_k<GGML_TYPE_IQ4_NL>(ncols, cc);
+                default: GGML_ABORT("fatal error");
+            }
+        };
+        const bool small_k = small_k_of(src0[i]->ne[0]);
+        mmvq_multi_args args = {};
+        args.debug = debug;
+        int max_nrows = 0;
+        for (int j = i; j < n; ++j) {
+            if (done[j] || src0[j]->type != type || small_k_of(src0[j]->ne[0]) != small_k) {
+                continue;
+            }
+            const ggml_tensor * w = src0[j];
+            GGML_ASSERT(w->ne[2] == 1 && w->ne[3] == 1 && w->nb[0] == ggml_type_size(type) && w->ne[0] % ggml_blck_size(type) == 0);
+            GGML_ASSERT(w->ne[0] == src1[j]->ne[0] && dst[j]->type == GGML_TYPE_F32 && dst[j]->nb[0] == sizeof(float));
+            GGML_ASSERT(dst[j]->ne[0] == w->ne[1] && dst[j]->ne[1] == 1 && dst[j]->ne[2] == 1 && dst[j]->ne[3] == 1);
+            const int k = args.n++;
+            args.vx[k]           = w->data;
+            args.vy[k]           = vy[j];
+            args.dst[k]          = (float *) dst[j]->data;
+            args.nrows[k]        = (int) w->ne[1];
+            args.ncols_x[k]      = (int) w->ne[0];
+            args.stride_row_x[k] = (int) (w->nb[1] / ggml_type_size(type));
+            max_nrows = std::max(max_nrows, args.nrows[k]);
+            done[j] = true;
+        }
+        switch (type) {
+            case GGML_TYPE_Q4_0:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q4_0>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q5_0:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q5_0>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q8_0:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q8_0>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q3_K:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q3_K>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q4_K:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q4_K>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q5_K:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q5_K>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_Q6_K:   mul_mat_vec_q_multi_launch<GGML_TYPE_Q6_K>  (args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_IQ4_XS: mul_mat_vec_q_multi_launch<GGML_TYPE_IQ4_XS>(args, small_k, max_nrows, stream); break;
+            case GGML_TYPE_IQ4_NL: mul_mat_vec_q_multi_launch<GGML_TYPE_IQ4_NL>(args, small_k, max_nrows, stream); break;
+            default: GGML_ABORT("fatal error");
+        }
+    }
+}
