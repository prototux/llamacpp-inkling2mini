+    // 2. streams, 3. waits and windows
+    std::vector<int>  stream(n, 0);
+    std::vector<int>  remaining(n_consumers);  // consumers not assigned yet
+    std::vector<int>  pending(n_side + 1, 0);  // per side stream: its nodes with remaining consumers
+    std::vector<int>  tail(n_side + 1, -1);    // last node of each stream
+    std::vector<std::pair<int, int>> windows;  // [first, last] compute index
+    int window_first = -1;
+    int window_mask  = 0;
+    int n_waits = 0;
+
+    for (int k = 0; k < n; ++k) {
+        const ggml_tensor * node = cgraph->nodes[cn[k]];
+        const std::vector<int> & p = preds[k];
+
+        int chosen = -1;
+        // continue the chain of a predecessor that is still the tail of its stream, the main stream first
+        for (int pass = 0; pass < 2 && chosen < 0; ++pass) {
+            for (int j : p) {
+                if (tail[stream[j]] == j && (pass == 1 || stream[j] == 0)) {
+                    chosen = stream[j];
+                    break;
+                }
+            }
+        }
+        // a sibling projection: a free side stream
+        if (chosen < 0 && !p.empty() && (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID)) {
+            for (int s = 1; s <= n_side; ++s) {
