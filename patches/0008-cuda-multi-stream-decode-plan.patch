@@ -0,0 +1,15 @@
+#pragma once
+
+#include "common.cuh"
+
+// LLAMA_INKLING_GEMV=1 (default off): one-token matrix-vector products over the Q8_0 and Q6_K weights of
+// Inkling 2 Mini's attention projections (2304- and 3072-wide rows) with mul_mat_vec_q's own thread mapping and
