+// ---------------------------------------------------------------------------------------------------------------------
+// LLAMA_INKLING_MK_CHECK=1: shadow comparison of every megakernel stage against the unfused path, in the real graph.
+// A stage that would fuse runs its kernels into a shadow buffer and then declines the fusion, so the unfused nodes run
+// and the model's output is the unfused one; when the evaluation has passed the run, both results are compared
+// bit-for-bit on the host and every mismatch is printed with the evaluation number, the stage, the tensor and the first
+// differing element (=2 also prints every OK instance). Needs the CUDA graphs off (GGML_CUDA_DISABLE_GRAPHS=1): the
+// comparison synchronizes the stream. If the model still loops with this on, the loop is not in a fused kernel.
+static int ggml_cuda_mk_check_mode() {
+    static const int mode = [] {
+        const char * env = getenv("LLAMA_INKLING_MK_CHECK");
+        return env ? atoi(env) : 0;
+    }();
+    return mode;
+}
+
+struct ggml_cuda_mk_check_out {
+    char      name[GGML_MAX_NAME];
+    const ggml_tensor * t;       // the unfused output (its data is read after the run executed)
+    void    * shadow;            // the fused output
+    size_t    nbytes;
+    void    * q8;                // optional: the fused q8_1 of the output (glue), compared with the quantization of t
+    size_t    q8_nbytes;
+    const void * ref_ptr = nullptr; // optional: the unfused bytes live here instead of t->data (a cache row)
+    bool      raw = false;          // compare bytes only (quantized rows)
+};
+
+struct ggml_cuda_mk_check_pending {
+    const char * stage;
+    int          end;            // the raw index of the last node of the run: compared when the evaluation passed it
+    int          n;
+    ggml_cuda_mk_check_out outs[MMVQ_MULTI_MAX];
+};
+
+struct ggml_cuda_mk_check_state {
+    std::vector<ggml_cuda_mk_check_pending> pendings;
+    int    skip_upstream_at = -1; // the node where a declined stage's chain starts: upstream's fusion of it must not match
+    char * arena      = nullptr; // one allocation for the shadows, bump-allocated per pending, reset when none is pending
+    size_t arena_size = 0;
+    size_t arena_used = 0;
+    int    eval       = 0;       // evaluations seen
+    long   n_checked  = 0;
+    long   n_bad      = 0;
+    bool   warned_capture = false;
+};
+
+static ggml_cuda_mk_check_state & ggml_cuda_mk_check() {
+    static ggml_cuda_mk_check_state st;
+    return st;
+}
+
+// a shadow buffer of nbytes (16-byte aligned), or nullptr when the arena is exhausted (the stage then runs unfused only)
+static void * ggml_cuda_mk_check_alloc(size_t nbytes) {
+    ggml_cuda_mk_check_state & st = ggml_cuda_mk_check();
+    if (st.arena == nullptr) {
+        st.arena_size = 64u << 20;
+        CUDA_CHECK(cudaMalloc(&st.arena, st.arena_size));
+    }
+    nbytes = GGML_PAD(nbytes, 256);
+    if (st.arena_used + nbytes > st.arena_size) {
+        return nullptr;
+    }
+    void * p = st.arena + st.arena_used;
+    st.arena_used += nbytes;
+    return p;
+}
+
+// true when a stage may run its shadow now (check mode on, not inside a CUDA graph capture)
+static bool ggml_cuda_mk_check_active(ggml_backend_cuda_context & ctx) {
+    if (ggml_cuda_mk_check_mode() == 0) {
+        return false;
+    }
+    cudaStreamCaptureStatus status = cudaStreamCaptureStatusNone;
+    CUDA_CHECK(cudaStreamIsCapturing(ctx.stream(), &status));
+    if (status != cudaStreamCaptureStatusNone) {
+        ggml_cuda_mk_check_state & st = ggml_cuda_mk_check();
+        if (!st.warned_capture) {
+            st.warned_capture = true;
+            GGML_LOG_WARN("mk_check: a CUDA graph is being captured, the stages are not checked in this graph; run with GGML_CUDA_DISABLE_GRAPHS=1\n");
+        }
+        return false;
+    }
+    return true;
+}
+
+static void ggml_cuda_mk_check_add(const char * stage, int end, int n, const ggml_tensor * const * outs, void * const * shadows,
+        void * const * q8s, size_t q8_nbytes) {
+    ggml_cuda_mk_check_state & st = ggml_cuda_mk_check();
+    ggml_cuda_mk_check_pending p = {};
+    p.stage = stage;
+    p.end   = end;
+    p.n     = n;
+    for (int k = 0; k < n; ++k) {
+        snprintf(p.outs[k].name, sizeof(p.outs[k].name), "%s", outs[k]->name);
+        p.outs[k].t         = outs[k];
+        p.outs[k].shadow    = shadows[k];
+        p.outs[k].nbytes    = ggml_nbytes(outs[k]);
+        p.outs[k].q8        = q8s != nullptr ? q8s[k] : nullptr;
+        p.outs[k].q8_nbytes = q8s != nullptr ? q8_nbytes : 0;
+    }
+    st.pendings.push_back(p);
+}
+
+// compare the pendings whose run the evaluation has passed (i: the raw index about to be evaluated; -1: all)
+static void ggml_cuda_mk_check_flush(ggml_backend_cuda_context & ctx, int i) {
+    ggml_cuda_mk_check_state & st = ggml_cuda_mk_check();
+    if (st.pendings.empty()) {
+        return;
+    }
+    bool synced = false;
+    std::vector<ggml_cuda_mk_check_pending> keep;
+    for (const ggml_cuda_mk_check_pending & p : st.pendings) {
+        if (i >= 0 && i <= p.end) {
+            keep.push_back(p);
+            continue;
+        }
+        if (!synced) {
+            CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+            synced = true;
+        }
+        for (int k = 0; k < p.n; ++k) {
+            const ggml_cuda_mk_check_out & o = p.outs[k];
+            std::vector<char> ref(o.nbytes), fused(o.nbytes);
+            CUDA_CHECK(cudaMemcpy(ref.data(), o.ref_ptr != nullptr ? o.ref_ptr : o.t->data, o.nbytes, cudaMemcpyDeviceToHost));
+            CUDA_CHECK(cudaMemcpy(fused.data(), o.shadow, o.nbytes, cudaMemcpyDeviceToHost));
+            st.n_checked++;
+            bool ok = true;
+            if (o.raw) {
+                if (memcmp(ref.data(), fused.data(), o.nbytes) != 0) {
+                    ok = false;
+                    size_t first = 0;
+                    while (first < o.nbytes && ref[first] == fused[first]) {
+                        first++;
+                    }
+                    GGML_LOG_INFO("mk_check: eval %d %s %s MISMATCH (raw): first byte %zu of %zu, unfused %d fused %d\n",
+                            st.eval, p.stage, o.name, first, o.nbytes, (int) ref[first], (int) fused[first]);
+                }
+            } else if (memcmp(ref.data(), fused.data(), o.nbytes) != 0) {
+                ok = false;
+                const size_t n_el = o.nbytes/sizeof(float);
+                const float * a = (const float *) ref.data();
+                const float * b = (const float *) fused.data();
+                size_t first = 0, n_diff = 0;
+                double max_abs = 0.0;
+                for (size_t e = 0; e < n_el; ++e) {
+                    if (a[e] != b[e] || std::isnan(b[e])) {
+                        if (n_diff == 0) {
+                            first = e;
+                        }
+                        n_diff++;
+                        max_abs = std::max(max_abs, (double) fabs((double) a[e] - (double) b[e]));
+                    }
+                }
+                GGML_LOG_INFO("mk_check: eval %d %s %s MISMATCH: %zu of %zu elements differ, max abs %.3g, first [%zu] unfused %.9g fused %.9g\n",
+                        st.eval, p.stage, o.name, n_diff, n_el, max_abs, first, a[first], b[first]);
+            }
+            if (o.q8 != nullptr) {
+                // the fused q8_1 against the quantization of the unfused output
+                std::vector<char> q8_fused(o.q8_nbytes), q8_ref(o.q8_nbytes);
+                void * q8_tmp = ggml_cuda_mk_check_alloc(o.q8_nbytes);
+                if (q8_tmp != nullptr) {
+                    const int64_t ne0 = o.t->ne[0];
+                    quantize_row_q8_1_cuda((const float *) o.t->data, q8_tmp, ne0, ne0, ne0, ne0, GGML_PAD(ne0, MATRIX_ROW_PADDING), 1, 1, 1, ctx.stream());
+                    CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+                    CUDA_CHECK(cudaMemcpy(q8_ref.data(), q8_tmp, o.q8_nbytes, cudaMemcpyDeviceToHost));
+                    CUDA_CHECK(cudaMemcpy(q8_fused.data(), o.q8, o.q8_nbytes, cudaMemcpyDeviceToHost));
+                    if (memcmp(q8_ref.data(), q8_fused.data(), o.q8_nbytes) != 0) {
+                        ok = false;
+                        size_t first = 0;
+                        while (first < o.q8_nbytes && q8_ref[first] == q8_fused[first]) {
+                            first++;
+                        }
+                        GGML_LOG_INFO("mk_check: eval %d %s %s q8_1 MISMATCH: first byte %zu (block %zu offset %zu) unfused %d fused %d\n",
+                                st.eval, p.stage, o.name, first, first/sizeof(block_q8_1), first%sizeof(block_q8_1), (int) q8_ref[first], (int) q8_fused[first]);
+                        const block_q8_1 * br = (const block_q8_1 *) q8_ref.data() + first/sizeof(block_q8_1);
+                        const block_q8_1 * bf = (const block_q8_1 *) q8_fused.data() + first/sizeof(block_q8_1);
+                        GGML_LOG_INFO("mk_check:   block %zu unfused d %.6g s %.6g qs %d %d %d %d | fused d %.6g s %.6g qs %d %d %d %d | x[0..3] %.6g %.6g %.6g %.6g\n",
+                                first/sizeof(block_q8_1), __half2float(br->ds.x), __half2float(br->ds.y), br->qs[0], br->qs[1], br->qs[2], br->qs[3],
+                                __half2float(bf->ds.x), __half2float(bf->ds.y), bf->qs[0], bf->qs[1], bf->qs[2], bf->qs[3],
+                                ((const float *) ref.data())[0], ((const float *) ref.data())[1], ((const float *) ref.data())[2], ((const float *) ref.data())[3]);
+                    }
+                }
+            }
+            st.n_bad += !ok;
+            if (ok && ggml_cuda_mk_check_mode() >= 2) {
+                GGML_LOG_INFO("mk_check: eval %d %s %s OK\n", st.eval, p.stage, o.name);
+            }
+        }
+    }
+    st.pendings.swap(keep);
+    if (st.pendings.empty()) {
+        st.arena_used = 0;
+    }
+}
+
+// the end of an evaluation: compare what is left, count the evaluation, print a summary every 50 evaluations
+static void ggml_cuda_mk_check_end_eval(ggml_backend_cuda_context & ctx) {
+    if (ggml_cuda_mk_check_mode() == 0) {
+        return;
+    }
+    ggml_cuda_mk_check_flush(ctx, -1);
+    ggml_cuda_mk_check_state & st = ggml_cuda_mk_check();
+    st.eval++;
+    if (st.eval % 50 == 0 || (st.n_bad > 0 && st.eval <= 5)) {
+        GGML_LOG_INFO("mk_check: %d evaluations, %ld stage outputs compared, %ld mismatching\n", st.eval, st.n_checked, st.n_bad);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// LLAMA_INKLING_MK_PROFILE=1: the time of one evaluation by op class, from cudaEvents around every launched node or
+// fused group (CUDA graphs off: GGML_CUDA_DISABLE_GRAPHS=1). Printed every 50 evaluations of graphs with >= 100 nodes
+// (the decode graphs), with the host wall time of the evaluation loop: the gap between the two is launch overhead.
+static bool ggml_cuda_mk_profile_mode() {
+    static const bool enabled = getenv("LLAMA_INKLING_MK_PROFILE") != nullptr;
+    return enabled;
+}
+
+enum ggml_cuda_mk_class {
+    MK_CLASS_MOE,       // MUL_MAT_ID (expert products)
+    MK_CLASS_ATTN,      // FLASH_ATTN_EXT
+    MK_CLASS_PROJ,      // quantized MUL_MAT (projections, lm_head, fused runs)
+    MK_CLASS_SMALL_MM,  // f32/f16/bf16 MUL_MAT (controllers, sinks, conv taps, router, mix)
+    MK_CLASS_GLUE,      // fused groups from RMS_NORM with more than 2 nodes (glue, ctrl, mix) and CONCAT groups
+    MK_CLASS_NORM,      // RMS_NORM (+ MUL)
+    MK_CLASS_CONV,      // SSM_CONV and the conv fusions
+    MK_CLASS_ROUTER,    // SOFT_MAX, ARGSORT, SUM_ROWS, top-k chains
+    MK_CLASS_COPY,      // GET_ROWS, CPY, SET_ROWS, CONT
+    MK_CLASS_ELEM,      // elementwise
+    MK_CLASS_OTHER,
+    MK_CLASS_COUNT,
+};
+
+static const char * ggml_cuda_mk_class_name(int c) {
+    static const char * names[MK_CLASS_COUNT] = { "moe experts (mul_mat_id)", "attention (flash_attn)", "quantized mul_mat (proj, lm_head)",
+        "f32/bf16 mul_mat (ctrl, sinks, taps, router, mix)", "fused glue/ctrl/mix groups", "norms", "convs", "router/top-k",
+        "copies (get_rows, cpy, set_rows, cont)", "elementwise", "other" };
+    return names[c];
+}
+
+static int ggml_cuda_mk_classify(const ggml_tensor * node, int n_fused) {
+    switch (node->op) {
+        case GGML_OP_MUL_MAT_ID:     return MK_CLASS_MOE;
+        case GGML_OP_FLASH_ATTN_EXT: return MK_CLASS_ATTN;
+        case GGML_OP_MUL_MAT:        return ggml_is_quantized(node->src[0]->type) ? MK_CLASS_PROJ : MK_CLASS_SMALL_MM;
+        case GGML_OP_RMS_NORM:       return n_fused > 2 ? MK_CLASS_GLUE : MK_CLASS_NORM;
+        case GGML_OP_CONCAT:         return n_fused > 1 ? MK_CLASS_CONV : MK_CLASS_COPY;
+        case GGML_OP_SSM_CONV:       return MK_CLASS_CONV;
+        case GGML_OP_SOFT_MAX:
+        case GGML_OP_ARGSORT:
+        case GGML_OP_SUM_ROWS:
+        case GGML_OP_TOP_K:          return MK_CLASS_ROUTER;
+        case GGML_OP_GET_ROWS:
+        case GGML_OP_CPY:
+        case GGML_OP_SET_ROWS:
+        case GGML_OP_CONT:
+        case GGML_OP_DUP:            return MK_CLASS_COPY;
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+        case GGML_OP_SCALE:
+        case GGML_OP_UNARY:
+        case GGML_OP_GLU:
+        case GGML_OP_CLAMP:
+        case GGML_OP_SQR:
+        case GGML_OP_SQRT:
+        case GGML_OP_FILL:
+        case GGML_OP_REPEAT:         return MK_CLASS_ELEM;
+        default:                     return MK_CLASS_OTHER;
+    }
+}
+
+struct ggml_cuda_mk_profile_state {
+    std::map<std::string, std::pair<long, double>> by_op; // "class/op[+n]" -> (groups, ms) over the evaluations
+    std::vector<cudaEvent_t> events;       // 2 per launched group
+    std::vector<int>         classes;      // per group
+    std::vector<int>         counts;       // nodes per group
+    std::vector<std::string> labels;       // per group: op name and fused node count
+    int    n_groups = 0;
+    double total_ms[MK_CLASS_COUNT] = {};
+    long   total_groups[MK_CLASS_COUNT] = {};
+    double total_wall_ms = 0.0;
+    double total_gpu_ms  = 0.0;
+    int    n_evals = 0;
+    int64_t t_start = 0;
+};
+
+static ggml_cuda_mk_profile_state & ggml_cuda_mk_profile() {
+    static ggml_cuda_mk_profile_state st;
+    return st;
+}
+
+static void ggml_cuda_mk_profile_begin_eval() {
+    ggml_cuda_mk_profile_state & st = ggml_cuda_mk_profile();
+    st.n_groups = 0;
+    st.t_start  = ggml_time_us();
+}
+
+// before a node or fused group is launched
+static void ggml_cuda_mk_profile_begin(cudaStream_t stream) {
+    ggml_cuda_mk_profile_state & st = ggml_cuda_mk_profile();
+    const size_t need = 2*(size_t) (st.n_groups + 1);
+    while (st.events.size() < need) {
+        cudaEvent_t e;
+        CUDA_CHECK(cudaEventCreate(&e));
+        st.events.push_back(e);
+    }
+    CUDA_CHECK(cudaEventRecord(st.events[2*st.n_groups], stream));
+}
+
+static void ggml_cuda_mk_profile_end(cudaStream_t stream, const ggml_tensor * node, int n_fused) {
+    ggml_cuda_mk_profile_state & st = ggml_cuda_mk_profile();
+    CUDA_CHECK(cudaEventRecord(st.events[2*st.n_groups + 1], stream));
+    if ((int) st.classes.size() <= st.n_groups) {
+        st.classes.resize(st.n_groups + 1);
+        st.counts.resize(st.n_groups + 1);
+    }
+    st.classes[st.n_groups] = ggml_cuda_mk_classify(node, n_fused);
+    st.counts[st.n_groups]  = n_fused;
+    if ((int) st.labels.size() <= st.n_groups) {
+        st.labels.resize(st.n_groups + 1);
+    }
+    char label[96];
+    snprintf(label, sizeof(label), "%s/%s%s%d", ggml_cuda_mk_class_name(st.classes[st.n_groups]), ggml_op_name(node->op),
+            node->op == GGML_OP_UNARY ? ggml_unary_op_name(ggml_get_unary_op(node)) : "", n_fused);
+    st.labels[st.n_groups] = label;
+    st.n_groups++;
+}
+
+static void ggml_cuda_mk_profile_end_eval(ggml_backend_cuda_context & ctx, int n_nodes) {
+    ggml_cuda_mk_profile_state & st = ggml_cuda_mk_profile();
+    if (st.n_groups == 0) {
+        return;
+    }
+    CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+    const double wall_ms = (ggml_time_us() - st.t_start)/1000.0;
+    if (n_nodes < 100) {
+        return; // not a decode graph
+    }
+    double eval_ms[MK_CLASS_COUNT] = {};
+    long   eval_groups[MK_CLASS_COUNT] = {};
+    double gpu_ms = 0.0;
+    for (int g = 0; g < st.n_groups; ++g) {
+        float ms = 0.0f;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, st.events[2*g], st.events[2*g + 1]));
+        eval_ms[st.classes[g]] += ms;
+        eval_groups[st.classes[g]]++;
+        gpu_ms += ms;
+        auto & e = st.by_op[st.labels[g]];
+        e.first++;
+        e.second += ms;
+    }
+    st.n_evals++;
+    st.total_wall_ms += wall_ms;
+    st.total_gpu_ms  += gpu_ms;
+    for (int c = 0; c < MK_CLASS_COUNT; ++c) {
+        st.total_ms[c]     += eval_ms[c];
+        st.total_groups[c] += eval_groups[c];
+    }
+    if (st.n_evals % 50 == 1) {
+        GGML_LOG_INFO("mk_profile: evaluation %d: %d nodes, %d launched groups, host wall %.3f ms, GPU time (event-bracketed, incl. gaps) %.3f ms; averages over %d evaluations:\n",
+                st.n_evals, n_nodes, st.n_groups, wall_ms, gpu_ms, st.n_evals);
+        for (int c = 0; c < MK_CLASS_COUNT; ++c) {
+            if (st.total_groups[c] == 0) {
+                continue;
+            }
+            GGML_LOG_INFO("mk_profile:   %-52s %7.3f ms  %6.1f groups  %6.1f us/group\n", ggml_cuda_mk_class_name(c),
+                    st.total_ms[c]/st.n_evals, (double) st.total_groups[c]/st.n_evals, 1000.0*st.total_ms[c]/st.total_groups[c]);
+        }
+        GGML_LOG_INFO("mk_profile:   %-52s %7.3f ms wall, %7.3f ms GPU\n", "total per evaluation", st.total_wall_ms/st.n_evals, st.total_gpu_ms/st.n_evals);
+        // the launched groups by op (the op of their first node, and the node count they fuse), most frequent first
+        std::vector<std::pair<std::string, std::pair<long, double>>> ops(st.by_op.begin(), st.by_op.end());
+        std::sort(ops.begin(), ops.end(), [](const auto & a, const auto & b) { return a.second.first > b.second.first; });
+        for (size_t k = 0; k < ops.size() && k < 40; ++k) {
+            GGML_LOG_INFO("mk_profile:     %-60s %6.1f groups/eval %7.3f ms/eval\n", ops[k].first.c_str(),
+                    (double) ops[k].second.first/st.n_evals, ops[k].second.second/st.n_evals);
+        }
+    }
+}
+
 // try and fuse nodes and return the number of nodes to skip
+// LLAMA_INKLING_MK_PROJ=1: a run of consecutive one-token MUL_MAT nodes over quantized weights (the Inkling 2
+// attention projections) runs as one kernel per weight type, each distinct input quantized once. Read on every call
+// so that a test can toggle it between two evaluations of the same graph.
+static int ggml_cuda_mk_proj_mode() {
+    const char * env = getenv("LLAMA_INKLING_MK_PROJ");
+    return env ? atoi(env) : 0;
+}
+
+static bool ggml_cuda_mk_debug() {
+    static const bool enabled = getenv("LLAMA_INKLING_MK_DEBUG") != nullptr;
+    return enabled;
+}
+
+// LLAMA_INKLING_MK_WO=1: SIGMOID(g), MUL(x, .), MUL_MAT(w, .) of one token as one self-quantizing product
+static int ggml_cuda_mk_wo_mode() {
+    const char * env = getenv("LLAMA_INKLING_MK_WO");
+    return env ? atoi(env) : 0;
+}
+
+// LLAMA_INKLING_MK_MOE=1: a one-token MUL_MAT_ID quantizes its own inputs (no quantize launch)
+static int ggml_cuda_mk_moe_mode() {
+    const char * env = getenv("LLAMA_INKLING_MK_MOE");
+    return env ? atoi(env) : 0;
+}
+
+// LLAMA_INKLING_MK_WOQ=1: SIGMOID(g), MUL(a, .) of the attention output quantized to q8_1 in one launch and handed to the
+// wo product (mmvq / gemv) instead of the fused sigmoid-mul kernel plus the product's own quantize launch
+static int ggml_cuda_mk_woq_mode() {
+    static const bool test = getenv("LLAMA_INKLING_MK_TEST") != nullptr;
+    static const int  fixed = [] { const char * e = getenv("LLAMA_INKLING_MK_WOQ"); return e ? atoi(e) : 0; }();
+    if (!test) {
+        return fixed;
+    }
+    const char * e = getenv("LLAMA_INKLING_MK_WOQ");
+    return e ? atoi(e) : 0;
+}
+
+// LLAMA_INKLING_MK_MOESCALE=1: the REPEAT + GET_ROWS of the per-expert scale table folded into the weighted reduction
+static int ggml_cuda_mk_moescale_mode() {
+    static const bool test = getenv("LLAMA_INKLING_MK_TEST") != nullptr;
+    static const int  fixed = [] { const char * e = getenv("LLAMA_INKLING_MK_MOESCALE"); return e ? atoi(e) : 0; }();
+    if (!test) {
+        return fixed;
+    }
+    const char * e = getenv("LLAMA_INKLING_MK_MOESCALE");
+    return e ? atoi(e) : 0;
+}
+
+// LLAMA_INKLING_MK_GLUE=1: the loop controllers, the input norms and the q8_1 of the normalized inputs of a layer
+// application as one or two kernels (inkling2.cu, GLUE); the quantized products then consume the q8_1 bytes
+static int ggml_cuda_mk_glue_mode() {
+    const char * env = getenv("LLAMA_INKLING_MK_GLUE");
+    return env ? atoi(env) : 0;
+}
+
+// LLAMA_INKLING_MK_MOE: a one-token MUL_MAT_ID whose expert slots quantize their own inputs in the kernel; the same
+// conditions under which ggml_cuda_mul_mat_id would use mmvq, so that the result is bit-identical
+static bool ggml_cuda_mk_ref();
+
+bool ggml_cuda_mk_moe_try(ggml_backend_cuda_context & ctx, ggml_tensor * node) {
+    if (ggml_cuda_mk_moe_mode() == 0 || ggml_cuda_mk_ref()) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    const ggml_tensor * ids  = node->src[2];
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (src1->type == GGML_TYPE_F32 && node->type == GGML_TYPE_F32 && ggml_is_quantized(src0->type) &&
+            ggml_cuda_mul_mat_vec_q_selfq_supported(src0->type) && node->ne[2] == 1 && node->ne[3] == 1 &&
+            node->ne[1] >= 1 && node->ne[1] <= MMVQ_MULTI_MAX && src1->ne[2] == 1 && src1->ne[3] == 1 &&
+            (src1->ne[1] == 1 || src1->ne[1] == node->ne[1]) && src1->nb[0] == sizeof(float) &&
+            ids->type == GGML_TYPE_I32 && ids->ne[0] == node->ne[1] && ids->ne[1] == 1 && ids->nb[0] == sizeof(int32_t) &&
+            src0->nb[0] == ggml_type_size(src0->type) && src0->nb[1] == ggml_row_size(src0->type, src0->ne[0]) &&
+            src0->ne[0] % QK8_1 == 0 && src0->ne[0] <= 3072 && src0->ne[3] == 1 && node->nb[0] == sizeof(float) &&
+            src0->buffer != nullptr && ggml_backend_buffer_get_usage(src0->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+            !ggml_cuda_should_use_mmq_few(src0, src1, ids, cc) && node->ne[2] <= get_mmvq_mmid_max_batch(src0->type, cc)) {
+        if (ggml_cuda_mk_check_active(ctx)) {
+            // LLAMA_INKLING_MK_CHECK: the fused product into a shadow, the unfused one into the node
+            void * shadow = ggml_cuda_mk_check_alloc(ggml_nbytes(node));
+            if (shadow != nullptr) {
+                ggml_tensor copy = *node;
+                copy.data = shadow;
+                ggml_cuda_mul_mat_vec_q_id_selfq(ctx, src0, src1, ids, &copy, ggml_cuda_mk_debug());
+                const ggml_tensor * outs[1] = { node };
+                ggml_cuda_mk_check_add("moe", -1, 1, outs, &shadow, nullptr, 0);
+            }
+            return false;
+        }
+        ggml_cuda_mul_mat_vec_q_id_selfq(ctx, src0, src1, ids, node, ggml_cuda_mk_debug());
+        return true;
+    }
+    return false;
+}
+
+// a one-token product that the unfused path sends to mmvq and the self-quantizing kernels can take
+static bool ggml_cuda_mk_product_ok(const ggml_tensor * t, int cc) {
+    if (t->op != GGML_OP_MUL_MAT || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) ||
+            t->ne[1] != 1 || t->ne[2] != 1 || t->ne[3] != 1) {
+        return false;
+    }
+    const ggml_tensor * w = t->src[0];
+    const ggml_tensor * x = t->src[1];
+    return ggml_is_quantized(w->type) && ggml_cuda_mul_mat_vec_q_selfq_supported(w->type) && ggml_cuda_should_use_mmvq(w->type, cc, 1) &&
+        w->ne[2] == 1 && w->ne[3] == 1 && w->nb[0] == ggml_type_size(w->type) && w->nb[1] == ggml_row_size(w->type, w->ne[0]) &&
+        w->ne[0] % QK8_1 == 0 && w->ne[0] <= 3072 &&
+        w->buffer != nullptr && ggml_backend_buffer_get_usage(w->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+        x->type == GGML_TYPE_F32 && x->nb[0] == sizeof(float) && x->ne[1] == 1 && x->ne[2] == 1 && x->ne[3] == 1;
+}
+
+// the run of fusable MUL_MAT nodes starting at i: returns the index past the last node of the run (views and other
+// no-ops in between are part of the run), fills the tensors; 0 if the node does not qualify
+static int ggml_cuda_mk_proj_match(ggml_cgraph * cgraph, int i, int & n, const ggml_tensor ** src0, const ggml_tensor ** src1, ggml_tensor ** dst) {
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    n = 0;
+    int end = i;
+    for (int j = i; j < cgraph->n_nodes && n < MMVQ_MULTI_MAX; ++j) {
+        ggml_tensor * t = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(t)) {
+            continue;
+        }
+        if (!ggml_cuda_mk_product_ok(t, cc)) {
