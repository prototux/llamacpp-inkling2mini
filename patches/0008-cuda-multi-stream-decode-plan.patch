diff --git a/tests/test-inkling-gemv.cpp b/tests/test-inkling-gemv.cpp
new file mode 100644
index 000000000..c3b8a195c
--- /dev/null
+++ b/tests/test-inkling-gemv.cpp
@@ -0,0 +1,200 @@
+// LLAMA_INKLING_GEMV: the one-token Q8_0 / Q6_K matrix-vector kernel of the CUDA backend (mmvq-inkling.cu) against
+// mul_mat_vec_q at the shapes of Inkling 2 Mini's attention projections, on random weights.
+//
+// Per case: a graph of n_mats products of the same input with distinct copies of one random weight matrix (together
+// larger than the L2 cache, as in decoding), evaluated with the switch off (mul_mat_vec_q) and on. The outputs must be
+// bit-identical to mul_mat_vec_q's; they are also checked against a double-precision product of the dequantized
+// weights (NMSE, catches a product that would be wrong in both). The backend logs "inkling_gemv: <type> <shape>" on
+// the first launch of the kernel (LLAMA_INKLING_GEMV_DEBUG, set here), which shows that the case did run it.
+// The time per product is the graph time (CUDA graphs on, replayed) over n_mats: kernel plus launch gap. For the
+// kernel alone run it under nsys (see docs/inkling-moonshot.md, "Branch gemv").
+//
+//   test-inkling-gemv                  all cases
+//   test-inkling-gemv -t q8_0          the cases whose name contains "q8_0"
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static uint32_t g_state = 12345u;
+static float frand() {
+    g_state = g_state*1664525u + 1013904223u;
+    return float(g_state >> 8)/float(1u << 24) - 0.5f;
+}
+
+struct run_result {
+    std::vector<std::vector<float>> out; // per product
+    double us_per_product = 0.0;
+};
+
+// n_mats products y_i = W_i x with every W_i holding the same bytes, evaluated 1 + n_rep times
+static run_result run(ggml_backend_t backend, ggml_type type, int64_t ncols, int64_t nrows, int n_mats,
+        const std::vector<uint8_t> & w, const std::vector<float> & x, int n_rep) {
+    ggml_context * ctx = ggml_init({ggml_tensor_overhead()*(2*n_mats + 4) + ggml_graph_overhead_custom(2*n_mats + 4, false), nullptr, true});
+    ggml_cgraph * gf = ggml_new_graph_custom(ctx, 2*n_mats + 4, false);
+    ggml_tensor * xt = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ncols);
+    ggml_set_input(xt);
+    std::vector<ggml_tensor *> ws, ys;
+    for (int i = 0; i < n_mats; ++i) {
+        ggml_tensor * wt = ggml_new_tensor_2d(ctx, type, ncols, nrows);
+        ggml_tensor * yt = ggml_mul_mat(ctx, wt, xt);
+        ggml_set_output(yt);
+        ggml_build_forward_expand(gf, yt);
+        ws.push_back(wt);
+        ys.push_back(yt);
+    }
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    GGML_ASSERT(buf);
+    for (ggml_tensor * wt : ws) {
+        ggml_backend_tensor_set(wt, w.data(), 0, ggml_nbytes(wt));
+    }
+    ggml_backend_tensor_set(xt, x.data(), 0, ggml_nbytes(xt));
+
+    GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS); // captured
+    ggml_backend_synchronize(backend);
+    const auto t0 = std::chrono::steady_clock::now();
+    for (int r = 0; r < n_rep; ++r) {
+        GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS); // replayed
+    }
+    ggml_backend_synchronize(backend);
+    run_result res;
+    res.us_per_product = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count()/n_rep/n_mats;
+    for (ggml_tensor * yt : ys) {
+        std::vector<float> v(nrows);
+        ggml_backend_tensor_get(yt, v.data(), 0, ggml_nbytes(yt));
+        res.out.push_back(std::move(v));
+    }
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    return res;
+}
+
+static bool test_case(ggml_backend_t backend, ggml_type type, int64_t ncols, int64_t nrows, const char * what) {
+    char name[96];
+    snprintf(name, sizeof(name), "%s %lld x %lld (%s)", ggml_type_name(type), (long long) ncols, (long long) nrows, what);
+
+    // weights in [-0.5, 0.5) with a few rows scaled up, so that the block scales differ a lot between rows
+    std::vector<float> wf(ncols*nrows);
+    for (int64_t r = 0; r < nrows; ++r) {
+        const float s = r % 7 == 3 ? 8.0f : 1.0f;
+        for (int64_t c = 0; c < ncols; ++c) {
+            wf[r*ncols + c] = s*frand();
+        }
+    }
+    std::vector<uint8_t> w(ggml_row_size(type, ncols)*nrows);
+    ggml_quantize_chunk(type, wf.data(), w.data(), 0, nrows, ncols, nullptr);
+    std::vector<float> x(ncols);
+    for (float & v : x) {
+        v = 2.0f*frand();
+    }
+
+    // reference in double precision from the dequantized weights (the GPU paths also quantize x to q8_1)
+    std::vector<float> wd(ncols*nrows);
+    ggml_get_type_traits(type)->to_float(w.data(), wd.data(), ncols*nrows);
+    std::vector<double> ref(nrows);
+    for (int64_t r = 0; r < nrows; ++r) {
+        double s = 0.0;
+        for (int64_t c = 0; c < ncols; ++c) {
+            s += double(wd[r*ncols + c])*double(x[c]);
+        }
+        ref[r] = s;
+    }
+
+    const int64_t bytes  = (int64_t) w.size();
+    const int     n_mats = (int) std::min<int64_t>(256, std::max<int64_t>(8, (160ll << 20)/bytes));
+    const int     n_rep  = 20;
+
+    setenv("LLAMA_INKLING_GEMV", "0", 1);
+    const run_result base = run(backend, type, ncols, nrows, n_mats, w, x, n_rep);
+
+    double nmse_num = 0.0, nmse_den = 0.0;
+    for (int64_t r = 0; r < nrows; ++r) {
+        nmse_num += (base.out[0][r] - ref[r])*(base.out[0][r] - ref[r]);
+        nmse_den += ref[r]*ref[r];
+    }
+    const double nmse = nmse_num/std::max(nmse_den, 1e-30);
+    bool ok = nmse < 5e-4;
+    printf("%-34s mmvq         %7.2f us/product  %6.0f GB/s  (NMSE vs double %.2g%s)\n", name, base.us_per_product,
+            bytes/base.us_per_product*1e-3, nmse, nmse < 5e-4 ? "" : " FAIL");
+
+    setenv("LLAMA_INKLING_GEMV", "1", 1);
+    {
+        const run_result g = run(backend, type, ncols, nrows, n_mats, w, x, n_rep);
+        int64_t n_diff = 0;
+        double  max_abs = 0.0;
+        for (int i = 0; i < n_mats; ++i) {
+            for (int64_t r = 0; r < nrows; ++r) {
+                const float a = base.out[i][r], b = g.out[i][r];
+                if (!(a == b) || std::signbit(a) != std::signbit(b)) {
+                    n_diff++;
+                    max_abs = std::max(max_abs, fabs(double(a) - double(b)));
+                }
+            }
+        }
+        ok = ok && n_diff == 0;
+        printf("%-34s gemv         %7.2f us/product  %6.0f GB/s  %s", name, g.us_per_product,
+                bytes/g.us_per_product*1e-3, n_diff == 0 ? "bit-identical" : "DIFFERENT");
+        if (n_diff != 0) {
+            printf(" (%lld of %lld outputs, max abs %.3g) FAIL", (long long) n_diff, (long long) (n_mats*nrows), max_abs);
+        }
+        printf("\n");
+    }
+    setenv("LLAMA_INKLING_GEMV", "0", 1);
+    return ok;
+}
+
+int main(int argc, char ** argv) {
+    std::string filter;
+    for (int a = 1; a + 1 < argc; a += 2) {
+        if (std::string(argv[a]) == "-t") {
+            filter = argv[a + 1];
+        }
+    }
+    setenv("LLAMA_INKLING_GEMV_DEBUG", "1", 0); // the backend logs the first launch of each kernel configuration
+    ggml_backend_load_all();
+
+    struct shape { ggml_type type; int64_t ncols, nrows; const char * what; };
+    const shape shapes[] = {
+        { GGML_TYPE_Q8_0, 2304, 3072, "Q, gate"  },
+        { GGML_TYPE_Q8_0, 2304, 1024, "K, V"     },
+        { GGML_TYPE_Q8_0, 2304,  384, "R"        },
+        { GGML_TYPE_Q8_0, 3072, 2304, "output"   },
+        { GGML_TYPE_Q6_K, 2304, 3072, "Q, gate"  },
+        { GGML_TYPE_Q6_K, 2304, 1024, "K, V"     },
+        { GGML_TYPE_Q6_K, 2304,  384, "R"        },
+        { GGML_TYPE_Q6_K, 3072, 2304, "output"   },
+    };
+
+    int n_fail = 0, n_run = 0;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU || std::string(ggml_backend_dev_name(dev)).find("CUDA") != 0) {
+            continue;
+        }
+        ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+        GGML_ASSERT(backend);
+        printf("== %s\n", ggml_backend_name(backend));
+        for (const shape & s : shapes) {
+            char name[96];
+            snprintf(name, sizeof(name), "%s %lld x %lld (%s)", ggml_type_name(s.type), (long long) s.ncols, (long long) s.nrows, s.what);
+            if (!filter.empty() && std::string(name).find(filter) == std::string::npos) {
+                continue;
+            }
+            const bool ok = test_case(backend, s.type, s.ncols, s.nrows, s.what);
+            n_fail += !ok;
+            n_run++;
+        }
+        ggml_backend_free(backend);
+    }
+    printf("%d/%d cases passed\n", n_run - n_fail, n_run);
+    return n_fail == 0 ? 0 : 1;
+}
diff --git a/tests/test-inkling-megakernel.cpp b/tests/test-inkling-megakernel.cpp
new file mode 100644
index 000000000..67004c01c
--- /dev/null
+++ b/tests/test-inkling-megakernel.cpp
@@ -0,0 +1,1248 @@
+// The Inkling 2 decode megakernel stages against the reference CUDA path, on random weights in the quant types of
+// UD-Q3_K_XL, at the real shapes of one layer application. Each stage is toggled through its environment switch
+// between two evaluations of the same graph; the outputs must be bit-identical; the time per evaluation is printed
+// for both. CUDA graphs stay enabled, as in llama-server: a fresh graph object per run is captured on its first
+// evaluation and replayed on the following ones (the timed ones), so the capture path, the replay path and the
+// pool allocations inside a capture are all exercised; the pool-stress cases use many distinct inputs per call.
+//
+//   /app/test-inkling-megakernel                                          all stages, PASS/FAIL per case
+//   LLAMA_INKLING_MK_DEBUG=1 CUDA_LAUNCH_BLOCKING=1 /app/test-inkling-megakernel   when a stage crashes
+//
+// Stages:
+//   proj (LLAMA_INKLING_MK_PROJ=1): the run of attention projections (Q, R, K, V, gate) of one token as one kernel
+//        per weight type, each input quantized to q8_1 inside the kernel (=2: quantized by separate launches)
+//   wo   (LLAMA_INKLING_MK_WO=1):   SIGMOID(gate), MUL, MUL_MAT(wo) as one self-quantizing product
+//   moe  (LLAMA_INKLING_MK_MOE=1):  a one-token MUL_MAT_ID whose expert slots quantize their own inputs
+//   glue (LLAMA_INKLING_MK_GLUE=1): the loop controllers, the input norms and the q8_1 of the normalized inputs of a
+//        layer application as one or two kernels; the projections and the expert products consume the q8_1 bytes
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cinttypes>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <vector>
+
+static uint32_t g_state = 12345u;
+static std::string g_filter; // -t <substring>: run the cases whose name contains it
+static bool g_expose_ctrl = false; // the glue chain exposes the controller intermediates (h, out) as outputs
+static bool case_selected(const char * name) {
+    return g_filter.empty() || std::string(name).find(g_filter) != std::string::npos;
+}
+static int g_perf_fail = 0; // cases where the fused path is slower than the reference
+static float frand() {
+    g_state = g_state*1664525u + 1013904223u;
+    return float(g_state >> 8)/float(1u << 24) - 0.5f;
+}
+
+static void set_env(const char * name, const char * value) {
+    setenv(name, value, 1);
+}
+
+static std::vector<uint8_t> random_weights(ggml_type type, int64_t ncols, int64_t nrows) {
+    std::vector<float> full(ncols*nrows);
+    for (float & v : full) {
+        v = frand();
+    }
+    std::vector<uint8_t> q(ggml_row_size(type, ncols)*nrows);
+    ggml_quantize_chunk(type, full.data(), q.data(), 0, nrows, ncols, nullptr);
+    return q;
+}
+
+// a graph built by `build` from fresh tensors, its inputs set by `fill`, evaluated 1 + n_rep times; the outputs
+// (every tensor flagged as output, in build order) and the time of one of the timed evaluations
+struct graph_run {
+    std::vector<std::vector<float>> outputs;
+    double us = 0.0;
+};
+
+static graph_run run_graph(ggml_backend_t backend, int n_rep,
+        const std::function<void(ggml_context *, ggml_cgraph *, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data)> & build) {
+    ggml_context * ctx = ggml_init({ggml_tensor_overhead()*256 + ggml_graph_overhead_custom(512, false), nullptr, true});
+    ggml_cgraph * gf = ggml_new_graph_custom(ctx, 512, false);
+    std::vector<ggml_tensor *> outputs;
+    std::vector<std::pair<ggml_tensor *, const void *>> data;
+    build(ctx, gf, outputs, data);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    GGML_ASSERT(buf);
+    for (auto & [t, src] : data) {
+        ggml_backend_tensor_set(t, src, 0, ggml_nbytes(t));
+    }
+    GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+    ggml_backend_synchronize(backend);
+    const auto t0 = std::chrono::steady_clock::now();
+    for (int r = 0; r < n_rep; ++r) {
+        GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+    }
+    ggml_backend_synchronize(backend);
+    graph_run res;
+    res.us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count()/n_rep;
+    for (ggml_tensor * t : outputs) {
+        // quantized outputs (cache rows) are read as raw bytes into the float vector and compared bitwise
+        std::vector<float> v((ggml_nbytes(t) + sizeof(float) - 1)/sizeof(float));
+        ggml_backend_tensor_get(t, v.data(), 0, ggml_nbytes(t));
+        res.outputs.push_back(std::move(v));
+    }
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    return res;
+}
+
+using env_list = std::vector<std::pair<const char *, const char *>>;
+
+// the truly unfused graph: every fusion of the CUDA backend off (LLAMA_INKLING_MK_TEST is set at start-up so that the
+// backend reads this on every call)
+static const env_list UNFUSED = { { "LLAMA_INKLING_MK_REF", "1" } };
+
+static void apply_env(const env_list & env, bool on) {
+    for (const auto & [name, value] : env) {
+        set_env(name, on ? value : "0");
+    }
+}
+
+// the reference (ref_env) against the stage (fused_env); bit-identity required. The default reference is the backend
+// with its usual fusions and the stage switch off; UNFUSED compares against the graph with every fusion off.
+static bool compare_stage(const char * stage, const char * name, ggml_backend_t backend,
+        const std::vector<const char *> & output_names,
+        const std::function<void(ggml_context *, ggml_cgraph *, std::vector<ggml_tensor *> &, std::vector<std::pair<ggml_tensor *, const void *>> &)> & build,
+        const env_list & fused_env, const env_list & ref_env = {}) {
+    if (!case_selected(name)) {
+        return true;
+    }
+    apply_env(ref_env, true);
+    const graph_run ref = run_graph(backend, 50, build);
+    apply_env(ref_env, false);
+    apply_env(fused_env, true);
+    const graph_run mk  = run_graph(backend, 50, build);
+    apply_env(fused_env, false);
+
+    bool ok = ref.outputs.size() == mk.outputs.size();
+    double max_abs = 0.0, max_rel = 0.0;
+    std::string first;
+    for (size_t i = 0; ok && i < ref.outputs.size(); ++i) {
+        ok = ref.outputs[i].size() == mk.outputs[i].size();
+        for (size_t e = 0; ok && e < ref.outputs[i].size(); ++e) {
+            const float a = ref.outputs[i][e], b = mk.outputs[i][e];
+            if ((std::isfinite(b) && a == b) || memcmp(&a, &b, sizeof(float)) == 0) {
+                continue; // equal values, or equal bytes of a quantized output
+            }
+            const double d = fabs(double(a) - double(b));
+            max_abs = std::max(max_abs, d);
+            max_rel = std::max(max_rel, d/std::max(1e-6, fabs(double(a))));
+            if (first.empty()) {
+                char tmp[256];
+                snprintf(tmp, sizeof(tmp), "first mismatch: %s[%zu] ref=%.9g fused=%.9g", output_names[i], e, a, b);
+                first = tmp;
+            }
+        }
+        // keep scanning this output for the maxima, then mark the failure
+        for (size_t e = 0; e < ref.outputs[i].size(); ++e) {
+            if (!(std::isfinite(mk.outputs[i][e]) && ref.outputs[i][e] == mk.outputs[i][e]) &&
+                    memcmp(&ref.outputs[i][e], &mk.outputs[i][e], sizeof(float)) != 0) {
+                ok = false;
+            }
+        }
+    }
+    // never slower than the reference: more than 5% slower is a perf FAIL (counted apart from the correctness result)
+    const bool perf_ok = mk.us <= 1.05*ref.us;
+    g_perf_fail += !perf_ok;
+    printf("%-5s %-32s %s  ref %8.1f us  fused %8.1f us%s%s\n", stage, name, ok ? "PASS" : "FAIL", ref.us, mk.us,
+            ok ? "" : "  (bit-identity required)", perf_ok ? "" : "  PERF FAIL (slower than the reference)");
+    if (!ok) {
+        printf("      max abs %.3g, max rel %.3g, %s\n", max_abs, max_rel, first.c_str());
+    }
+    return ok;
+}
+
+struct proj_spec {
+    const char * name;
+    ggml_type    type;
+    int64_t      rows;
+    int          input;
+};
+
+static bool test_proj(ggml_backend_t backend, const char * name, const char * sw, int n_inputs, const std::vector<proj_spec> & mats) {
+    if (!case_selected(name)) {
+        return true;
+    }
+    const int64_t n_embd = 2304;
+    std::vector<std::vector<uint8_t>> weights;
+    for (const proj_spec & m : mats) {
+        weights.push_back(random_weights(m.type, n_embd, m.rows));
+    }
+    std::vector<std::vector<float>> inputs(n_inputs, std::vector<float>(n_embd));
+    for (auto & in : inputs) {
+        for (float & v : in) {
+            v = 2.0f*frand();
+        }
+    }
+    std::vector<const char *> names;
+    for (const proj_spec & m : mats) {
+        names.push_back(m.name);
+    }
+    return compare_stage("proj", name, backend, names, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        std::vector<ggml_tensor *> x(n_inputs);
+        for (int i = 0; i < n_inputs; ++i) {
+            x[i] = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+            ggml_set_input(x[i]);
+            data.emplace_back(x[i], inputs[i].data());
+        }
+        for (size_t i = 0; i < mats.size(); ++i) {
+            ggml_tensor * w = ggml_new_tensor_2d(ctx, mats[i].type, n_embd, mats[i].rows);
+            data.emplace_back(w, weights[i].data());
+            ggml_tensor * y = ggml_mul_mat(ctx, w, x[mats[i].input]);
+            ggml_set_output(y);
+            ggml_build_forward_expand(gf, y);
+            outputs.push_back(y);
+        }
+    }, { { sw, "1" } });
+}
+
+// wo with its sigmoid gate: a [3072], g [3072], wo [3072 -> 2304]
+static bool test_wo(ggml_backend_t backend, const char * name, ggml_type type) {
+    if (!case_selected(name)) {
+        return true;
+    }
+    const int64_t n_in = 3072, n_out = 2304;
+    const std::vector<uint8_t> w = random_weights(type, n_in, n_out);
+    std::vector<float> a(n_in), g(n_in);
+    for (int64_t i = 0; i < n_in; ++i) {
+        a[i] = 2.0f*frand();
+        g[i] = 8.0f*frand();
+    }
+    return compare_stage("wo", name, backend, {"wo"}, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        ggml_tensor * ta = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_in);
+        ggml_tensor * tg = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_in);
+        ggml_tensor * tw = ggml_new_tensor_2d(ctx, type, n_in, n_out);
+        ggml_set_input(ta);
+        ggml_set_input(tg);
+        data.emplace_back(ta, a.data());
+        data.emplace_back(tg, g.data());
+        data.emplace_back(tw, w.data());
+        ggml_tensor * y = ggml_mul_mat(ctx, tw, ggml_mul(ctx, ta, ggml_sigmoid(ctx, tg)));
+        ggml_set_output(y);
+        ggml_build_forward_expand(gf, y);
+        outputs.push_back(y);
+    }, { { "LLAMA_INKLING_MK_WO", "1" } });
+}
+
+// one token through n_used of n_expert experts: gate_up [2304 -> 2304] with the token as the input of every slot, and
+// down [1152 -> 2304] with one input per slot
+static bool test_moe(ggml_backend_t backend, const char * name, ggml_type type, int64_t n_in, int64_t n_out, bool per_slot_inputs) {
+    if (!case_selected(name)) {
+        return true;
+    }
+    if (ggml_quantize_requires_imatrix(type)) {
+        printf("moe   %-32s SKIP (%s needs an importance matrix to quantize random weights)\n", name, ggml_type_name(type));
+        return true;
+    }
+    // the real expert count: 128 experts, 8 used, so that the timing is the one of a layer application
+    const int n_expert = 128, n_used = 8;
+    std::vector<uint8_t> w;
+    w.reserve(ggml_row_size(type, n_in)*n_out*n_expert);
+    for (int e = 0; e < n_expert; ++e) {
+        const std::vector<uint8_t> we = random_weights(type, n_in, n_out);
+        w.insert(w.end(), we.begin(), we.end());
+    }
+    std::vector<float> x(n_in*(per_slot_inputs ? n_used : 1));
+    for (float & v : x) {
+        v = 2.0f*frand();
+    }
+    int32_t ids[n_used];
+    for (int i = 0; i < n_used; ++i) {
+        ids[i] = (37*i + 5) % n_expert; // 8 distinct experts spread over the 128
+    }
+    return compare_stage("moe", name, backend, {"experts"}, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        ggml_tensor * tw  = ggml_new_tensor_3d(ctx, type, n_in, n_out, n_expert);
+        ggml_tensor * tx  = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_in, per_slot_inputs ? n_used : 1, 1);
+        ggml_tensor * tid = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, 1);
+        ggml_set_input(tx);
+        ggml_set_input(tid);
+        data.emplace_back(tw, w.data());
+        data.emplace_back(tx, x.data());
+        data.emplace_back(tid, ids);
+        ggml_tensor * y = ggml_mul_mat_id(ctx, tw, tx, tid);
+        ggml_set_output(y);
+        ggml_build_forward_expand(gf, y);
+        outputs.push_back(y);
+    }, { { "LLAMA_INKLING_MK_MOE", "1" } });
+}
+
+// The server pattern, which a single evaluation cannot show: one graph object evaluated for several decode steps with
+// new inputs each step, K and V written into a cache through set_rows at the step's row, the CUDA graph captured on
+// the second step and replayed afterwards. The layer structure of Inkling 2: RMS_NORM, MUL(norm weight) per input
+// (one input for a pass-1 SWA layer, three for a loop pass or full-attention layer), the quantized projections
+// Q, R, K, V, gate, then the BF16 sinks product that ends the run, then the cache writes. Compared: every step's
+// Q, R, gate and the two caches after the last step, bit-identical between the reference and the fused path.
+static bool test_steps(ggml_backend_t backend, const char * name, int n_inputs, ggml_type type_q, ggml_type type_kv, int n_steps) {
+    if (!case_selected(name)) {
+        return true;
+    }
+    const int64_t n_embd = 2304, n_q = 3072, n_kv = 1024, n_r = 384, n_sink = 24;
+    const std::vector<uint8_t> wq = random_weights(type_q, n_embd, n_q), wr = random_weights(type_q, n_embd, n_r),
+        wk = random_weights(type_kv, n_embd, n_kv), wv = random_weights(type_kv, n_embd, n_kv), wg = random_weights(type_q, n_embd, n_q);
+    std::vector<ggml_fp16_t> ws(n_embd*n_sink);
+    for (auto & v : ws) {
+        v = ggml_fp32_to_fp16(frand());
+    }
+    std::vector<std::vector<float>> wn(n_inputs, std::vector<float>(n_embd));
+    for (auto & w : wn) {
+        for (float & v : w) {
+            v = 1.0f + 0.2f*frand();
+        }
+    }
+    std::vector<std::vector<std::vector<float>>> xs(n_steps, std::vector<std::vector<float>>(n_inputs, std::vector<float>(n_embd)));
+    for (auto & step : xs) {
+        for (auto & x : step) {
+            for (float & v : x) {
+                v = 2.0f*frand();
+            }
+        }
+    }
+
+    const auto run = [&](bool fused) {
+        set_env("LLAMA_INKLING_MK_PROJ", fused ? "1" : "0");
+        ggml_context * ctx = ggml_init({ggml_tensor_overhead()*64 + ggml_graph_overhead_custom(128, false), nullptr, true});
+        ggml_cgraph * gf = ggml_new_graph_custom(ctx, 128, false);
+        std::vector<ggml_tensor *> x(n_inputs), nw(n_inputs), h(n_inputs);
+        for (int i = 0; i < n_inputs; ++i) {
+            x[i]  = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+            nw[i] = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+            ggml_set_input(x[i]);
+            h[i] = ggml_mul(ctx, ggml_rms_norm(ctx, x[i], 1e-6f), nw[i]);
+        }
+        ggml_tensor * tq = ggml_new_tensor_2d(ctx, type_q,  n_embd, n_q);
+        ggml_tensor * tr = ggml_new_tensor_2d(ctx, type_q,  n_embd, n_r);
+        ggml_tensor * tk = ggml_new_tensor_2d(ctx, type_kv, n_embd, n_kv);
+        ggml_tensor * tv = ggml_new_tensor_2d(ctx, type_kv, n_embd, n_kv);
+        ggml_tensor * tg = ggml_new_tensor_2d(ctx, type_q,  n_embd, n_q);
+        ggml_tensor * ts = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, n_embd, n_sink);
+        ggml_tensor * cache_k = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_kv, n_steps);
+        ggml_tensor * cache_v = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_kv, n_steps);
+        ggml_tensor * row = ggml_new_tensor_1d(ctx, GGML_TYPE_I64, 1);
+        ggml_set_input(row);
+        // the expand order of inkling2.cpp: quantized projections first, then the sinks, then the cache writes
+        ggml_tensor * q = ggml_mul_mat(ctx, tq, h[0]);
+        ggml_tensor * r = ggml_mul_mat(ctx, tr, h[0]);
+        ggml_build_forward_expand(gf, q);
+        ggml_build_forward_expand(gf, r);
+        ggml_tensor * k = ggml_mul_mat(ctx, tk, h[n_inputs > 1 ? 1 : 0]);
+        ggml_tensor * v = ggml_mul_mat(ctx, tv, h[n_inputs > 2 ? 2 : 0]);
+        ggml_build_forward_expand(gf, k);
+        ggml_build_forward_expand(gf, v);
+        ggml_tensor * g = ggml_mul_mat(ctx, tg, h[0]);
+        ggml_build_forward_expand(gf, g);
+        ggml_tensor * sk = ggml_mul_mat(ctx, ts, h[0]);
+        ggml_build_forward_expand(gf, sk);
+        ggml_tensor * store_k = ggml_set_rows(ctx, cache_k, ggml_reshape_2d(ctx, k, n_kv, 1), row);
+        ggml_tensor * store_v = ggml_set_rows(ctx, cache_v, ggml_reshape_2d(ctx, v, n_kv, 1), row);
+        ggml_build_forward_expand(gf, store_k);
+        ggml_build_forward_expand(gf, store_v);
+        ggml_set_output(q);
+        ggml_set_output(r);
+        ggml_set_output(g);
+        ggml_set_output(sk);
+        ggml_set_output(cache_k);
+        ggml_set_output(cache_v);
+
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        GGML_ASSERT(buf);
+        ggml_backend_tensor_set(tq, wq.data(), 0, wq.size());
+        ggml_backend_tensor_set(tr, wr.data(), 0, wr.size());
+        ggml_backend_tensor_set(tk, wk.data(), 0, wk.size());
+        ggml_backend_tensor_set(tv, wv.data(), 0, wv.size());
+        ggml_backend_tensor_set(tg, wg.data(), 0, wg.size());
+        ggml_backend_tensor_set(ts, ws.data(), 0, ws.size()*sizeof(ggml_fp16_t));
+        for (int i = 0; i < n_inputs; ++i) {
+            ggml_backend_tensor_set(nw[i], wn[i].data(), 0, n_embd*sizeof(float));
+        }
+        ggml_backend_buffer_clear(buf, 0); // caches zero (the weights are set again below)
+        ggml_backend_tensor_set(tq, wq.data(), 0, wq.size());
+        ggml_backend_tensor_set(tr, wr.data(), 0, wr.size());
+        ggml_backend_tensor_set(tk, wk.data(), 0, wk.size());
+        ggml_backend_tensor_set(tv, wv.data(), 0, wv.size());
+        ggml_backend_tensor_set(tg, wg.data(), 0, wg.size());
+        ggml_backend_tensor_set(ts, ws.data(), 0, ws.size()*sizeof(ggml_fp16_t));
+        for (int i = 0; i < n_inputs; ++i) {
+            ggml_backend_tensor_set(nw[i], wn[i].data(), 0, n_embd*sizeof(float));
+        }
+
+        std::vector<std::vector<float>> out;
+        double us = 0.0;
+        for (int step = 0; step < n_steps; ++step) {
+            for (int i = 0; i < n_inputs; ++i) {
+                ggml_backend_tensor_set(x[i], xs[step][i].data(), 0, n_embd*sizeof(float));
+            }
+            const int64_t r64 = step;
+            ggml_backend_tensor_set(row, &r64, 0, sizeof(r64));
+            const auto t0 = std::chrono::steady_clock::now();
+            GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+            ggml_backend_synchronize(backend);
+            if (step == n_steps - 1) {
+                us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count();
+            }
+            for (ggml_tensor * t : { q, r, g, sk }) {
+                std::vector<float> o(ggml_nelements(t));
+                ggml_backend_tensor_get(t, o.data(), 0, ggml_nbytes(t));
+                out.push_back(std::move(o));
+            }
+        }
+        for (ggml_tensor * t : { cache_k, cache_v }) {
+            std::vector<float> o(ggml_nelements(t));
+            ggml_backend_tensor_get(t, o.data(), 0, ggml_nbytes(t));
+            out.push_back(std::move(o));
+        }
+        ggml_backend_buffer_free(buf);
+        ggml_free(ctx);
+        set_env("LLAMA_INKLING_MK_PROJ", "0");
+        return std::make_pair(out, us);
+    };
+
+    const auto [ref, us_ref] = run(false);
+    const auto [mk,  us_mk]  = run(true);
+    bool ok = ref.size() == mk.size();
+    std::string first;
+    double max_abs = 0.0;
+    for (size_t i = 0; ok && i < ref.size(); ++i) {
+        for (size_t e = 0; e < ref[i].size(); ++e) {
+            if (std::isfinite(mk[i][e]) && ref[i][e] == mk[i][e]) {
+                continue;
+            }
+            max_abs = std::max(max_abs, (double) fabs(double(ref[i][e]) - double(mk[i][e])));
+            if (first.empty()) {
+                static const char * names[] = { "q", "r", "gate", "sinks" };
+                char tmp[256];
+                if (i < size_t(4*n_steps)) {
+                    snprintf(tmp, sizeof(tmp), "first mismatch: step %zu %s[%zu] ref=%.9g fused=%.9g", i/4, names[i%4], e, ref[i][e], mk[i][e]);
+                } else {
+                    snprintf(tmp, sizeof(tmp), "first mismatch: cache_%c row %zu [%zu] ref=%.9g fused=%.9g", i == size_t(4*n_steps) ? 'k' : 'v', e/n_kv, e%n_kv, ref[i][e], mk[i][e]);
+                }
+                first = tmp;
+            }
+            ok = false;
+        }
+    }
+    printf("steps %-32s %s  ref %8.1f us  fused %8.1f us  (%d steps, CUDA graph replayed from step 2)\n", name, ok ? "PASS" : "FAIL", us_ref, us_mk, n_steps);
+    if (!ok) {
+        printf("      max abs %.3g, %s\n", max_abs, first.c_str());
+    }
+    return ok;
+}
+
+// The glue stage (LLAMA_INKLING_MK_GLUE=1): the input chain of a layer application for one token. With `ctrl`, each
+// unit is the loop controller of inkling2.cpp (control(): concat of two rms_norms, ctrl_down, gain/forget products,
+// tanh gates) followed by the input norm; without, the input norm alone. The units are built in the graph order of the
+// model under the MK_PROJ/MK_GLUE expansion (controllers first, then the norms), then the quantized consumers of the
+// normalized inputs (the attention projections, or the expert gate_up MUL_MAT_ID of the FFN) whose results also check
+// the q8_1 bytes the glue kernel emits for them: a differing byte changes the dot products.
+struct glue_spec {
+    int  n_units;        // 1 or 3 inputs
+    bool ctrl;           // loop controllers before the norms
+    int  mix_states = 0; // > 0: the depth mix over this many states (the earlier ones + the current) feeds the units
+    int  n_q        = 0; // queries of the mix (0: one per unit); 1 with three units = a SWA loop layer (one shared row)
+};
+
+// the input tensors, weights and the chain; the normalized outputs in y[]
+struct glue_chain {
+    ggml_tensor * mixed    = nullptr; // [n_embd, n_units] input: the attention-input mix (one row per unit); with mix_states
+                                      // the mix is built in the graph from `earlier` [n_embd, states - 1], `cur` and `query`
+    ggml_tensor * earlier  = nullptr;
+    ggml_tensor * cur      = nullptr;
+    ggml_tensor * messages = nullptr; // [n_embd, 4] input: the pass messages (ctrl)
+    std::vector<ggml_tensor *> y;     // the normalized inputs
+    std::vector<ggml_tensor *> ctrl_h, ctrl_out; // g_expose_ctrl: the controller intermediates
+    std::vector<std::pair<ggml_tensor *, const std::vector<float> *>> weights;
+};
+
+struct glue_weights {
+    std::vector<std::vector<float>> w_down, w_gain, w_forget, w_norm;
+    std::vector<float> mixed, messages, earlier, cur, query;
+    glue_weights(const glue_spec & spec, int64_t n_embd, int64_t rank) {
+        if (spec.mix_states > 0) {
+            earlier.resize(n_embd*(spec.mix_states - 1));
+            cur.resize(n_embd);
+            query.resize(n_embd*(spec.n_q > 0 ? spec.n_q : spec.n_units));
+            for (float & v : earlier) {
+                v = 2.0f*frand(); // the normalized earlier states: unit scale
+            }
+            for (float & v : cur) {
+                v = 2.0f*frand();
+            }
+            for (float & v : query) {
+                v = 0.5f*frand();
+            }
+        }
+        for (int j = 0; j < spec.n_units; ++j) {
+            w_norm.emplace_back(n_embd);
+            for (float & v : w_norm.back()) {
+                v = 1.0f + 0.2f*frand();
+            }
+            if (spec.ctrl) {
+                // the controller products stay in the active range of the tanh gates: |h| ~ 1, |gate| < 1
+                w_down.emplace_back(2*n_embd*rank);
+                for (float & v : w_down.back()) {
+                    v = 0.05f*frand();
+                }
+                w_gain.emplace_back(rank*n_embd);
+                w_forget.emplace_back(rank*n_embd);
+                for (float & v : w_gain.back()) {
+                    v = 0.6f*frand();
+                }
+                for (float & v : w_forget.back()) {
+                    v = 0.6f*frand();
+                }
+            }
+        }
+        mixed.resize(n_embd*spec.n_units);
+        messages.resize(n_embd*4);
+        for (float & v : mixed) {
+            v = 2.0f*frand();
+        }
+        for (float & v : messages) {
+            v = 2.0f*frand();
+        }
+    }
+};
+
+static glue_chain build_glue_chain(ggml_context * ctx, ggml_cgraph * gf, const glue_spec & spec, int64_t n_embd, int64_t rank,
+        const glue_weights & w) {
+    glue_chain c;
+    std::vector<ggml_tensor *> inputs(spec.n_units);
+    if (spec.mix_states > 0) {
+        // inkling2.cpp mix(): [earlier states, rms_norm(cur)] attended by the queries
+        const int n_q = spec.n_q > 0 ? spec.n_q : spec.n_units;
+        c.earlier = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_embd, spec.mix_states - 1, 1);
+        c.cur     = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+        ggml_set_input(c.earlier);
+        ggml_set_input(c.cur);
+        ggml_tensor * query = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_q);
+        c.weights.emplace_back(query, &w.query);
+        ggml_tensor * states = ggml_rms_norm(ctx, ggml_reshape_3d(ctx, c.cur, n_embd, 1, 1), 1e-6f);
+        states = ggml_concat(ctx, c.earlier, states, 1);
+        ggml_tensor * queries = ggml_repeat(ctx, query, ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_embd, n_q, 1));
+        ggml_tensor * scores  = ggml_mul_mat(ctx, states, queries);
+        scores = ggml_soft_max_ext(ctx, scores, nullptr, 1.0f/sqrtf((float) n_embd), 0.0f);
+        c.mixed = ggml_mul_mat(ctx, ggml_cont(ctx, ggml_transpose(ctx, states)), scores);
+        for (int j = 0; j < spec.n_units; ++j) {
+            inputs[j] = ggml_view_2d(ctx, c.mixed, n_embd, 1, c.mixed->nb[1], (n_q == 1 ? 0 : j)*c.mixed->nb[1]);
+        }
+    } else {
+        c.mixed = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, spec.n_units);
+        ggml_set_input(c.mixed);
+        for (int j = 0; j < spec.n_units; ++j) {
+            inputs[j] = ggml_view_2d(ctx, c.mixed, n_embd, 1, c.mixed->nb[1], j*c.mixed->nb[1]);
+        }
+    }
+    if (spec.ctrl) {
+        c.messages = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, 4);
+        ggml_set_input(c.messages);
+        for (int j = 0; j < spec.n_units; ++j) {
+            ggml_tensor * message = ggml_view_2d(ctx, c.messages, n_embd, 1, c.messages->nb[1], j*c.messages->nb[1]);
+            ggml_build_forward_expand(gf, message);
+            ggml_tensor * ctrl_down   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2*n_embd, rank);
+            ggml_tensor * ctrl_gain   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, rank, n_embd);
+            ggml_tensor * ctrl_forget = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, rank, n_embd);
+            c.weights.emplace_back(ctrl_down,   &w.w_down[j]);
+            c.weights.emplace_back(ctrl_gain,   &w.w_gain[j]);
+            c.weights.emplace_back(ctrl_forget, &w.w_forget[j]);
+            // inkling2.cpp control()
+            ggml_tensor * cur  = inputs[j];
+            ggml_tensor * gate = ggml_concat(ctx, ggml_rms_norm(ctx, cur, 1e-6f), ggml_rms_norm(ctx, message, 1e-6f), 0);
+            gate = ggml_mul_mat(ctx, ctrl_down, gate);
+            ggml_tensor * gain   = ggml_mul_mat(ctx, ctrl_gain,   gate);
+            ggml_tensor * forget = ggml_mul_mat(ctx, ctrl_forget, gate);
+            ggml_build_forward_expand(gf, forget);
+            ggml_build_forward_expand(gf, gain);
+            gain   = ggml_tanh(ctx, gain);
+            forget = ggml_tanh(ctx, forget);
+            ggml_tensor * out = ggml_add(ctx, ggml_sub(ctx, cur, ggml_mul(ctx, forget, cur)), ggml_mul(ctx, gain, message));
+            ggml_build_forward_expand(gf, out);
+            if (g_expose_ctrl) {
+                // the controller intermediates as outputs: the CTRL_DOWN/CTRL_OUT fusions keep matching (their outputs),
+                // the glue does not (it needs them internal); compared to locate a differing fusion
+                ggml_set_output(gate);
+                ggml_set_output(out);
+                c.ctrl_h.push_back(gate);
+                c.ctrl_out.push_back(out);
+            }
+            inputs[j] = out;
+        }
+    }
+    for (int j = 0; j < spec.n_units; ++j) {
+        ggml_tensor * wn = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+        c.weights.emplace_back(wn, &w.w_norm[j]);
+        c.y.push_back(ggml_mul(ctx, ggml_rms_norm(ctx, inputs[j], 1e-6f), wn));
+    }
+    for (ggml_tensor * y : c.y) {
+        ggml_build_forward_expand(gf, y); // the MK_PROJ/MK_GLUE expansion order: the norms before the projections
+    }
+    return c;
+}
+
+static void glue_chain_inputs(const glue_chain & c, const glue_weights & w, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+    if (c.earlier) {
+        data.emplace_back(c.earlier, w.earlier.data());
+        data.emplace_back(c.cur, w.cur.data());
+    } else {
+        data.emplace_back(c.mixed, w.mixed.data());
+    }
+    if (c.messages) {
+        data.emplace_back(c.messages, w.messages.data());
+    }
+}
+
+// the glue chain, then the attention projections (one input: Q, R, K, V and gate read y[0]; three: K reads y[1], V y[2])
+static bool test_glue_attn(ggml_backend_t backend, const char * name, const glue_spec & spec, ggml_type type_q, ggml_type type_kv, const char * proj, const char * mode = "1") {
+    const int64_t n_embd = 2304, rank = 64, n_q = 3072, n_kv = 1024, n_r = 384;
+    const glue_weights w(spec, n_embd, rank);
+    const std::vector<uint8_t> wq = random_weights(type_q, n_embd, n_q), wr = random_weights(type_q, n_embd, n_r),
+        wk = random_weights(type_kv, n_embd, n_kv), wv = random_weights(type_kv, n_embd, n_kv), wg = random_weights(type_q, n_embd, n_q);
+    std::vector<const char *> names;
+    if (g_expose_ctrl && spec.ctrl) {
+        for (int j = 0; j < spec.n_units; ++j) {
+            names.push_back(j == 0 ? "h0" : j == 1 ? "h1" : "h2");
+            names.push_back(j == 0 ? "ctrl_out0" : j == 1 ? "ctrl_out1" : "ctrl_out2");
+        }
+    }
+    for (int j = 0; j < spec.n_units; ++j) {
+        names.push_back(j == 0 ? "y0" : j == 1 ? "y1" : "y2");
+    }
+    for (const char * p : { "q", "r", "k", "v", "gate" }) {
+        names.push_back(p);
+    }
+    std::string label = std::string(name) + " proj=" + proj + (mode[0] == '2' ? " glue=2" : "") + (mode[1] == 'f' ? " ref=fused" : "");
+    set_env("LLAMA_INKLING_MK_PROJ", proj);
+    // the reference is the truly unfused graph: the glue replicates the unfused kernels, not the CTRL/MIX fusions
+    const bool ok = compare_stage(mode[0] == 'f' ? "fused" : mode[0] == 'u' || mode[0] == 'F' || mode[0] == 'G' ? "ref" : "glue", label.c_str(), backend, names, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        const glue_chain c = build_glue_chain(ctx, gf, spec, n_embd, rank, w);
+        glue_chain_inputs(c, w, data);
+        for (const auto & [t, v] : c.weights) {
+            data.emplace_back(t, v->data());
+        }
+        ggml_tensor * tq = ggml_new_tensor_2d(ctx, type_q,  n_embd, n_q);
+        ggml_tensor * tr = ggml_new_tensor_2d(ctx, type_q,  n_embd, n_r);
+        ggml_tensor * tk = ggml_new_tensor_2d(ctx, type_kv, n_embd, n_kv);
+        ggml_tensor * tv = ggml_new_tensor_2d(ctx, type_kv, n_embd, n_kv);
+        ggml_tensor * tg = ggml_new_tensor_2d(ctx, type_q,  n_embd, n_q);
+        data.emplace_back(tq, wq.data());
+        data.emplace_back(tr, wr.data());
+        data.emplace_back(tk, wk.data());
+        data.emplace_back(tv, wv.data());
+        data.emplace_back(tg, wg.data());
+        ggml_tensor * y0 = c.y[0];
+        ggml_tensor * y1 = c.y[spec.n_units > 1 ? 1 : 0];
+        ggml_tensor * y2 = c.y[spec.n_units > 2 ? 2 : 0];
+        ggml_tensor * prods[5] = { ggml_mul_mat(ctx, tq, y0), ggml_mul_mat(ctx, tr, y0), ggml_mul_mat(ctx, tk, y1),
+                                   ggml_mul_mat(ctx, tv, y2), ggml_mul_mat(ctx, tg, y0) };
+        for (size_t j = 0; j < c.ctrl_h.size(); ++j) {
+            outputs.push_back(c.ctrl_h[j]);
+            outputs.push_back(c.ctrl_out[j]);
+        }
+        for (ggml_tensor * y : c.y) {
+            ggml_set_output(y);
+            outputs.push_back(y);
+        }
+        for (ggml_tensor * p : prods) {
+            ggml_set_output(p);
+            ggml_build_forward_expand(gf, p);
+            outputs.push_back(p);
+        }
+    }, mode[0] == 'f' || mode[0] == 'F' ? env_list{} : mode[0] == 'u' ? UNFUSED : env_list{ { "LLAMA_INKLING_MK_GLUE", mode[0] == 'G' ? "1" : mode[0] == '2' ? "2" : "1" } },
+       mode[0] == 'F' || mode[1] == 'f' ? env_list{} : mode[0] == 'G' ? env_list{ { "LLAMA_INKLING_MK_GLUE", "1" } } : UNFUSED);
+    set_env("LLAMA_INKLING_MK_PROJ", "0");
+    return ok;
+}
+
+// the FFN chain: one unit, then the router (F32 product: reads y, not its q8_1) and the expert gate_up MUL_MAT_ID
+// (reads the q8_1); MK_MOE follows MK_PROJ so that both consumer paths are covered
+static bool test_glue_ffn(ggml_backend_t backend, const char * name, bool ctrl, ggml_type type_exp, const char * mk, const char * mode = "1", int mix_states = 0) {
+    const int64_t n_embd = 2304, rank = 64, n_expert = 16, n_used = 8, n_router = 128;
+    const glue_spec spec = { 1, ctrl, mix_states, 1 };
+    const glue_weights w(spec, n_embd, rank);
+    std::vector<uint8_t> we;
+    for (int e = 0; e < n_expert; ++e) {
+        const std::vector<uint8_t> one = random_weights(type_exp, n_embd, n_embd);
+        we.insert(we.end(), one.begin(), one.end());
+    }
+    std::vector<float> wrouter(n_embd*n_router);
+    for (float & v : wrouter) {
+        v = frand();
+    }
+    int32_t ids[8];
+    for (int i = 0; i < n_used; ++i) {
+        ids[i] = (5*i + 3) % n_expert;
+    }
+    std::string label = std::string(name) + " proj=moe=" + mk + (mode[0] == '2' ? " glue=2" : "");
+    set_env("LLAMA_INKLING_MK_PROJ", mk);
+    set_env("LLAMA_INKLING_MK_MOE", mk);
+    const bool ok = compare_stage(mode[0] == 'f' ? "fused" : "glue", label.c_str(), backend, { "y0", "router", "experts" }, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        const glue_chain c = build_glue_chain(ctx, gf, spec, n_embd, rank, w);
+        glue_chain_inputs(c, w, data);
+        for (const auto & [t, v] : c.weights) {
+            data.emplace_back(t, v->data());
+        }
+        ggml_tensor * trouter = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_router);
+        ggml_tensor * texp    = ggml_new_tensor_3d(ctx, type_exp, n_embd, n_embd, n_expert);
+        ggml_tensor * tids    = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, 1);
+        ggml_set_input(tids);
+        data.emplace_back(trouter, wrouter.data());
+        data.emplace_back(texp, we.data());
+        data.emplace_back(tids, ids);
+        ggml_tensor * router  = ggml_mul_mat(ctx, trouter, c.y[0]);
+        ggml_tensor * experts = ggml_mul_mat_id(ctx, texp, ggml_reshape_3d(ctx, c.y[0], n_embd, 1, 1), tids);
+        for (ggml_tensor * t : { c.y[0], router, experts }) {
+            ggml_set_output(t);
+            ggml_build_forward_expand(gf, t);
+            outputs.push_back(t);
+        }
+    }, mode[0] == 'f' ? env_list{} : env_list{ { "LLAMA_INKLING_MK_GLUE", mode } }, UNFUSED);
+    set_env("LLAMA_INKLING_MK_PROJ", "0");
+    set_env("LLAMA_INKLING_MK_MOE", "0");
+    return ok;
+}
+
+// the server pattern for the glue (as test_steps for the projections): one graph object, several decode steps with new
+// inputs each step and cache writes, the CUDA graph captured on the second step and replayed afterwards
+static bool test_glue_steps(ggml_backend_t backend, const char * name, const glue_spec & spec, int n_steps, const char * proj, const char * mode = "1") {
+    if (!case_selected(name)) {
+        return true;
+    }
+    const int64_t n_embd = 2304, rank = 64, n_q = 3072, n_kv = 1024;
+    const glue_weights w(spec, n_embd, rank);
+    const std::vector<uint8_t> wq = random_weights(GGML_TYPE_Q8_0, n_embd, n_q), wk = random_weights(GGML_TYPE_Q8_0, n_embd, n_kv),
+        wv = random_weights(GGML_TYPE_Q8_0, n_embd, n_kv);
+    std::vector<std::vector<float>> mixed(n_steps, std::vector<float>(n_embd*spec.n_units)), messages(n_steps, std::vector<float>(n_embd*4));
+    for (auto & v : mixed) {
+        for (float & x : v) {
+            x = 2.0f*frand();
+        }
+    }
+    for (auto & v : messages) {
+        for (float & x : v) {
+            x = 2.0f*frand();
+        }
+    }
+
+    const auto run = [&](bool fused) {
+        set_env("LLAMA_INKLING_MK_PROJ", proj);
+        set_env("LLAMA_INKLING_MK_GLUE", fused ? mode : "0");
+        set_env("LLAMA_INKLING_MK_REF", fused ? "0" : "1"); // the reference is the truly unfused graph
+        ggml_context * ctx = ggml_init({ggml_tensor_overhead()*128 + ggml_graph_overhead_custom(256, false), nullptr, true});
+        ggml_cgraph * gf = ggml_new_graph_custom(ctx, 256, false);
+        const glue_chain c = build_glue_chain(ctx, gf, spec, n_embd, rank, w);
+        ggml_tensor * tq = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, n_embd, n_q);
+        ggml_tensor * tk = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, n_embd, n_kv);
+        ggml_tensor * tv = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, n_embd, n_kv);
+        ggml_tensor * cache_k = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_kv, n_steps);
+        ggml_tensor * cache_v = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_kv, n_steps);
+        ggml_tensor * row = ggml_new_tensor_1d(ctx, GGML_TYPE_I64, 1);
+        ggml_set_input(row);
+        ggml_tensor * q = ggml_mul_mat(ctx, tq, c.y[0]);
+        ggml_tensor * k = ggml_mul_mat(ctx, tk, c.y[spec.n_units > 1 ? 1 : 0]);
+        ggml_tensor * v = ggml_mul_mat(ctx, tv, c.y[spec.n_units > 2 ? 2 : 0]);
+        ggml_build_forward_expand(gf, q);
+        ggml_build_forward_expand(gf, k);
+        ggml_build_forward_expand(gf, v);
+        ggml_tensor * store_k = ggml_set_rows(ctx, cache_k, ggml_reshape_2d(ctx, k, n_kv, 1), row);
+        ggml_tensor * store_v = ggml_set_rows(ctx, cache_v, ggml_reshape_2d(ctx, v, n_kv, 1), row);
+        ggml_build_forward_expand(gf, store_k);
+        ggml_build_forward_expand(gf, store_v);
+        for (ggml_tensor * t : c.y) {
+            ggml_set_output(t);
+        }
+        ggml_set_output(q);
+        ggml_set_output(cache_k);
+        ggml_set_output(cache_v);
+
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        GGML_ASSERT(buf);
+        ggml_backend_buffer_clear(buf, 0); // caches zero
+        ggml_backend_tensor_set(tq, wq.data(), 0, wq.size());
+        ggml_backend_tensor_set(tk, wk.data(), 0, wk.size());
+        ggml_backend_tensor_set(tv, wv.data(), 0, wv.size());
+        for (const auto & [t, vals] : c.weights) {
+            ggml_backend_tensor_set(t, vals->data(), 0, ggml_nbytes(t));
+        }
+
+        std::vector<std::vector<float>> out;
+        double us = 0.0;
+        for (int step = 0; step < n_steps; ++step) {
+            if (c.earlier) {
+                ggml_backend_tensor_set(c.earlier, w.earlier.data(), 0, ggml_nbytes(c.earlier));
+                ggml_backend_tensor_set(c.cur, mixed[step].data(), 0, ggml_nbytes(c.cur));
+            } else {
+                ggml_backend_tensor_set(c.mixed, mixed[step].data(), 0, ggml_nbytes(c.mixed));
+            }
+            if (c.messages) {
+                ggml_backend_tensor_set(c.messages, messages[step].data(), 0, ggml_nbytes(c.messages));
+            }
+            const int64_t r64 = step;
+            ggml_backend_tensor_set(row, &r64, 0, sizeof(r64));
+            const auto t0 = std::chrono::steady_clock::now();
+            GGML_ASSERT(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+            ggml_backend_synchronize(backend);
+            if (step == n_steps - 1) {
+                us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count();
+            }
+            for (ggml_tensor * t : c.y) {
+                std::vector<float> o(ggml_nelements(t));
+                ggml_backend_tensor_get(t, o.data(), 0, ggml_nbytes(t));
+                out.push_back(std::move(o));
+            }
+            std::vector<float> o(ggml_nelements(q));
+            ggml_backend_tensor_get(q, o.data(), 0, ggml_nbytes(q));
+            out.push_back(std::move(o));
+        }
+        for (ggml_tensor * t : { cache_k, cache_v }) {
+            std::vector<float> o(ggml_nelements(t));
+            ggml_backend_tensor_get(t, o.data(), 0, ggml_nbytes(t));
+            out.push_back(std::move(o));
+        }
+        ggml_backend_buffer_free(buf);
+        ggml_free(ctx);
+        set_env("LLAMA_INKLING_MK_GLUE", "0");
+        set_env("LLAMA_INKLING_MK_PROJ", "0");
+        set_env("LLAMA_INKLING_MK_REF", "0");
+        return std::make_pair(out, us);
+    };
+
+    const auto [ref, us_ref] = run(false);
+    const auto [mk,  us_mk]  = run(true);
+    const size_t per_step = spec.n_units + 1;
+    bool ok = ref.size() == mk.size();
+    std::string first;
+    double max_abs = 0.0;
+    for (size_t i = 0; ok && i < ref.size(); ++i) {
+        for (size_t e = 0; e < ref[i].size(); ++e) {
+            if (std::isfinite(mk[i][e]) && ref[i][e] == mk[i][e]) {
+                continue;
+            }
+            max_abs = std::max(max_abs, (double) fabs(double(ref[i][e]) - double(mk[i][e])));
+            if (first.empty()) {
+                char tmp[256];
+                if (i < per_step*n_steps) {
+                    const size_t k = i % per_step;
+                    snprintf(tmp, sizeof(tmp), "first mismatch: step %zu %s%zu[%zu] ref=%.9g fused=%.9g", i/per_step,
+                            k < (size_t) spec.n_units ? "y" : "q", k < (size_t) spec.n_units ? k : 0, e, ref[i][e], mk[i][e]);
+                } else {
+                    snprintf(tmp, sizeof(tmp), "first mismatch: cache_%c row %zu [%zu] ref=%.9g fused=%.9g", i == per_step*n_steps ? 'k' : 'v', e/n_kv, e%n_kv, ref[i][e], mk[i][e]);
+                }
+                first = tmp;
+            }
+            ok = false;
+        }
+    }
+    const bool perf_ok = us_mk <= 1.05*us_ref;
+    g_perf_fail += !perf_ok;
+    printf("glue  %-32s %s  ref %8.1f us  fused %8.1f us  (%d steps, proj=%s, glue=%s, CUDA graph replayed from step 2)%s\n", name,
+            ok ? "PASS" : "FAIL", us_ref, us_mk, n_steps, proj, mode, perf_ok ? "" : "  PERF FAIL (slower than the reference)");
+    if (!ok) {
+        printf("      max abs %.3g, %s\n", max_abs, first.c_str());
+    }
+    return ok;
+}
+
+// The relative-position bias table of one token (LLAMA_INKLING_MK_RELTAB=1): R [16 x 24] clipped per head (the model's
+// clip()), optionally scaled by tau, then PAD(table [16 x 1024], one zero row) x Rcur -> [1025 x 24]; the unfused graph
+// runs PAD, the CLIP fusion (or its 9 ops) and cublasSgemm; the fused kernel must give the same bits.
+static bool test_reltab(ggml_backend_t backend, const char * name, bool with_tau, int64_t n_ext) {
+    const int64_t n_rel = 16, n_head = 24;
+    std::vector<float> r(n_rel*n_head), wclip(n_rel*n_head), table(n_rel*n_ext);
+    for (float & v : r) {
+        v = 2.0f*frand();
+    }
+    for (float & v : wclip) {
+        v = 1.0f + 0.3f*frand();
+    }
+    for (float & v : table) {
+        v = 4.0f*frand();
+    }
+    const float tau_v = 1.7f;
+    return compare_stage("reltab", name, backend, { "table" }, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        ggml_tensor * tr   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_rel*n_head, 1);
+        ggml_tensor * tw   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_rel, n_head);
+        ggml_tensor * ttab = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_rel, n_ext);
+        ggml_set_input(tr);
+        data.emplace_back(tr, r.data());
+        data.emplace_back(tw, wclip.data());
+        data.emplace_back(ttab, table.data());
+        // inkling2.cpp clip()
+        ggml_tensor * cur  = ggml_mul(ctx, ggml_reshape_3d(ctx, tr, n_rel, n_head, 1), tw);
+        ggml_tensor * norm = ggml_sqrt(ctx, ggml_sum_rows(ctx, ggml_sqr(ctx, cur)));
+        norm = ggml_scale_bias(ctx, norm, 1.0f, 1e-6f);
+        ggml_tensor * factor = ggml_div(ctx, ggml_fill(ctx, norm, 10.0f), norm);
+        ggml_tensor * rcur = ggml_mul(ctx, cur, ggml_clamp(ctx, factor, 0.0f, 1.0f));
+        if (with_tau) {
+            ggml_tensor * tau = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, 1, 1);
+            data.emplace_back(tau, &tau_v);
+            rcur = ggml_mul(ctx, rcur, tau);
+        }
+        ggml_tensor * out = ggml_mul_mat(ctx, ggml_pad(ctx, ttab, 0, 1, 0, 0), rcur);
+        ggml_set_output(out);
+        ggml_build_forward_expand(gf, out);
+        outputs.push_back(out);
+    }, { { "LLAMA_INKLING_MK_RELTAB", "1" } }, UNFUSED);
+}
+
+// The MoE epilogue of one token (LLAMA_INKLING_MK_MOESCALE=1): the down products of the 8 used experts [2304, 8],
+// per-expert scales gathered from the table [1, 128] by the routed ids (REPEAT + GET_ROWS), times the router weights,
+// summed over the experts (the model's build_moe_ffn tail); the fused reduction gathers the scales itself.
+static bool test_moescale(ggml_backend_t backend, const char * name) {
+    const int64_t n_embd = 2304, n_used = 8, n_expert = 128;
+    std::vector<float> down(n_embd*n_used), table(n_expert), weights(n_used);
+    for (float & v : down) {
+        v = 2.0f*frand();
+    }
+    for (float & v : table) {
+        v = 0.5f + frand();
+    }
+    for (float & v : weights) {
+        v = 0.25f + 0.1f*frand();
+    }
+    int32_t ids[8];
+    for (int i = 0; i < n_used; ++i) {
+        ids[i] = (37*i + 5) % n_expert;
+    }
+    return compare_stage("moesc", name, backend, { "ffn_out" }, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        ggml_tensor * tdown = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_embd, n_used, 1);
+        ggml_tensor * ttab  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_expert);
+        ggml_tensor * tw    = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, n_used, 1);
+        ggml_tensor * tids  = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, 1);
+        ggml_set_input(tdown);
+        ggml_set_input(tids);
+        data.emplace_back(tdown, down.data());
+        data.emplace_back(ttab, table.data());
+        data.emplace_back(tw, weights.data());
+        data.emplace_back(tids, ids);
+        // llama-graph.cpp build_moe_ffn: the scale gather, the two MULs and the sum of the expert slices
+        ggml_tensor * scale = ggml_get_rows(ctx, ggml_repeat_4d(ctx, ggml_reshape_3d(ctx, ttab, 1, n_expert, 1), 1, n_expert, 1, 1), tids);
+        ggml_tensor * experts = ggml_mul(ctx, ggml_mul(ctx, tdown, scale), tw);
+        ggml_tensor * out = nullptr;
+        for (int e = 0; e < n_used; ++e) {
+            ggml_tensor * v = ggml_view_2d(ctx, experts, n_embd, 1, experts->nb[2], e*experts->nb[1]);
+            out = out ? ggml_add(ctx, out, v) : v;
+        }
+        ggml_set_output(out);
+        ggml_build_forward_expand(gf, out);
+        outputs.push_back(out);
+    }, { { "LLAMA_INKLING_MK_MOESCALE", "1" } }, UNFUSED);
+}
+
+// The SITU of the expert gate/up products for one token, gu [2304 = 2 x 1152, 8 slots]: with the per-expert scale gathered
+// by the routed ids (REPEAT + GET_ROWS + MUL, the chain of the IQ/Q*_K layers) or without it (the NVFP4 layers, whose
+// product kernel applies the scale: the chain starts at the gate view). The fusion is always on; compared against the
+// truly unfused ops.
+static bool test_situ(ggml_backend_t backend, const char * name, bool with_scale) {
+    const int64_t n_ff = 1152, n_used = 8, n_expert = 128;
+    std::vector<float> gu(2*n_ff*n_used), table(n_expert);
+    for (float & v : gu) {
+        v = 3.0f*frand();
+    }
+    for (float & v : table) {
+        v = 0.5f + frand();
+    }
+    int32_t ids[8];
+    for (int i = 0; i < n_used; ++i) {
+        ids[i] = (37*i + 5) % n_expert;
+    }
+    // inkling2_loop.activation: situ_beta 4, situ_linear_beta 25 (the SCALE pairs of the model's SITU)
+    return compare_stage("situ", name, backend, { "situ" }, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        ggml_tensor * tgu  = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 2*n_ff, n_used, 1);
+        ggml_set_input(tgu);
+        data.emplace_back(tgu, gu.data());
+        ggml_tensor * cur = tgu;
+        if (with_scale) {
+            ggml_tensor * ttab = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_expert);
+            ggml_tensor * tids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, 1);
+            ggml_set_input(tids);
+            data.emplace_back(ttab, table.data());
+            data.emplace_back(tids, ids);
+            ggml_tensor * scale = ggml_get_rows(ctx, ggml_repeat_4d(ctx, ggml_reshape_3d(ctx, ttab, 1, n_expert, 1), 1, n_expert, 1, 1), tids);
+            cur = ggml_mul(ctx, cur, scale);
+        }
+        ggml_tensor * gate = ggml_view_3d(ctx, cur, n_ff, n_used, 1, cur->nb[1], cur->nb[2], 0);
+        ggml_tensor * up   = ggml_view_3d(ctx, cur, n_ff, n_used, 1, cur->nb[1], cur->nb[2], n_ff*sizeof(float));
+        // llama-graph.cpp LLM_FFN_SITU: act = (b0*tanh(a0*g + a1) + b1) * sigmoid(g), lin = d0*tanh(c0*u + c1) + d1
+        ggml_tensor * act = ggml_scale_bias(ctx, ggml_tanh(ctx, ggml_scale_bias(ctx, gate, 4.0f, 0.0f)), 1.0f, 0.0f);
+        act = ggml_mul(ctx, act, ggml_sigmoid(ctx, gate));
+        ggml_tensor * lin = ggml_scale_bias(ctx, ggml_tanh(ctx, ggml_scale_bias(ctx, up, 1.0f/25.0f, 0.0f)), 25.0f, 0.0f);
+        ggml_tensor * out = ggml_mul(ctx, act, lin);
+        ggml_set_output(out);
+        ggml_build_forward_expand(gf, out);
+        outputs.push_back(out);
+    }, {}, UNFUSED);
+}
+
+// The gated attention output of one token before wo (LLAMA_INKLING_MK_WOQ=1): sigmoid(gate)*a quantized to q8_1 in one
+// launch and handed to the wo product; compared through the product against the unfused SIGMOID, MUL, quantize, mmvq
+static bool test_woq(ggml_backend_t backend, const char * name, ggml_type type, const char * gemv) {
+    const int64_t n_in = 3072, n_out = 2304;
+    const std::vector<uint8_t> w = random_weights(type, n_in, n_out);
+    std::vector<float> a(n_in), g(n_in);
+    for (int64_t i = 0; i < n_in; ++i) {
+        a[i] = 2.0f*frand();
+        g[i] = 8.0f*frand();
+    }
+    std::string label = std::string(name) + " gemv=" + gemv;
+    set_env("LLAMA_INKLING_GEMV", gemv);
+    const bool ok = compare_stage("woq", label.c_str(), backend, {"wo"}, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        ggml_tensor * ta = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_in);
+        ggml_tensor * tg = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_in);
+        ggml_tensor * tw = ggml_new_tensor_2d(ctx, type, n_in, n_out);
+        ggml_set_input(ta);
+        ggml_set_input(tg);
+        data.emplace_back(ta, a.data());
+        data.emplace_back(tg, g.data());
+        data.emplace_back(tw, w.data());
+        ggml_tensor * y = ggml_mul_mat(ctx, tw, ggml_mul(ctx, ta, ggml_sigmoid(ctx, tg)));
+        ggml_set_output(y);
+        ggml_build_forward_expand(gf, y);
+        outputs.push_back(y);
+    }, { { "LLAMA_INKLING_MK_WOQ", "1" } }, UNFUSED);
+    set_env("LLAMA_INKLING_GEMV", "0");
+    return ok;
+}
+
+// The Q/K/V epilogue of one token (LLAMA_INKLING_MK_QKV=1): Q clip(x*w) [* tau] and Hadamard rotation (f32 for the
+// attention), K clip and rotation into the q8_0 K cache row, V rms_norm and rotation of the 64-halves into the V cache
+// row; the model's node order (Q, K, V, then the two SET_ROWS). Compared against the unfused ops: dq and both cache tensors.
+static bool test_qkv(ggml_backend_t backend, const char * name, bool with_tau) {
+    const int64_t d = 128, n_head = 24, n_kv = 8, n_rows = 64;
+    std::vector<float> q(d*n_head), wq(d*n_head), k(d*n_kv), v(d*n_kv), rot_k(d*d), rot_v(d/2*d/2);
+    for (float & x : q) { x = 2.0f*frand(); }
+    for (float & x : wq) { x = 1.0f + 0.3f*frand(); }
+    for (float & x : k) { x = 2.0f*frand(); }
+    for (float & x : v) { x = 2.0f*frand(); }
+    for (float & x : rot_k) { x = frand(); } // the FWHT kernel ignores the matrix' values, the hint selects it
+    for (float & x : rot_v) { x = frand(); }
+    const float tau_v = 1.3f;
+    const int64_t row = 37;
+    std::string label = std::string(name);
+    return compare_stage("qkv", label.c_str(), backend, { "q_rot", "cache_k", "cache_v" }, [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+        ggml_tensor * tq  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d*n_head, 1);
+        ggml_tensor * twq = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d, n_head);
+        ggml_tensor * tk  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d*n_kv, 1);
+        ggml_tensor * tv  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d*n_kv, 1);
+        ggml_tensor * trk = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d, d);
+        ggml_tensor * trv = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d/2, d/2);
+        ggml_tensor * ck  = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, d*n_kv, n_rows);
+        ggml_tensor * cv  = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, d*n_kv, n_rows);
+        ggml_tensor * idx = ggml_new_tensor_1d(ctx, GGML_TYPE_I64, 1);
+        for (ggml_tensor * t : { tq, tk, tv, idx }) {
+            ggml_set_input(t);
+        }
+        data.emplace_back(tq, q.data());
+        data.emplace_back(twq, wq.data());
+        data.emplace_back(tk, k.data());
+        data.emplace_back(tv, v.data());
+        data.emplace_back(trk, rot_k.data());
+        data.emplace_back(trv, rot_v.data());
+        data.emplace_back(idx, &row);
+        auto clip = [&](ggml_tensor * cur, ggml_tensor * scale, float threshold) {
+            if (scale) {
+                cur = ggml_mul(ctx, cur, scale);
+            }
+            ggml_tensor * norm = ggml_sqrt(ctx, ggml_sum_rows(ctx, ggml_sqr(ctx, cur)));
+            norm = ggml_scale_bias(ctx, norm, 1.0f, 1e-6f);
+            ggml_tensor * factor = ggml_div(ctx, ggml_fill(ctx, norm, threshold), norm);
+            return ggml_mul(ctx, cur, ggml_clamp(ctx, factor, 0.0f, 1.0f));
+        };
+        auto rotate = [&](ggml_tensor * cur, ggml_tensor * rot) {
+            const int64_t n = rot->ne[0];
+            ggml_tensor * res = ggml_mul_mat(ctx, rot, ggml_reshape_2d(ctx, cur, n, ggml_nelements(cur)/n));
+            ggml_mul_mat_set_hint(res, GGML_HINT_SRC0_IS_HADAMARD);
+            return ggml_reshape_3d(ctx, res, cur->ne[0], cur->ne[1], cur->ne[2]);
+        };
+        ggml_tensor * qcur = clip(ggml_reshape_3d(ctx, tq, d, n_head, 1), twq, 10.0f);
+        if (with_tau) {
+            ggml_tensor * tau = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, 1, 1);
+            data.emplace_back(tau, &tau_v);
+            qcur = ggml_mul(ctx, qcur, tau);
+        }
+        ggml_tensor * kcur = clip(ggml_reshape_3d(ctx, tk, d, n_kv, 1), nullptr, 10.0f);
+        ggml_tensor * vcur = ggml_rms_norm(ctx, ggml_reshape_3d(ctx, tv, d, n_kv, 1), 1e-6f);
+        ggml_tensor * qrot = rotate(qcur, trk);
+        ggml_tensor * krot = rotate(kcur, trk);
+        ggml_tensor * vrot = rotate(vcur, trv);
+        ggml_tensor * sk = ggml_set_rows(ctx, ck, ggml_reshape_2d(ctx, krot, d*n_kv, 1), idx);
+        ggml_tensor * sv = ggml_set_rows(ctx, cv, ggml_reshape_2d(ctx, vrot, d*n_kv, 1), idx);
+        ggml_set_output(qrot);
+        ggml_set_output(ck);
+        ggml_set_output(cv);
+        ggml_build_forward_expand(gf, qrot);
+        ggml_build_forward_expand(gf, sk);
+        ggml_build_forward_expand(gf, sv);
+        outputs.push_back(qrot);
+        outputs.push_back(ck);
+        outputs.push_back(cv);
+    }, { { "LLAMA_INKLING_MK_QKV", "1" } }, UNFUSED);
+}
+
+int main(int argc, char ** argv) {
+    for (int a = 1; a + 1 < argc; a += 2) {
+        if (std::string(argv[a]) == "-t") {
+            g_filter = argv[a + 1];
+        }
+    }
+    set_env("LLAMA_INKLING_MK_TEST", "1"); // the backend reads LLAMA_INKLING_MK_REF on every call
+    ggml_backend_load_all();
+
+    int n_fail = 0, n_run = 0;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            continue;
+        }
+        ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+        GGML_ASSERT(backend);
+        printf("== %s\n", ggml_backend_name(backend));
+        const auto check = [&](bool ok) { n_fail += !ok; n_run++; };
+
+        // the attention projections of a layer application: Q [2304 x 3072], R [2304 x 384], K/V [2304 x 1024],
+        // gate [2304 x 3072]; one input for a SWA pass-1 layer, three (Q/R/gate, K, V) for a loop pass or full layer
+        const std::vector<proj_spec> core1 = { {"q", GGML_TYPE_Q8_0, 3072, 0}, {"r", GGML_TYPE_Q8_0, 384, 0}, {"k", GGML_TYPE_Q8_0, 1024, 0}, {"v", GGML_TYPE_Q8_0, 1024, 0}, {"gate", GGML_TYPE_Q8_0, 3072, 0} };
+        const std::vector<proj_spec> core3 = { {"q", GGML_TYPE_Q8_0, 3072, 0}, {"r", GGML_TYPE_Q8_0, 384, 0}, {"k", GGML_TYPE_Q8_0, 1024, 1}, {"v", GGML_TYPE_Q8_0, 1024, 2}, {"gate", GGML_TYPE_Q8_0, 3072, 0} };
+        for (const char * sw : { "LLAMA_INKLING_MK_PROJ" }) {
+            check(test_proj(backend, "core q8_0, one input", sw, 1, core1));
+            check(test_proj(backend, "core q8_0, three inputs", sw, 3, core3));
+            check(test_proj(backend, "layer 18 (q6_K, q8_0)", sw, 3, { {"q", GGML_TYPE_Q6_K, 3072, 0}, {"r", GGML_TYPE_Q8_0, 384, 0}, {"k", GGML_TYPE_Q6_K, 1024, 1}, {"v", GGML_TYPE_Q8_0, 1024, 2}, {"gate", GGML_TYPE_Q6_K, 3072, 0} }));
+            check(test_proj(backend, "layer 20 (q5_K, q6_K, q8_0)", sw, 3, { {"q", GGML_TYPE_Q5_K, 3072, 0}, {"r", GGML_TYPE_Q6_K, 384, 0}, {"k", GGML_TYPE_Q5_K, 1024, 1}, {"v", GGML_TYPE_Q8_0, 1024, 2}, {"gate", GGML_TYPE_Q5_K, 3072, 0} }));
+            check(test_proj(backend, "layer 22 (q4_K, q5_K, q6_K)", sw, 3, { {"q", GGML_TYPE_Q4_K, 3072, 0}, {"r", GGML_TYPE_Q5_K, 384, 0}, {"k", GGML_TYPE_Q4_K, 1024, 1}, {"v", GGML_TYPE_Q6_K, 1024, 2}, {"gate", GGML_TYPE_Q5_K, 3072, 0} }));
+            check(test_proj(backend, "two products", sw, 1, { {"q", GGML_TYPE_Q8_0, 3072, 0}, {"gate", GGML_TYPE_Q8_0, 3072, 0} }));
+            // pool stress: eight products, eight distinct inputs
+            check(test_proj(backend, "eight products, eight inputs", sw, 8, { {"a", GGML_TYPE_Q8_0, 3072, 0}, {"b", GGML_TYPE_Q8_0, 384, 1}, {"c", GGML_TYPE_Q8_0, 1024, 2}, {"d", GGML_TYPE_Q8_0, 1024, 3}, {"e", GGML_TYPE_Q8_0, 3072, 4}, {"f", GGML_TYPE_Q4_K, 2304, 5}, {"g", GGML_TYPE_Q6_K, 32, 6}, {"h", GGML_TYPE_Q8_0, 32, 7} }));
+            check(test_proj(backend, "eight products, shared inputs", sw, 2, { {"a", GGML_TYPE_Q8_0, 3072, 0}, {"b", GGML_TYPE_Q8_0, 384, 1}, {"c", GGML_TYPE_Q8_0, 1024, 0}, {"d", GGML_TYPE_Q8_0, 1024, 1}, {"e", GGML_TYPE_Q8_0, 3072, 0}, {"f", GGML_TYPE_Q4_K, 2304, 1}, {"g", GGML_TYPE_Q6_K, 32, 0}, {"h", GGML_TYPE_Q8_0, 32, 1} }));
+        }
+        // the variant with separate quantize launches (MK_PROJ=2) on the pool-stress case: toggled through its own value
+        if (case_selected("proj2 four inputs, quantize launches")) {
+            set_env("LLAMA_INKLING_MK_PROJ", "0");
+            const int64_t n_embd = 2304;
+            std::vector<std::vector<uint8_t>> weights;
+            std::vector<proj_spec> mats = { {"a", GGML_TYPE_Q8_0, 3072, 0}, {"b", GGML_TYPE_Q8_0, 1024, 1}, {"c", GGML_TYPE_Q6_K, 1024, 2}, {"d", GGML_TYPE_Q8_0, 3072, 3} };
+            for (const proj_spec & m : mats) {
+                weights.push_back(random_weights(m.type, n_embd, m.rows));
+            }
+            std::vector<std::vector<float>> inputs(4, std::vector<float>(n_embd));
+            for (auto & in : inputs) {
+                for (float & v : in) {
+                    v = 2.0f*frand();
+                }
+            }
+            const auto build = [&](ggml_context * ctx, ggml_cgraph * gf, std::vector<ggml_tensor *> & outputs, std::vector<std::pair<ggml_tensor *, const void *>> & data) {
+                std::vector<ggml_tensor *> x(4);
+                for (int k = 0; k < 4; ++k) {
+                    x[k] = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+                    ggml_set_input(x[k]);
+                    data.emplace_back(x[k], inputs[k].data());
+                }
+                for (size_t k = 0; k < mats.size(); ++k) {
+                    ggml_tensor * w = ggml_new_tensor_2d(ctx, mats[k].type, n_embd, mats[k].rows);
+                    data.emplace_back(w, weights[k].data());
+                    ggml_tensor * y = ggml_mul_mat(ctx, w, x[mats[k].input]);
+                    ggml_set_output(y);
+                    ggml_build_forward_expand(gf, y);
+                    outputs.push_back(y);
+                }
+            };
+            const graph_run ref = run_graph(backend, 50, build);
+            set_env("LLAMA_INKLING_MK_PROJ", "2");
+            const graph_run mk = run_graph(backend, 50, build);
+            set_env("LLAMA_INKLING_MK_PROJ", "0");
+            bool ok = true;
+            for (size_t k = 0; k < ref.outputs.size(); ++k) {
+                ok = ok && ref.outputs[k] == mk.outputs[k];
+            }
+            printf("%-5s %-32s %s  ref %8.1f us  fused %8.1f us\n", "proj2", "four inputs, quantize launches", ok ? "PASS" : "FAIL", ref.us, mk.us);
+            check(ok);
+        }
+
+        // regression for the 3090 repetition loop with MK_PROJ=1 (iteration 2): decode steps with cache writes
+        check(test_steps(backend, "pass-1 layer, q8_0, 6 steps", 1, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, 6));
+        check(test_steps(backend, "loop layer, 3 inputs, q8_0", 3, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, 6));
+        check(test_steps(backend, "tail layer, q6_K/q5_K, 3 inputs", 3, GGML_TYPE_Q6_K, GGML_TYPE_Q5_K, 6));
+
+        // the relative-position bias table: SWA layer (1024 + 1 bins), full-attention layer (tau), both vs the unfused
+        // PAD + clip ops + cuBLAS; also the fused kernel against the backend's own fusions (CLIP) + cuBLAS
+        check(test_qkv(backend, "q/k/v epilogue, SWA layer", false));
+        check(test_qkv(backend, "q/k/v epilogue, full layer (tau)", true));
+        for (const char * gemv : { "0", "1" }) {
+            check(test_woq(backend, "wo q8_0 gated input quantized once", GGML_TYPE_Q8_0, gemv));
+            check(test_woq(backend, "wo q6_K gated input quantized once", GGML_TYPE_Q6_K, gemv));
+        }
+        check(test_situ(backend, "situ with the scale gather", true));
+        check(test_situ(backend, "situ without scale (nvfp4)",  false));
+        check(test_moescale(backend, "moe epilogue, scale gather"));
+        check(test_reltab(backend, "reltab swa 1025 bins",            false, 1024));
+        check(test_reltab(backend, "reltab full layer with tau",      true,  1024));
+        check(test_wo(backend, "wo q8_0 with sigmoid gate", GGML_TYPE_Q8_0));
+        check(test_wo(backend, "wo q6_K with sigmoid gate", GGML_TYPE_Q6_K));
+
+        // the glue stage, each layer kind with the projections quantizing their inputs (proj=0) and reading the glue's
+        // q8_1 through the fused projection run (proj=1); independent of the MK_PROJ result itself (the reference of
+        // each line runs with the same MK_PROJ value)
+        // the backend's own fusions of these chains (CTRL_DOWN/CTRL_OUT, MIX, RMS_NORM+MUL) against the unfused graph:
+        // the glue replicates the unfused kernels, so a FAIL here locates a pre-existing fusion that is not bit-exact
+        // determinism of the reference itself: the unfused graph against itself (two separate runs)
+        check(test_glue_attn(backend, "unfused twice: 3 ctrl + norms",   { 3, true },     GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, "0", "u"));
+        check(test_glue_attn(backend, "fusions twice: 3 ctrl + norms",   { 3, true },     GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, "0", "F"));
+        check(test_glue_attn(backend, "glue twice: 3 ctrl + norms",      { 3, true },     GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, "0", "G"));
+        // the controller intermediates exposed: which of CTRL_DOWN (h) and CTRL_OUT (out) differs from the unfused ops
+        g_expose_ctrl = true;
+        check(test_glue_attn(backend, "fusions: ctrl intermediates",    { 3, true },     GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, "0", "f"));
+        g_expose_ctrl = false;
+        check(test_glue_attn(backend, "fusions: 3 ctrl + norms",        { 3, true },     GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, "0", "f"));
+        check(test_glue_attn(backend, "fusions: 3 norms",               { 3, false },    GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, "0", "f"));
+        check(test_glue_attn(backend, "fusions: mix 4 + 3 ctrl + norms",{ 3, true, 4 },  GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, "0", "f"));
+        check(test_glue_attn(backend, "fusions: mix 8 + 3 norms",       { 3, false, 8 }, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, "0", "f"));
+        check(test_glue_ffn(backend,  "fusions: ffn ctrl + norm",       true,  GGML_TYPE_Q8_0, "0", "f"));
+        for (const char * proj : { "0", "1" }) {
+            check(test_glue_attn(backend, "loop pass: 3 ctrl + norms, q8_0", { 3, true },  GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj));
+            check(test_glue_attn(backend, "pass-1 SWA layer: 1 norm, q8_0",  { 1, false }, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj));
+            check(test_glue_attn(backend, "full layer: 3 norms, q8_0",       { 3, false }, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj));
+            check(test_glue_attn(backend, "tail layer: 3 norms, q6_K/q5_K",  { 3, false }, GGML_TYPE_Q6_K, GGML_TYPE_Q5_K, proj));
+            check(test_glue_attn(backend, "tail layer: 1 norm, q4_K/q6_K",   { 1, false }, GGML_TYPE_Q4_K, GGML_TYPE_Q6_K, proj));
+            check(test_glue_ffn(backend,  "ffn loop pass: ctrl + norm",      true,  GGML_TYPE_Q8_0, proj));
+            check(test_glue_ffn(backend,  "ffn pass-1: norm",                false, GGML_TYPE_Q8_0, proj));
+            check(test_glue_steps(backend, "loop pass, 3 ctrl, 6 steps",    { 3, true },  6, proj));
+            check(test_glue_steps(backend, "full layer, 3 norms, 6 steps",  { 3, false }, 6, proj));
+            // the depth mix folded in (even state counts: exact); odd counts keep the separate MIX kernel (not bit-exact
+            // for the unfused cuBLAS path), so the glue takes its output as before
+            check(test_glue_attn(backend, "mix 4 states + 3 ctrl + norms",   { 3, true,  4 },    GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj));
+            check(test_glue_attn(backend, "mix 8 states + 3 norms",          { 3, false, 8 },    GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj));
+            check(test_glue_attn(backend, "mix 2 states, 1 query, 1 norm",   { 1, false, 2, 1 }, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj));
+            check(test_glue_attn(backend, "mix 1 query, 3 ctrl (SWA loop)",  { 3, true,  6, 1 }, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj));
+            // an odd state count keeps the backend's MIX fusion apart from the glue; that fusion is not bit-exact against
+            // the unfused cuBLAS path by design (inkling2.cu header), so this case compares against the fused reference
+            check(test_glue_attn(backend, "mix 3 states (odd: MIX apart)",   { 3, false, 3 },    GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj, "1f"));
+            check(test_glue_ffn(backend,  "ffn mix 4 states + ctrl + norm",  true,  GGML_TYPE_Q8_0, proj, "1", 4));
+            check(test_glue_steps(backend, "mix 4 + 3 ctrl, 6 steps",       { 3, true,  4 },    6, proj));
+            // LLAMA_INKLING_MK_GLUE=2: the controller instances as one cooperative kernel (grid barrier between phases)
+            check(test_glue_attn(backend, "loop pass: 3 ctrl + norms, q8_0", { 3, true },  GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj, "2"));
+            check(test_glue_ffn(backend,  "ffn loop pass: ctrl + norm",      true,  GGML_TYPE_Q8_0, proj, "2"));
+            check(test_glue_steps(backend, "loop pass, 3 ctrl, 6 steps",    { 3, true },  6, proj, "2"));
+            check(test_glue_attn(backend, "mix 4 states + 3 ctrl + norms",   { 3, true, 4 }, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, proj, "2"));
+        }
+
+        // experts: gate_up [2304 -> 2304] (the token is every slot's input), down [1152 -> 2304] (one input per slot)
+        for (ggml_type type : { GGML_TYPE_NVFP4, GGML_TYPE_IQ3_XXS, GGML_TYPE_IQ3_S, GGML_TYPE_IQ2_S, GGML_TYPE_Q3_K }) {
+            check(test_moe(backend, (std::string("gate_up ") + ggml_type_name(type)).c_str(), type, 2304, 2304, false));
+        }
+        for (ggml_type type : { GGML_TYPE_NVFP4, GGML_TYPE_IQ4_NL }) {
+            check(test_moe(backend, (std::string("down ") + ggml_type_name(type)).c_str(), type, 1152, 2304, true));
+        }
+        ggml_backend_free(backend);
+    }
+    if (n_run == 0) {
+        printf("no non-CPU backend: nothing to compare\n");
+    }
+    printf("%d of %d cases failed, %d slower than the reference\n", n_fail, n_run, g_perf_fail);
+    return n_fail == 0 ? 0 : 1;
+}
diff --git a/tests/test-sched-streams.cpp b/tests/test-sched-streams.cpp
new file mode 100644
index 000000000..ed790f54e
--- /dev/null
+++ b/tests/test-sched-streams.cpp
@@ -0,0 +1,167 @@
+// Runs a small-batch graph with many independent chains (a decode-like block: norm, sibling projections, in-place
+// cache writes, joins) through ggml_backend_sched on every backend and compares with the CPU. The CUDA backend's
+// GGML_CUDA_GRAPH_OPT=2 stream plan reorders nothing but runs the chains on several streams: this checks that the
+// cross-stream dependencies, the window joins and the pinned allocations give the sequential result.
+//
+//   GGML_CUDA_GRAPH_OPT=2 GGML_CUDA_GRAPH_OPT_DEBUG=1 ./test-sched-streams
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+static float frand(uint32_t & state) {
+    state = state*1664525u + 1013904223u;
+    return float(state >> 8)/float(1u << 24) - 0.5f;
+}
+
+struct block_weights {
+    ggml_tensor * norm;
+    ggml_tensor * w[6];
+    ggml_tensor * cache; // [n_embd, n_cells], written in place by the block and read back
+};
+
+// one block: h = rms_norm(x)*norm; six projections of h on independent chains; two of them written into the cache and
+// read back through views; the chains join into the block output x + sum(...)
+static ggml_tensor * build_block(ggml_context * ctx, ggml_tensor * x, const block_weights & bw, int cell) {
+    const int64_t n_embd = x->ne[0];
+    ggml_tensor * h = ggml_mul(ctx, ggml_rms_norm(ctx, x, 1e-6f), bw.norm);
+
+    ggml_tensor * p[6];
+    for (int i = 0; i < 6; ++i) {
+        p[i] = ggml_mul_mat(ctx, bw.w[i], h);
+    }
+    // chains of different lengths
+    ggml_tensor * a = ggml_mul(ctx, ggml_sigmoid(ctx, p[0]), p[1]);
+    ggml_tensor * b = ggml_scale(ctx, ggml_tanh(ctx, ggml_scale(ctx, p[2], 0.1f)), 10.0f);
+    // the cache: p[3] is stored in cell `cell`, p[4] in cell + 1, and both are read back (write-after-read hazards
+    // with the reads of the previous block, read-after-write within this one)
+    // (the first token's column of each)
+    ggml_tensor * store3 = ggml_cpy(ctx, ggml_view_1d(ctx, p[3], n_embd, 0), ggml_view_1d(ctx, bw.cache, n_embd, (cell    )*bw.cache->nb[1]));
+    ggml_tensor * store4 = ggml_cpy(ctx, ggml_view_1d(ctx, p[4], n_embd, 0), ggml_view_1d(ctx, bw.cache, n_embd, (cell + 1)*bw.cache->nb[1]));
+    ggml_tensor * window = ggml_view_2d(ctx, bw.cache, n_embd, 2, bw.cache->nb[1], cell*bw.cache->nb[1]);
+    ggml_tensor * c = ggml_sum_rows(ctx, ggml_cont(ctx, ggml_transpose(ctx, window))); // [2, 1] -> per cell sums
+    // make the reads depend on the stores explicitly, as the KV cache graph does
+    c = ggml_add(ctx, c, ggml_sum_rows(ctx, ggml_reshape_2d(ctx, store3, n_embd, 1)));
+    c = ggml_add(ctx, c, ggml_sum_rows(ctx, ggml_reshape_2d(ctx, store4, n_embd, 1)));
+    ggml_tensor * d = ggml_mul(ctx, ggml_silu(ctx, p[5]), ggml_repeat(ctx, ggml_view_1d(ctx, c, 1, 0), p[5]));
+
+    ggml_tensor * out = ggml_add(ctx, x, a);
+    out = ggml_add(ctx, out, b);
+    out = ggml_add(ctx, out, d);
+    return ggml_scale(ctx, out, 0.5f);
+}
+
+static std::vector<float> run(ggml_backend_t backend, ggml_backend_t cpu, int n_embd, int n_blocks, int n_tokens, uint32_t seed) {
+    const int n_tensors = 16 + n_blocks*64;
+    ggml_context * ctx_w = ggml_init({ggml_tensor_overhead()*(size_t) (8*n_blocks + 8), nullptr, true});
+    ggml_context * ctx   = ggml_init({ggml_tensor_overhead()*(size_t) n_tensors + ggml_graph_overhead_custom(n_tensors, false), nullptr, true});
+
+    std::vector<block_weights> bws(n_blocks);
+    for (int l = 0; l < n_blocks; ++l) {
+        bws[l].norm  = ggml_new_tensor_1d(ctx_w, GGML_TYPE_F32, n_embd);
+        for (int i = 0; i < 6; ++i) {
+            bws[l].w[i] = ggml_new_tensor_2d(ctx_w, GGML_TYPE_F16, n_embd, n_embd);
+        }
+        bws[l].cache = ggml_new_tensor_2d(ctx_w, GGML_TYPE_F32, n_embd, 8);
+    }
+    ggml_backend_buffer_t buf_w = ggml_backend_alloc_ctx_tensors(ctx_w, backend);
+    GGML_ASSERT(buf_w);
+
+    uint32_t state = seed;
+    std::vector<float>       f32(n_embd*n_embd);
+    std::vector<ggml_fp16_t> f16(n_embd*n_embd);
+    for (int l = 0; l < n_blocks; ++l) {
+        for (int i = 0; i < n_embd; ++i) {
+            f32[i] = 1.0f + 0.1f*frand(state);
+        }
+        ggml_backend_tensor_set(bws[l].norm, f32.data(), 0, n_embd*sizeof(float));
+        for (int w = 0; w < 6; ++w) {
+            for (int i = 0; i < n_embd*n_embd; ++i) {
+                f16[i] = ggml_fp32_to_fp16(frand(state)/sqrtf(float(n_embd)));
+            }
+            ggml_backend_tensor_set(bws[l].w[w], f16.data(), 0, f16.size()*sizeof(ggml_fp16_t));
+        }
+        std::fill(f32.begin(), f32.end(), 0.0f);
+        ggml_backend_tensor_set(bws[l].cache, f32.data(), 0, ggml_nbytes(bws[l].cache));
+    }
+
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tokens);
+    ggml_set_input(x);
+    ggml_tensor * cur = x;
+    for (int l = 0; l < n_blocks; ++l) {
+        cur = build_block(ctx, cur, bws[l], 2*(l % 3));
+    }
+    ggml_set_output(cur);
+    ggml_cgraph * gf = ggml_new_graph_custom(ctx, n_tensors, false);
+    ggml_build_forward_expand(gf, cur);
+
+    ggml_backend_t backends[2] = { backend, cpu };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, nullptr, backend == cpu ? 1 : 2, ggml_graph_n_nodes(gf) + 64, false, true);
+    GGML_ASSERT(ggml_backend_sched_alloc_graph(sched, gf));
+
+    std::vector<float> input(n_embd*n_tokens);
+    for (float & v : input) {
+        v = frand(state);
+    }
+    ggml_backend_tensor_set(x, input.data(), 0, input.size()*sizeof(float));
+
+    // twice: the second run reuses the allocation and, on CUDA, replays the captured graph; the cache is state, so
+    // it is cleared again in between
+    std::vector<float> out(n_embd*n_tokens), out2(n_embd*n_tokens);
+    GGML_ASSERT(ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS);
+    ggml_backend_tensor_get(cur, out.data(), 0, out.size()*sizeof(float));
+    ggml_backend_tensor_set(x, input.data(), 0, input.size()*sizeof(float));
+    std::fill(f32.begin(), f32.end(), 0.0f);
+    for (int l = 0; l < n_blocks; ++l) {
+        ggml_backend_tensor_set(bws[l].cache, f32.data(), 0, ggml_nbytes(bws[l].cache));
+    }
+    GGML_ASSERT(ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS);
+    ggml_backend_tensor_get(cur, out2.data(), 0, out2.size()*sizeof(float));
+    for (size_t i = 0; i < out.size(); ++i) {
+        GGML_ASSERT(std::isfinite(out[i]));
+        GGML_ASSERT(out[i] == out2[i] && "the second run differs from the first");
+    }
+
+    ggml_backend_sched_free(sched);
+    ggml_backend_buffer_free(buf_w);
+    ggml_free(ctx);
+    ggml_free(ctx_w);
+    return out;
+}
+
+int main() {
+    ggml_backend_load_all();
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    GGML_ASSERT(cpu);
+
+    int n_fail = 0;
+    for (int n_tokens : {1, 4}) {
+        const std::vector<float> ref = run(cpu, cpu, 256, 6, n_tokens, 12345u);
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                continue;
+            }
+            ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+            GGML_ASSERT(backend);
+            const std::vector<float> out = run(backend, cpu, 256, 6, n_tokens, 12345u);
+            double max_err = 0.0, max_ref = 0.0;
+            for (size_t k = 0; k < out.size(); ++k) {
+                max_err = std::max(max_err, (double) fabsf(out[k] - ref[k]));
+                max_ref = std::max(max_ref, (double) fabsf(ref[k]));
+            }
+            const bool ok = max_err <= 1e-3*std::max(1.0, max_ref);
+            printf("%s: n_tokens=%d, max |out| = %g, max error vs CPU = %g: %s\n", ggml_backend_name(backend), n_tokens, max_ref, max_err, ok ? "OK" : "FAIL");
+            n_fail += !ok;
+            ggml_backend_free(backend);
+        }
+    }
+    ggml_backend_free(cpu);
+    return n_fail == 0 ? 0 : 1;
+}
