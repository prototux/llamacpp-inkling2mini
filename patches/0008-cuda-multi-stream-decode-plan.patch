diff --git a/ggml/src/ggml-cuda/graph.cuh b/ggml/src/ggml-cuda/graph.cuh
index 7b9c27789..5275a0dbc 100644
--- a/ggml/src/ggml-cuda/graph.cuh
+++ b/ggml/src/ggml-cuda/graph.cuh
@@ -212,10 +212,65 @@ struct ggml_cuda_concurrent_event {
     }
 };
 
+// GGML_CUDA_GRAPH_OPT=2: a stream assignment for every compute node of the graph (ggml_cuda_stream_plan_build).
+// Independent chains run on side streams; a node waits on the events of its predecessors on other streams; a window
+// (from the first side-stream node to the node where every side chain has been consumed) ends with the main stream
+// waiting on all side streams, and keeps all its tensors allocated until then so that concurrent nodes never alias.
+struct ggml_cuda_stream_plan_node {
+    int  stream       = 0;     // 0: the main stream
+    bool window_start = false; // record the fork event on the main stream before this node, side streams wait on it
+    bool window_end   = false; // after this node the main stream waits on the side streams used by the window
+    int  window_streams = 0;   // side streams the window uses (window_start and window_end nodes)
+    cudaEvent_t event = nullptr; // recorded on the node's stream right after its launch
+    std::vector<const ggml_tensor *> waits; // predecessors on other streams
+};
+
+struct ggml_cuda_stream_plan {
+    std::unordered_map<const ggml_tensor *, ggml_cuda_stream_plan_node> nodes;
+    int n_streams = 0; // side streams
+    cudaEvent_t fork_event = nullptr;
+    std::vector<cudaEvent_t> join_events;
+
+    // events are reused across plans: a plan is rebuilt whenever the graph changes
+    std::vector<cudaEvent_t> event_pool;
+    size_t n_events_used = 0;
+
+    bool active() const { return !nodes.empty(); }
+
+    cudaEvent_t next_event() {
+        if (n_events_used == event_pool.size()) {
+            cudaEvent_t e;
+            CUDA_CHECK(cudaEventCreateWithFlags(&e, cudaEventDisableTiming));
+            event_pool.push_back(e);
+        }
+        return event_pool[n_events_used++];
+    }
+
+    void clear() {
+        nodes.clear();
+        n_events_used = 0;
+        n_streams = 0;
+    }
+
+    ~ggml_cuda_stream_plan() {
+        for (cudaEvent_t e : event_pool) {
+            CUDA_CHECK(cudaEventDestroy(e));
+        }
+        if (fork_event) {
+            CUDA_CHECK(cudaEventDestroy(fork_event));
+        }
+        for (cudaEvent_t e : join_events) {
+            CUDA_CHECK(cudaEventDestroy(e));
+        }
+    }
+};
+
 struct ggml_cuda_stream_context {
     std::unordered_map<const ggml_tensor *, ggml_cuda_concurrent_event> concurrent_events;
+    ggml_cuda_stream_plan plan;
 
     void reset() {
         concurrent_events.clear();
+        plan.clear();
     }
 };
