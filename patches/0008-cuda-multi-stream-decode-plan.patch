+// the launch; shadow_k/shadow_v (MK_CHECK) replace the cache rows by scratch rows at index 0
+static void inkling2_qkv(ggml_backend_cuda_context & ctx, const ggml_cuda_inkling2_args & args, char * shadow_k = nullptr, char * shadow_v = nullptr) {
+    const ggml_tensor * xq = args.src[0];
+    const ggml_tensor * wq = args.src[1];
+    const ggml_tensor * xk = args.src[2];
+    const ggml_tensor * xv = args.src[3];
+    const ggml_tensor * tau = args.node[0];
+    const ggml_tensor * store_k = args.node[5];
+    const ggml_tensor * store_v = args.extra[3];
+
+    inkling2_qkv_args a = {};
+    a.xq = (const float *) xq->data; a.wq = (const float *) wq->data; a.wq_s1 = (int64_t) (wq->nb[1]/sizeof(float)); a.wq_ne1 = wq->ne[1];
+    a.tau = tau ? (const float *) tau->data : nullptr; a.dq = (float *) args.dst->data;
+    a.q_s0 = ggml_get_op_params_f32(args.node[1], 0); a.q_s1 = ggml_get_op_params_f32(args.node[1], 1);
+    a.q_c  = ggml_get_op_params_f32(args.node[2], 0); a.q_lo = ggml_get_op_params_f32(args.node[3], 0); a.q_hi = ggml_get_op_params_f32(args.node[3], 1);
+    a.xk = (const float *) xk->data;
+    a.k_s0 = ggml_get_op_params_f32(args.extra[0], 0); a.k_s1 = ggml_get_op_params_f32(args.extra[0], 1);
+    a.k_c  = ggml_get_op_params_f32(args.extra[1], 0); a.k_lo = ggml_get_op_params_f32(args.extra[2], 0); a.k_hi = ggml_get_op_params_f32(args.extra[2], 1);
+    a.ck = shadow_k ? shadow_k : (char *) store_k->data; a.ck_s1 = (int64_t) store_k->nb[1]; a.idx_k = shadow_k ? nullptr : store_k->src[1]->data;
+    a.xv = (const float *) xv->data; a.v_eps = ggml_get_op_params_f32(args.node[4], 0);
+    a.cv = shadow_v ? shadow_v : (char *) store_v->data; a.cv_s1 = (int64_t) store_v->nb[1]; a.idx_v = shadow_v ? nullptr : store_v->src[1]->data;
+    a.idx_i64 = store_k->src[1]->type == GGML_TYPE_I64;
+    a.n_head = (int) args.dst->ne[1]; a.n_kv = (int) xk->ne[1];
+    a.scale_q = 1.0f / sqrtf((float) INKLING2_QKV_D); a.scale_k = a.scale_q; a.scale_v = 1.0f / sqrtf((float) (INKLING2_QKV_D/2));
+    a.debug = getenv("LLAMA_INKLING_MK_DEBUG") != nullptr;
+
+    const ggml_cuda_kernel_launch_params params(dim3(a.n_head + 2*a.n_kv, 1, 1), dim3(INKLING2_QKV_BLOCK, 1, 1), 0, ctx.stream());
+    ggml_cuda_kernel_launch(inkling2_qkv_f32, params, a);
+}
