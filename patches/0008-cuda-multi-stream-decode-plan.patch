+    // loader gives ~1
+    const double nmse = err2/std::max(ref2, 1e-30);
+    const bool ok = nmse < 5e-4;
+    printf("%s: inkling dims, kv=%s, queries=%d, cells=%d, window=%d: nmse=%.3g max abs error=%.3g %s\n",
+            ggml_backend_name(backend), ggml_type_name(kv_type), n_query, cells, window, nmse, max_err, ok ? "OK" : "FAIL");
+    GGML_ASSERT(ok);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+}
+
 int main() {
     ggml_backend_load_all();
     for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
@@ -195,6 +356,15 @@ int main() {
                 test_indexed_bias(backend, width, false, n_query, 1024, GGML_TYPE_Q4_0, true);
             }
         }
+        // the real shapes with random K/V, expected from ggml's dequantization: decode (vec), DSpark verify, prefill
+        // (tile/MMA with the in-place q8_0/q4_0 loaders), masked and maskless, full-attention and SWA windows
+        for (ggml_type kv_type : {GGML_TYPE_F16, GGML_TYPE_Q8_0, GGML_TYPE_Q4_0}) {
+            for (int n_query : {1, 4, 128, 512}) {
+                test_inkling_dims(backend, kv_type, n_query, 2048, -1);
+                test_inkling_dims(backend, kv_type, n_query, 2048, 0);
+                test_inkling_dims(backend, kv_type, n_query, 2048, 1024);
+            }
+        }
