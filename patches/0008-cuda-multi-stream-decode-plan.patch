+static bool ggml_cuda_stream_plan_debug() {
+    static const bool enabled = getenv("GGML_CUDA_GRAPH_OPT_DEBUG") != nullptr;
+    return enabled;
+}
+
+// Builds the stream plan of a graph (GGML_CUDA_GRAPH_OPT=2), for graphs whose nodes have at most 512 rows (decode and
+// small speculative batches, where the per-kernel launch latency dominates; a prefill ubatch has thousands):
+//
+// 1. dependencies between compute nodes by the root tensor of every src and output (views resolved), including the
+//    write-after-read and write-after-write hazards of nodes that write into existing memory (KV cache, states);
+// 2. streams: a node continues the chain of a predecessor that is still the tail of its stream; a MUL_MAT or
+//    MUL_MAT_ID whose predecessor has already been continued (a sibling, e.g. the K and V projections next to Q) takes
+//    a free side stream; everything else joins the stream of one of its predecessors. Chains thus stay on one stream
+//    and the fusions of graph_compute keep matching them;
+// 3. a node waits on the events of its predecessors on other streams (one event per compute node, recorded after
+//    its launch); a window opens at the first side-stream node (the main stream records a fork event the side streams
+//    wait on, so nothing of the window starts before the preceding main-stream work) and closes at the first
+//    main-stream node after which every side chain has been consumed: there the main stream waits on all side streams;
+// 4. every tensor read or written in a window is kept allocated until the window ends (add_alloc_dep): the allocator
+//    plans for the sequential order, and without this a node of one stream could reuse the memory a concurrent node
+//    of another stream still reads.
+static void ggml_cuda_stream_plan_build(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, ggml_backend_graph_optimize_params * params) {
+    ggml_cuda_stream_plan & plan = cuda_ctx->stream_context().plan;
+    plan.clear();
+
+    static const int n_side = [] {
+        const char * env = getenv("GGML_CUDA_GRAPH_OPT_STREAMS");
+        const int n = env != nullptr ? atoi(env) : 3;
+        return std::max(1, std::min(n, GGML_CUDA_MAX_STREAMS - 1));
+    }();
+
+    // the compute nodes, in graph order
+    std::vector<int> cn;
+    cn.reserve(cgraph->n_nodes);
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (ggml_cuda_is_view_or_noop(node) || (node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        if (ggml_nrows(node) > 512) {
+            return; // a prefill graph: large kernels, nothing to hide, and the pinned tensors would be large
+        }
+        cn.push_back(i);
+    }
+    const int n = (int) cn.size();
+    if (n < 8) {
+        return;
+    }
+
+    const auto root = [](const ggml_tensor * t) { return t->view_src ? t->view_src : t; };
+
+    // 1. dependencies
+    std::unordered_map<const ggml_tensor *, int>              last_writer;
+    std::unordered_map<const ggml_tensor *, std::vector<int>> readers;
+    std::vector<std::vector<int>> preds(n);
+    std::vector<int>              n_consumers(n, 0);
+    for (int k = 0; k < n; ++k) {
+        const ggml_tensor * node = cgraph->nodes[cn[k]];
+        std::vector<int> & p = preds[k];
+        const auto add = [&](int j) {
+            if (j != k && std::find(p.begin(), p.end(), j) == p.end()) {
+                p.push_back(j);
+            }
+        };
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (node->src[s] == nullptr) {
+                continue;
+            }
+            const auto it = last_writer.find(root(node->src[s]));
+            if (it != last_writer.end()) {
+                add(it->second);
+            }
+        }
+        const ggml_tensor * out = root(node);
+        if (node->view_src != nullptr) {
+            // writes into memory that exists before this node: after its earlier writer and readers
+            const auto it = last_writer.find(out);
+            if (it != last_writer.end()) {
+                add(it->second);
+            }
+            const auto rt = readers.find(out);
+            if (rt != readers.end()) {
+                for (int j : rt->second) {
+                    add(j);
+                }
+            }
+        }
+        for (int j : p) {
+            n_consumers[j]++;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (node->src[s] != nullptr) {
+                readers[root(node->src[s])].push_back(k);
+            }
+        }
+        last_writer[out] = k;
+        readers[out].clear();
+    }
+
+    // 2. streams, 3. waits and windows
+    std::vector<int>  stream(n, 0);
+    std::vector<int>  remaining(n_consumers);  // consumers not assigned yet
+    std::vector<int>  pending(n_side + 1, 0);  // per side stream: its nodes with remaining consumers
+    std::vector<int>  tail(n_side + 1, -1);    // last node of each stream
+    std::vector<std::pair<int, int>> windows;  // [first, last] compute index
+    int window_first = -1;
+    int window_mask  = 0;
+    int n_waits = 0;
+
+    for (int k = 0; k < n; ++k) {
+        const ggml_tensor * node = cgraph->nodes[cn[k]];
+        const std::vector<int> & p = preds[k];
+
+        int chosen = -1;
+        // continue the chain of a predecessor that is still the tail of its stream, the main stream first
+        for (int pass = 0; pass < 2 && chosen < 0; ++pass) {
+            for (int j : p) {
+                if (tail[stream[j]] == j && (pass == 1 || stream[j] == 0)) {
+                    chosen = stream[j];
+                    break;
+                }
+            }
+        }
+        // a sibling projection: a free side stream
+        if (chosen < 0 && !p.empty() && (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID)) {
+            for (int s = 1; s <= n_side; ++s) {
+                if (pending[s] == 0) {
+                    chosen = s;
+                    break;
+                }
+            }
+        }
+        // otherwise behind one of the predecessors: the main stream if one is there, else the latest one
+        if (chosen < 0) {
+            chosen = 0;
+            if (!p.empty()) {
+                int latest = p[0];
+                bool on_main = false;
+                for (int j : p) {
+                    on_main |= stream[j] == 0;
+                    latest = std::max(latest, j);
+                }
+                chosen = on_main ? 0 : stream[latest];
+            }
+        }
+
+        stream[k]    = chosen;
+        tail[chosen] = k;
+        if (chosen != 0) {
+            if (window_first < 0) {
+                window_first = k;
+                window_mask  = 0;
+            }
+            window_mask |= 1 << chosen;
+            if (remaining[k] > 0) {
+                pending[chosen]++;
+            }
+        }
+        for (int j : p) {
+            if (--remaining[j] == 0 && stream[j] != 0) {
+                pending[stream[j]]--;
+            }
+        }
+
+        ggml_cuda_stream_plan_node & pn = plan.nodes[node];
+        pn.stream = chosen;
+        pn.event  = plan.next_event();
+        if (window_first == k) {
+            pn.window_start = true;
+        }
+        for (int j : p) {
+            // predecessors on the main stream before the window are ordered by the fork event
+            if (stream[j] != chosen && !(stream[j] == 0 && window_first >= 0 && j < window_first)) {
+                pn.waits.push_back(cgraph->nodes[cn[j]]);
+                n_waits++;
+            }
+        }
+
+        bool all_consumed = window_first >= 0 && chosen == 0;
+        for (int s = 1; s <= n_side && all_consumed; ++s) {
+            all_consumed = pending[s] == 0;
+        }
+        if (all_consumed || (window_first >= 0 && k == n - 1)) {
+            pn.window_end = true;
+            windows.emplace_back(window_first, k);
+            plan.nodes[cgraph->nodes[cn[window_first]]].window_streams = window_mask;
+            pn.window_streams = window_mask;
+            window_first = -1;
+        }
+    }
+
+    if (windows.empty()) {
+        plan.clear();
+        return;
+    }
+
+    // 4. the tensors of a window stay allocated until its end
+    for (const auto & [first, last] : windows) {
+        ggml_tensor * until = cgraph->nodes[cn[last]];
+        for (int k = first; k <= last; ++k) {
+            ggml_tensor * node = cgraph->nodes[cn[k]];
+            if (node != until) {
+                params->add_alloc_dep(params->user_data, node, until);
+            }
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (node->src[s] != nullptr) {
+                    params->add_alloc_dep(params->user_data, node->src[s], until);
+                }
+            }
+        }
+    }
+
+    plan.n_streams = n_side;
+    if (plan.fork_event == nullptr) {
+        CUDA_CHECK(cudaEventCreateWithFlags(&plan.fork_event, cudaEventDisableTiming));
+    }
+    while ((int) plan.join_events.size() < n_side) {
+        cudaEvent_t e;
+        CUDA_CHECK(cudaEventCreateWithFlags(&e, cudaEventDisableTiming));
+        plan.join_events.push_back(e);
+    }
+
+    if (ggml_cuda_stream_plan_debug()) {
+        std::vector<int> per_stream(n_side + 1, 0);
+        for (int k = 0; k < n; ++k) {
+            per_stream[stream[k]]++;
+        }
+        std::string counts;
+        for (int s = 0; s <= n_side; ++s) {
+            counts += " " + std::to_string(per_stream[s]);
+        }
+        GGML_LOG_INFO("%s: %d compute nodes, %zu windows, %d cross-stream waits, nodes per stream:%s\n",
+                __func__, n, windows.size(), n_waits, counts.c_str());
+    }
+}
