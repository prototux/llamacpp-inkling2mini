+static bool ggml_cuda_mk_debug() {
+    static const bool enabled = getenv("LLAMA_INKLING_MK_DEBUG") != nullptr;
+    return enabled;
+}
+
+// the run of fusable MUL_MAT nodes starting at i: returns the index past the last node of the run (views and other
+// no-ops in between are part of the run), fills the tensors; 0 if the node does not qualify
+static int ggml_cuda_mk_proj_match(ggml_cgraph * cgraph, int i, int & n, const ggml_tensor ** src0, const ggml_tensor ** src1, ggml_tensor ** dst) {
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    n = 0;
+    int end = i;
+    for (int j = i; j < cgraph->n_nodes && n < MMVQ_MULTI_MAX; ++j) {
+        ggml_tensor * t = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(t)) {
+            continue;
+        }
+        if (t->op != GGML_OP_MUL_MAT || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) ||
+                t->ne[1] != 1 || t->ne[2] != 1 || t->ne[3] != 1) {
+            break;
+        }
+        const ggml_tensor * w = t->src[0];
+        const ggml_tensor * x = t->src[1];
+        if (!ggml_is_quantized(w->type) || !ggml_cuda_mul_mat_vec_q_multi_supported(w->type) || !ggml_cuda_should_use_mmvq(w->type, cc, 1) ||
+                w->ne[2] != 1 || w->ne[3] != 1 || w->nb[0] != ggml_type_size(w->type) || w->nb[1] != ggml_row_size(w->type, w->ne[0]) ||
+                w->buffer == nullptr || ggml_backend_buffer_get_usage(w->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE ||
+                x->type != GGML_TYPE_F32 || x->nb[0] != sizeof(float) || x->ne[1] != 1 || x->ne[2] != 1 || x->ne[3] != 1) {
+            break;
+        }
+        // independent products: an input computed by an earlier product of the run ends it
+        bool dependent = false;
+        for (int k = 0; k < n && !dependent; ++k) {
+            dependent = x == dst[k] || (x->view_src != nullptr && x->view_src == dst[k]);
+        }
+        if (dependent) {
+            break;
+        }
+        src0[n] = w;
+        src1[n] = x;
+        dst[n]  = t;
+        n++;
+        end = j + 1;
+    }
+    return n >= 2 ? end : 0;
+}
