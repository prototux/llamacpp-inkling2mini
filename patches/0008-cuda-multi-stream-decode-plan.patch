+                    break;
+                }
+            }
+        }
+        // otherwise behind one of the predecessors: the main stream if one is there, else the latest one
+        if (chosen < 0) {
+            chosen = 0;
+            if (!p.empty()) {
+                int latest = p[0];
+                bool on_main = false;
+                for (int j : p) {
+                    on_main |= stream[j] == 0;
+                    latest = std::max(latest, j);
+                }
+                chosen = on_main ? 0 : stream[latest];
+            }
+        }
+
+        stream[k]    = chosen;
+        tail[chosen] = k;
+        if (chosen != 0) {
+            if (window_first < 0) {
+                window_first = k;
+                window_mask  = 0;
+            }
+            window_mask |= 1 << chosen;
+            if (remaining[k] > 0) {
+                pending[chosen]++;
+            }
+        }
+        for (int j : p) {
+            if (--remaining[j] == 0 && stream[j] != 0) {
+                pending[stream[j]]--;
+            }
+        }
+
+        ggml_cuda_stream_plan_node & pn = plan.nodes[node];
+        pn.stream = chosen;
+        pn.event  = plan.next_event();
+        if (window_first == k) {
+            pn.window_start = true;
+        }
+        for (int j : p) {
+            // predecessors on the main stream before the window are ordered by the fork event
+            if (stream[j] != chosen && !(stream[j] == 0 && window_first >= 0 && j < window_first)) {
+                pn.waits.push_back(cgraph->nodes[cn[j]]);
+                n_waits++;
+            }
+        }
+
+        bool all_consumed = window_first >= 0 && chosen == 0;
+        for (int s = 1; s <= n_side && all_consumed; ++s) {
+            all_consumed = pending[s] == 0;
+        }
+        if (all_consumed || (window_first >= 0 && k == n - 1)) {
+            pn.window_end = true;
+            windows.emplace_back(window_first, k);
+            plan.nodes[cgraph->nodes[cn[window_first]]].window_streams = window_mask;
+            pn.window_streams = window_mask;
+            window_first = -1;
+        }
+    }
+
+    if (windows.empty()) {
+        plan.clear();
+        return;
+    }
+
+    // 4. the tensors of a window stay allocated until its end
+    for (const auto & [first, last] : windows) {
+        ggml_tensor * until = cgraph->nodes[cn[last]];
+        for (int k = first; k <= last; ++k) {
+            ggml_tensor * node = cgraph->nodes[cn[k]];
+            if (node != until) {
+                params->add_alloc_dep(params->user_data, node, until);
+            }
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (node->src[s] != nullptr) {
+                    params->add_alloc_dep(params->user_data, node->src[s], until);
+                }
+            }
+        }
+    }
+
+    plan.n_streams = n_side;
+    if (plan.fork_event == nullptr) {
+        CUDA_CHECK(cudaEventCreateWithFlags(&plan.fork_event, cudaEventDisableTiming));
+    }
+    while ((int) plan.join_events.size() < n_side) {
+        cudaEvent_t e;
+        CUDA_CHECK(cudaEventCreateWithFlags(&e, cudaEventDisableTiming));
+        plan.join_events.push_back(e);
+    }
+
+    if (ggml_cuda_stream_plan_debug()) {
+        std::vector<int> per_stream(n_side + 1, 0);
+        for (int k = 0; k < n; ++k) {
+            per_stream[stream[k]]++;
+        }
+        std::string counts;
+        for (int s = 0; s <= n_side; ++s) {
+            counts += " " + std::to_string(per_stream[s]);
+        }
+        GGML_LOG_INFO("%s: %d compute nodes, %zu windows, %d cross-stream waits, nodes per stream:%s\n",
+                __func__, n, windows.size(), n_waits, counts.c_str());
+    }
+}
