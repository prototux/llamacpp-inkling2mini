--- a/tests/test-flash-attn-indexed-bias.cpp
+++ b/tests/test-flash-attn-indexed-bias.cpp
@@ -165,6 +165,160 @@ static void test_indexed_bias(ggml_backend_t backend, int width, bool use_rows,
     ggml_free(ctx);
 }
 
+// The real Inkling 2 Mini shapes with random K/V: 24 heads x 128, 8 KV heads, one stream, a 1025-bin table, the
+// cells at positions 0..cells-1, the queries at the last n_query positions. The expected values come from ggml's own
+// dequantization of the quantized K/V (ggml_get_type_traits()->to_float), so that a wrong in-place loader (the bytes a
+// kernel reads from a q8_0 or q4_0 cache) shows up; the test above has exactly representable K/V and cannot catch it.
+// window >= 0: maskless (LLAMA_INKLING_NO_MASK), the mask visibility is otherwise causal from the same positions.
+static void test_inkling_dims(ggml_backend_t backend, ggml_type kv_type, int n_query, int cells, int window) {
+    constexpr int width = 128, heads = 24, kv_heads = 8, bins = 1025;
+    const bool maskless = window >= 0;
+    const int swa = window > 0 ? window : 0;
+
+    ggml_context * ctx = ggml_init({32*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true});
+    auto * q     = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, width, n_query, heads, 1);
+    auto * k     = ggml_new_tensor_4d(ctx, kv_type, width, cells, kv_heads, 1);
+    auto * v     = ggml_dup_tensor(ctx, k);
+    auto * mask  = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, cells, n_query, 1, 1);
+    auto * table = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, bins, heads, n_query);
+    auto * k_pos = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, cells, 1);
+    auto * q_pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_query);
+    auto * sinks = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, heads);
+    auto * out = ggml_flash_attn_ext(ctx, q, k, v, maskless ? nullptr : mask, 1.0f/sqrtf(width), 0, 0);
+    ggml_flash_attn_ext_add_sinks(out, sinks);
+    if (maskless) {
+        ggml_flash_attn_ext_set_causal_window(out, window);
+    }
+    ggml_flash_attn_ext_add_position_bias(out, table, k_pos, q_pos);
+    ggml_prec_set_acc(out, GGML_PREC_F32);
+    if (!ggml_backend_supports_op(backend, out)) {
+        printf("%s: kv=%s, queries=%d, cells=%d, window=%d: op not supported, skipped\n", ggml_backend_name(backend), ggml_type_name(kv_type), n_query, cells, window);
+        ggml_free(ctx);
+        return;
+    }
+    auto * graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, out);
+    auto * buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    GGML_ASSERT(buf);
+
+    uint32_t state = 0x1234567u + 7919u*n_query + 31u*cells + (uint32_t) kv_type;
+    const auto frand = [&state]() { state = state*1664525u + 1013904223u; return float(state >> 8)/float(1u << 24) - 0.5f; };
+
+    // K/V: random, quantized with ggml, then dequantized with ggml for the expectation
+    const int64_t n_kv_values = (int64_t) width*cells*kv_heads;
+    std::vector<float> kf(n_kv_values), vf(n_kv_values);
+    for (int64_t i = 0; i < n_kv_values; ++i) {
+        kf[i] = 4.0f*frand();
+        vf[i] = 2.0f*frand();
+    }
+    std::vector<uint8_t> kq(ggml_nbytes(k)), vq(ggml_nbytes(v));
+    ggml_quantize_chunk(kv_type, kf.data(), kq.data(), 0, ggml_nrows(k), width, nullptr);
+    ggml_quantize_chunk(kv_type, vf.data(), vq.data(), 0, ggml_nrows(v), width, nullptr);
+    ggml_backend_tensor_set(k, kq.data(), 0, kq.size());
+    ggml_backend_tensor_set(v, vq.data(), 0, vq.size());
+    std::vector<float> kd(n_kv_values), vd(n_kv_values);
+    if (kv_type == GGML_TYPE_F32) {
+        kd = kf; vd = vf;
+    } else {
+        ggml_get_type_traits(kv_type)->to_float(kq.data(), kd.data(), n_kv_values);
+        ggml_get_type_traits(kv_type)->to_float(vq.data(), vd.data(), n_kv_values);
+    }
+
+    std::vector<float> qf((size_t) width*n_query*heads);
+    for (float & x : qf) {
+        x = 2.0f*frand();
+    }
+    ggml_backend_tensor_set(q, qf.data(), 0, ggml_nbytes(q));
+    std::vector<float> tab((size_t) bins*heads*n_query);
+    for (float & x : tab) {
+        x = 2.0f*frand();
+    }
+    ggml_backend_tensor_set(table, tab.data(), 0, ggml_nbytes(table));
+    std::vector<float> sink(heads);
+    for (float & x : sink) {
+        x = 4.0f*frand();
+    }
+    ggml_backend_tensor_set(sinks, sink.data(), 0, ggml_nbytes(sinks));
+    std::vector<int32_t> kpos(cells), qpos(n_query);
+    for (int c = 0; c < cells; ++c) {
+        kpos[c] = c;
+    }
+    for (int j = 0; j < n_query; ++j) {
+        qpos[j] = cells - n_query + j;
+    }
+    ggml_backend_tensor_set(k_pos, kpos.data(), 0, ggml_nbytes(k_pos));
+    ggml_backend_tensor_set(q_pos, qpos.data(), 0, ggml_nbytes(q_pos));
+    std::vector<ggml_fp16_t> vis((size_t) cells*n_query);
+    for (int j = 0; j < n_query; ++j) {
+        for (int c = 0; c < cells; ++c) {
+            const int d = qpos[j] - kpos[c];
+            vis[(size_t) j*cells + c] = ggml_fp32_to_fp16(d >= 0 && (swa == 0 || d < swa) ? 0.0f : -INFINITY);
+        }
+    }
+    if (!maskless) {
+        ggml_backend_tensor_set(mask, vis.data(), 0, ggml_nbytes(mask));
+    }
+
+    GGML_ASSERT(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS);
+    std::vector<float> output(ggml_nelements(out));
+    ggml_backend_tensor_get(out, output.data(), 0, ggml_nbytes(out));
+
+    // reference: the F16-rounded mask + bias like the kernels, double accumulation
+    double err2 = 0.0, ref2 = 0.0, max_err = 0.0;
+    std::vector<double> acc(width);
+    for (int j = 0; j < n_query; ++j) {
+        for (int h = 0; h < heads; ++h) {
+            const int kvh = h/(heads/kv_heads);
+            double m = sink[h], sum = 0.0;
+            std::fill(acc.begin(), acc.end(), 0.0);
+            std::vector<double> logit(cells);
+            for (int c = 0; c < cells; ++c) {
+                const int d = qpos[j] - kpos[c];
+                if (!(d >= 0 && (swa == 0 || d < swa))) {
+                    logit[c] = -INFINITY;
+                    continue;
+                }
+                const int bin = d < bins - 1 ? d : bins - 1;
+                double s = 0.0;
+                for (int i = 0; i < width; ++i) {
+                    s += double(qf[((size_t) h*n_query + j)*width + i])*double(kd[((size_t) kvh*cells + c)*width + i]);
+                }
+                s = s/sqrt(double(width)) + double(ggml_fp16_to_fp32(ggml_fp32_to_fp16(tab[((size_t) j*heads + h)*bins + bin])));
+                logit[c] = s;
+                m = std::max(m, s);
+            }
+            sum = exp(sink[h] - m);
+            for (int c = 0; c < cells; ++c) {
+                if (logit[c] == -INFINITY) {
+                    continue;
+                }
+                const double w = exp(logit[c] - m);
+                sum += w;
+                for (int i = 0; i < width; ++i) {
+                    acc[i] += w*double(vd[((size_t) kvh*cells + c)*width + i]);
+                }
+            }
+            for (int i = 0; i < width; ++i) {
+                const double ref = acc[i]/sum;
+                const double got = output[((size_t) j*heads + h)*width + i];
+                GGML_ASSERT(std::isfinite(got));
+                err2 += (got - ref)*(got - ref);
+                ref2 += ref*ref;
+                max_err = std::max(max_err, fabs(got - ref));
+            }
+        }
+    }
+    // the CPU reaches ~1e-5 on a quantized cache (its own q8_0 Q), the tensor-core kernels a little more; a wrong
+    // loader gives ~1
+    const double nmse = err2/std::max(ref2, 1e-30);
+    const bool ok = nmse < 5e-4;
+    printf("%s: inkling dims, kv=%s, queries=%d, cells=%d, window=%d: nmse=%.3g max abs error=%.3g %s\n",
+            ggml_backend_name(backend), ggml_type_name(kv_type), n_query, cells, window, nmse, max_err, ok ? "OK" : "FAIL");
+    GGML_ASSERT(ok);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+}
+
 int main() {
     ggml_backend_load_all();
     for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
@@ -195,6 +349,15 @@ int main() {
                 test_indexed_bias(backend, width, false, n_query, 1024, GGML_TYPE_Q4_0, true);
             }
         }
+        // the real shapes with random K/V, expected from ggml's dequantization: decode (vec), DSpark verify, prefill
+        // (tile/MMA with the in-place q8_0/q4_0 loaders), masked and maskless, full-attention and SWA windows
+        for (ggml_type kv_type : {GGML_TYPE_F16, GGML_TYPE_Q8_0, GGML_TYPE_Q4_0}) {
+            for (int n_query : {1, 4, 128, 512}) {
+                test_inkling_dims(backend, kv_type, n_query, 2048, -1);
+                test_inkling_dims(backend, kv_type, n_query, 2048, 0);
+                test_inkling_dims(backend, kv_type, n_query, 2048, 1024);
+            }
+        }
         ggml_backend_free(backend);
     }
