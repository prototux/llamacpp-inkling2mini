diff --git a/common/parsers/inkling.cpp b/common/parsers/inkling.cpp
index 9c30cdb87..a8f9fd3e0 100644
--- a/common/parsers/inkling.cpp
+++ b/common/parsers/inkling.cpp
@@ -98,6 +98,16 @@ common_chat_params common_chat_params_init_inkling(const common_chat_template &
     auto has_tools           = inputs.tools.is_array() && !inputs.tools.empty();
     auto has_response_format = !inputs.json_schema.is_null() && inputs.json_schema.is_object();
     auto use_tools           = has_tools && inputs.tool_choice != COMMON_CHAT_TOOL_CHOICE_NONE;
+
+    // the template has no switch that stops thinking (effort 0 still thinks at length), so with thinking disabled
+    // the answer starts in the text channel: Inkling 1 has the header in the generation prompt, Inkling 2 has an
+    // empty one. not with tools: the first block may be a tool call, which has no content token after the header
+    if (!inputs.enable_thinking && !inputs.has_continuation() && inputs.add_generation_prompt && !use_tools) {
+        const std::string pin = string_ends_with(data.generation_prompt, HEADER) ? TEXT :
+                                data.generation_prompt.empty()                   ? HEADER + TEXT : "";
+        data.generation_prompt += pin;
+        data.prompt.append(pin);
+    }
     auto extract_reasoning   = inputs.reasoning_format != COMMON_REASONING_FORMAT_NONE;
 
     data.parser = build_chat_peg_parser([&](common_chat_peg_builder & p) {
