@@ -5665,6 +5665,21 @@ static void test_template_output_peg_parsers(bool detailed_debug) {
             .expect(message_assist)
             .run();
 
+        // Thinking disabled: the prompt opens the text block, the model writes only the answer
+        tst.test("Hello, world!\nWhat's up?" + E)
+            .enable_thinking(false)
+            .expect(message_assist)
+            .run();
+
+        // Thinking disabled with tools: nothing is pinned, the first block may be a tool call
+        tst.test(P + CALL)
+            .enable_thinking(false)
+            .tools({ special_function_tool })
+            .expect_tool_calls({
+                { "special_function", R"({"arg1":1})", "" },
+            })
+            .run();
+
         // Thinking block, then content block
         tst.test(P + "<|content_thinking|>I'm thinking" + E + H + "<|content_text|>Hello, world!\nWhat's up?" + E)
             .reasoning_format(COMMON_REASONING_FORMAT_AUTO)
